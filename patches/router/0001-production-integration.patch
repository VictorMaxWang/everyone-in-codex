+import assert from "node:assert/strict";
+import { existsSync, mkdtempSync, readFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+
+test("new ChatGPT Web models default visible once without overriding a later user choice", async () => {
+  const directory = mkdtempSync(path.join(os.tmpdir(), "chatgpt-web-picker-"));
+  const statePath = path.join(directory, "model-picker.json");
+  process.env.MODEL_ROUTER_MODEL_PICKER_STATE = statePath;
+  const state = await import(`../src/model-picker-state.mjs?picker=${Date.now()}`);
+
+  state.seedModelsVisible(["chatgpt-web/high", "chatgpt-web/pro"]);
+  assert.deepEqual(state.modelPickerSnapshot().visible, ["chatgpt-web/high", "chatgpt-web/pro"]);
+
+  state.setModelVisible("chatgpt-web/pro", false);
+  state.seedModelsVisible(["chatgpt-web/high", "chatgpt-web/pro", "chatgpt-web/luna"]);
+  const snapshot = state.modelPickerSnapshot();
+  assert.deepEqual(snapshot.hidden, ["chatgpt-web/pro"]);
+  assert.deepEqual(snapshot.visible, ["chatgpt-web/high", "chatgpt-web/luna"]);
+  assert.equal(existsSync(statePath), true);
+  assert.match(readFileSync(statePath, "utf8"), /chatgpt-web\/luna/);
+
+  // 让本测试自身的进程环境回到导入前状态，避免影响同进程里的其他测试。
+  delete process.env.MODEL_ROUTER_MODEL_PICKER_STATE;
+});
