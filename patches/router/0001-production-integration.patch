+import assert from "node:assert/strict";
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import http from "node:http";
+import os from "node:os";
+import path from "node:path";
+import net from "node:net";
+import test from "node:test";
+
+import {
+  applyCustomConnections,
+  createCustomConnection,
+  customConnectionRegistryDocument,
+  customConnectionsSnapshot,
+  probeCustomConnection,
+  removeCustomConnection,
+  setCustomConnectionSecret,
+  updateCustomConnection,
+} from "../src/custom-connections.mjs";
+
+function isolatedOptions(stateDir) {
+  return {
+    stateDir,
+    statePath: path.join(stateDir, "custom-connections.json"),
+    selectionPath: path.join(stateDir, "enabled-providers.json"),
+  };
+}
+
+function remoteDraft(overrides = {}) {
+  return {
+    id: "team-api",
+    displayName: "Team API",
+    baseUrl: "https://models.example.test/v1",
+    protocol: "openai-responses",
+    models: ["model-a", "owner/model-b"],
+    ...overrides,
+  };
+}
+
+test("custom connection drafts enforce the outbound URL and authentication boundary", async () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-validation-"));
+  const options = isolatedOptions(stateDir);
+
+  await assert.rejects(
+    createCustomConnection(remoteDraft({ apiKey: "must-not-enter-json" }), options),
+    /accepted only by connections secret-set/,
+  );
+
+  await assert.rejects(
+    createCustomConnection(remoteDraft({ baseUrl: "http://models.example.test/v1" }), options),
+    /HTTPS/,
+  );
+  for (const baseUrl of [
+    "https://user@example.test/v1",
+    "https://example.test/v1?tenant=a",
+    "https://example.test/v1#models",
+  ]) {
+    await assert.rejects(createCustomConnection(remoteDraft({ baseUrl }), options), /must not contain/);
+  }
+
+  await createCustomConnection(
+    remoteDraft({
+      id: "local-api",
+      baseUrl: "http://127.0.0.1:11434/v1",
+      keyless: true,
+    }),
+    options,
+  );
+  const snapshot = customConnectionsSnapshot(options);
+  assert.equal(snapshot.candidate[0].id, "local-api");
+  assert.equal(snapshot.candidate[0].credentialConfigured, true);
+});
+
+test("candidate metadata and secrets apply atomically without placing the key in JSON", async () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-apply-"));
+  const options = isolatedOptions(stateDir);
+  const secret = "test-secret-value";
+
+  await createCustomConnection(remoteDraft(), options);
+  assert.equal(customConnectionsSnapshot(options).candidate[0].credentialConfigured, false);
+  await setCustomConnectionSecret("team-api", secret, options);
+  assert.equal(customConnectionsSnapshot(options).candidate[0].credentialConfigured, true);
+  assert.doesNotMatch(readFileSync(options.statePath, "utf8"), /test-secret-value/);
+
+  const applied = await applyCustomConnections({
+    ...options,
+    applyPublication: async () => ({}),
+  });
+  assert.equal(applied.restartRequired, true);
+  assert.deepEqual(applied.active, ["team-api"]);
+  assert.doesNotMatch(readFileSync(options.statePath, "utf8"), /test-secret-value/);
+  assert.equal(
+    readFileSync(path.join(stateDir, "custom-connection-team-api.secret"), "utf8").trim(),
+    secret,
+  );
+
+  await updateCustomConnection(
+    "team-api",
+    remoteDraft({ baseUrl: "https://new.example.test/v1" }),
+    options,
+  );
+  await assert.rejects(
+    applyCustomConnections({ ...options, applyPublication: async () => ({}) }),
+    /new API key is required/,
+  );
+  await setCustomConnectionSecret("team-api", "replacement-secret", options);
+  await applyCustomConnections({ ...options, applyPublication: async () => ({}) });
+  assert.equal(
+    readFileSync(path.join(stateDir, "custom-connection-team-api.secret"), "utf8").trim(),
+    "replacement-secret",
+  );
+
+  await removeCustomConnection("team-api", options);
+  await applyCustomConnections({ ...options, applyPublication: async () => ({}) });
+  assert.deepEqual(customConnectionsSnapshot(options).active, []);
+});
+
+test("a failed publication restores active metadata and its previous secret", async () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-rollback-"));
+  const options = isolatedOptions(stateDir);
+  await createCustomConnection(remoteDraft(), options);
+  await setCustomConnectionSecret("team-api", "original-secret", options);
+  await applyCustomConnections({ ...options, applyPublication: async () => ({}) });
+  await updateCustomConnection(
+    "team-api",
+    remoteDraft({ baseUrl: "https://replacement.example.test/v1" }),
+    options,
+  );
+  await setCustomConnectionSecret("team-api", "replacement-secret", options);
+
+  let publicationCalls = 0;
+  await assert.rejects(
+    applyCustomConnections({
+      ...options,
+      applyPublication: async () => {
+        publicationCalls += 1;
+        if (publicationCalls === 1) throw new Error("publication failed");
+        return {};
+      },
+    }),
+    /publication failed/,
+  );
+  const snapshot = customConnectionsSnapshot(options);
+  assert.equal(snapshot.active[0].baseUrl, "https://models.example.test/v1");
+  assert.equal(snapshot.candidate[0].baseUrl, "https://replacement.example.test/v1");
+  assert.equal(
+    readFileSync(path.join(stateDir, "custom-connection-team-api.secret"), "utf8").trim(),
+    "original-secret",
+  );
+});
+
+test("active connections become provider and model registry entries with conservative defaults", async () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-registry-"));
+  const options = isolatedOptions(stateDir);
+  await createCustomConnection(remoteDraft({ protocol: "anthropic-messages" }), options);
+  await setCustomConnectionSecret("team-api", "secret", options);
+  await applyCustomConnections({ ...options, applyPublication: async () => ({}) });
+
+  const registry = customConnectionRegistryDocument(options);
+  assert.equal(registry.providers.length, 1);
+  assert.equal(registry.providers[0].protocol, "anthropic");
+  assert.equal(registry.providers[0].credential.file, "custom-connection-team-api.secret");
+  assert.equal(registry.models.length, 2);
+  assert.deepEqual(
+    registry.models.map((model) => ({
+      upstreamModel: model.upstreamModel,
+      contextWindow: model.contextWindow,
+      autoCompact: model.autoCompact,
+      inputModalities: model.inputModalities,
+      metadataEstimated: model.metadataEstimated,
+    })),
+    [
+      {
+        upstreamModel: "model-a",
+        contextWindow: 131072,
+        autoCompact: 110000,
+        inputModalities: ["text"],
+        metadataEstimated: true,
+      },
+      {
+        upstreamModel: "owner/model-b",
+        contextWindow: 131072,
+        autoCompact: 110000,
+        inputModalities: ["text"],
+        metadataEstimated: true,
+      },
+    ],
+  );
+});
+
+test("all three public connection protocols map to the existing forwarder contracts", () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-protocols-"));
+  const options = isolatedOptions(stateDir);
+  writeFileSync(
+    options.statePath,
+    `${JSON.stringify({
+      version: 1,
