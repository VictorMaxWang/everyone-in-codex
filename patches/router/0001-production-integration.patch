+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  CHATGPT_WEB_BASE_URL,
+  CHATGPT_WEB_MODEL_SLUGS,
+  filterCodexNativeHeaders,
+  forwardCodexNativeResponse,
+  isChatGptWebModelNamespace,
+  isChatGptWebModelSlug,
+  resolveChatGptWebCatalogRoute,
+} from "../src/codex-native-responses.mjs";
+
+const EXPECTED_SLUGS = [
+  "chatgpt-web/light",
+  "chatgpt-web/medium",
+  "chatgpt-web/high",
+  "chatgpt-web/extra-high",
+  "chatgpt-web/pro",
+  "chatgpt-web/luna",
+];
+
+test("the native Responses transport is pinned to one loopback endpoint and six model slugs", () => {
+  assert.equal(CHATGPT_WEB_BASE_URL, "http://127.0.0.1:17841/v1");
+  assert.deepEqual([...CHATGPT_WEB_MODEL_SLUGS], EXPECTED_SLUGS);
+  for (const slug of EXPECTED_SLUGS) assert.equal(isChatGptWebModelSlug(slug), true, slug);
+  for (const slug of [
+    "chatgpt-web/",
+    "chatgpt-web/unknown",
+    "chatgpt-web/pro/extra",
+    "gpt-5.6-sol",
+  ]) {
+    assert.equal(isChatGptWebModelSlug(slug), false, slug);
+  }
+});
+
+test("the whole ChatGPT Web namespace is closed even for unknown slugs", () => {
+  for (const slug of [
+    "chatgpt-web/unknown",
+    "chatgpt-web/pro/extra",
+    "chatgpt-web/",
+  ]) {
+    assert.equal(isChatGptWebModelNamespace(slug), true, slug);
+  }
+  for (const slug of ["chatgpt-web", "other/chatgpt-web/high", "gpt-5.6-sol", ""]) {
+    assert.equal(isChatGptWebModelNamespace(slug), false, slug);
+  }
+});
+
+test("a native route is granted only when the exact model is both published and enabled", () => {
+  const catalog = [
+    { slug: "gpt-5.6-sol" },
+    { slug: "chatgpt-web/high", display_name: "ChatGPT/High" },
+  ];
+  assert.deepEqual(
+    resolveChatGptWebCatalogRoute("chatgpt-web/high", catalog, ["chatgpt-web"]),
+    {
+      slug: "chatgpt-web/high",
+      provider: "chatgpt-web",
+      transport: "codex-native-responses",
+    },
+  );
+  assert.equal(resolveChatGptWebCatalogRoute("chatgpt-web/high", catalog, []), undefined);
+  assert.equal(
+    resolveChatGptWebCatalogRoute("chatgpt-web/pro", catalog, ["chatgpt-web"]),
+    undefined,
+  );
+  assert.equal(
+    resolveChatGptWebCatalogRoute("chatgpt-web/unknown", catalog, ["chatgpt-web"]),
+    undefined,
+  );
+});
+
+test("only the native Codex envelope headers cross the loopback boundary", () => {
+  const filtered = filterCodexNativeHeaders({
+    Authorization: "Bearer local-session",
+    Accept: "text/event-stream",
+    "Content-Type": "application/json",
+    "Content-Encoding": "zstd",
+    "ChatGPT-Account-ID": "account-1",
+    "OpenAI-Beta": "responses=v1",
+    Originator: "codex_app",
+    "Session-ID": "session-1",
+    "Thread-ID": "thread-1",
+    "X-Client-Request-ID": "request-1",
+    "X-Codex-Beta-Features": "multi_agent_v2",
+    "X-Codex-Installation-ID": "install-1",
+    "X-Codex-Parent-Thread-ID": "parent-1",
+    "X-Codex-Turn-Metadata": "turn-envelope",
+    "X-Codex-Turn-State": "current",
+    "X-Codex-Window-ID": "window-1",
+    "X-OAI-Attestation": "attestation-1",
+    "X-OpenAI-Subagent": "native-v2",
+    "X-ResponsesAPI-Include-Timing-Metrics": "true",
+    Cookie: "must-not-pass",
+    Host: "malicious.example",
+    "X-Forwarded-For": "203.0.113.9",
+    "X-Router-Internal-Key": "must-not-pass",
+  });
+
+  assert.deepEqual(Object.fromEntries(filtered), {
+    accept: "text/event-stream",
+    authorization: "Bearer local-session",
+    "chatgpt-account-id": "account-1",
+    "content-encoding": "zstd",
+    "content-type": "application/json",
+    "openai-beta": "responses=v1",
+    originator: "codex_app",
+    "session-id": "session-1",
+    "thread-id": "thread-1",
+    "x-client-request-id": "request-1",
+    "x-codex-beta-features": "multi_agent_v2",
+    "x-codex-installation-id": "install-1",
+    "x-codex-parent-thread-id": "parent-1",
+    "x-codex-turn-metadata": "turn-envelope",
+    "x-codex-turn-state": "current",
+    "x-codex-window-id": "window-1",
+    "x-oai-attestation": "attestation-1",
+    "x-openai-subagent": "native-v2",
+    "x-responsesapi-include-timing-metrics": "true",
+  });
+});
+
+test("one fetch receives the original body, stream response, and abort signal unchanged", async () => {
+  const body = Buffer.from('{"model":"chatgpt-web/high","client_metadata":{"turn_id":"t-1"}}');
+  const controller = new AbortController();
+  const stream = new ReadableStream({
+    start(streamController) {
+      streamController.enqueue(new TextEncoder().encode("data: one\n\n"));
+      streamController.close();
+    },
+  });
+  const expected = new Response(stream, {
+    status: 200,
+    headers: { "content-type": "text/event-stream" },
+  });
+  const calls = [];
+
+  const actual = await forwardCodexNativeResponse({
+    model: "chatgpt-web/high",
+    route: "/responses/compact",
+    search: "?beta=true",
+    requestHeaders: {
+      authorization: "Bearer local-session",
+      "content-type": "application/json",
+      cookie: "drop-me",
+    },
+    body,
+    signal: controller.signal,
+    fetchImpl: async (...args) => {
+      calls.push(args);
+      return expected;
+    },
+  });
+
+  assert.equal(actual, expected);
+  assert.equal(actual.body, stream);
+  assert.equal(calls.length, 1);
+  const [target, options] = calls[0];
+  assert.equal(target, "http://127.0.0.1:17841/v1/responses/compact?beta=true");
+  assert.equal(options.method, "POST");
+  assert.equal(options.body, body);
+  assert.equal(options.signal, controller.signal);
+  assert.deepEqual(Object.fromEntries(options.headers), {
+    authorization: "Bearer local-session",
+    "content-type": "application/json",
+  });
+});
+
+test("invalid routes and model slugs fail closed before fetch", async () => {
+  let calls = 0;
+  const fetchImpl = async () => {
+    calls += 1;
+    return new Response();
+  };
+
+  await assert.rejects(
+    forwardCodexNativeResponse({
+      model: "chatgpt-web/unknown",
+      route: "/responses",
+      body: "{}",
+      fetchImpl,
+    }),
+    /not allowlisted/i,
+  );
+  await assert.rejects(
+    forwardCodexNativeResponse({
+      model: "chatgpt-web/high",
+      route: "/chat/completions",
+      body: "{}",
+      fetchImpl,
+    }),
+    /unsupported native Responses route/i,
+  );
+  assert.equal(calls, 0);
+});
+
+test("an upstream failure is returned after one attempt with no retry or failover", async () => {
+  const expected = new Error("loopback unavailable");
+  let calls = 0;
+
+  await assert.rejects(
+    forwardCodexNativeResponse({
+      model: "chatgpt-web/pro",
+      route: "/responses",
+      body: "{}",
+      fetchImpl: async () => {
+        calls += 1;
+        throw expected;
+      },
+    }),
+    (error) => error === expected,
+  );
+  assert.equal(calls, 1);
+});
