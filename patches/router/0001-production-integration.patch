index 0000000000000000000000000000000000000000..dacd6437e29df6cb9b5b04b3231baa99c56fa757
--- /dev/null
+++ b/src/tool-schema-recursion.mjs
@@ -0,0 +1,174 @@
+const DEFAULT_MAX_DEPTH = 32;
+const DEFAULT_MAX_BYTES = 512 * 1024;
+
+function isRecord(value) {
+  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function decodePointerToken(token) {
+  return token.replaceAll("~1", "/").replaceAll("~0", "~");
+}
+
+function resolveLocalRef(root, ref) {
+  if (ref === "#") return root;
+  if (typeof ref !== "string" || !ref.startsWith("#/")) return undefined;
+  let current = root;
+  for (const token of ref.slice(2).split("/").map(decodePointerToken)) {
+    if (!isRecord(current) && !Array.isArray(current)) return undefined;
+    if (!Object.hasOwn(current, token)) return undefined;
+    current = current[token];
+  }
+  return current;
+}
+
+function childValues(node) {
+  if (Array.isArray(node)) return node;
+  if (!isRecord(node)) return [];
+  return Object.entries(node)
+    .filter(([key]) => !["$ref", "$defs", "definitions"].includes(key))
+    .map(([, value]) => value);
+}
+
+function hasRecursiveLocalRef(schema) {
+  const visit = (node, activeRefs) => {
+    if (Array.isArray(node)) return node.some((item) => visit(item, activeRefs));
+    if (!isRecord(node)) return false;
+
+    const ref = typeof node.$ref === "string" ? node.$ref : undefined;
+    const target = resolveLocalRef(schema, ref);
+    if (target !== undefined) {
+      if (activeRefs.has(ref)) return true;
+      const nextRefs = new Set(activeRefs);
+      nextRefs.add(ref);
+      if (visit(target, nextRefs)) return true;
+    }
+    return childValues(node).some((value) => visit(value, activeRefs));
+  };
+  return visit(schema, new Set());
+}
+
+function schemaType(schema) {
+  const declared = Array.isArray(schema?.type) ? schema.type[0] : schema?.type;
+  if (typeof declared === "string") return declared;
+  if (isRecord(schema?.properties) || schema?.additionalProperties !== undefined) return "object";
+  if (schema?.items !== undefined) return "array";
+  return undefined;
+}
+
+function permissiveSchema(schema) {
+  const relaxed = {};
+  const type = schemaType(schema);
+  if (type) relaxed.type = type;
+  if (typeof schema?.description === "string") relaxed.description = schema.description;
+  if (type === "object") relaxed.additionalProperties = true;
+  if (type === "array") relaxed.items = {};
+  return relaxed;
+}
+
+function withoutDefinitionContainers(node) {
+  const clone = {};
+  for (const [key, value] of Object.entries(node)) {
+    if (!["$ref", "$defs", "definitions"].includes(key)) clone[key] = value;
+  }
+  return clone;
+}
+
+function expandLocalRefs(schema, maxDepth) {
+  const expand = (node, activeRefs, refDepth) => {
+    if (Array.isArray(node)) return node.map((item) => expand(item, activeRefs, refDepth));
+    if (!isRecord(node)) return node;
+
+    const ref = typeof node.$ref === "string" ? node.$ref : undefined;
+    const target = resolveLocalRef(schema, ref);
+    if (target !== undefined) {
+      // 上游无法表示递归结构。仅在再次走到同一引用或达到展开上限时
+      // 放宽该边缘，同时保留目标节点的容器类型，避免把整个工具删掉。
+      if (activeRefs.has(ref) || refDepth >= maxDepth) {
+        return {
+          ...permissiveSchema(target),
+          ...expand(withoutDefinitionContainers(node), activeRefs, refDepth),
+        };
+      }
+      const nextRefs = new Set(activeRefs);
+      nextRefs.add(ref);
+      return {
+        ...expand(target, nextRefs, refDepth + 1),
+        ...expand(withoutDefinitionContainers(node), activeRefs, refDepth),
+      };
+    }
+
+    const expanded = {};
+    for (const [key, value] of Object.entries(node)) {
+      // 一旦确认该 schema 真有可达递归，定义容器已经全部内联；继续
+      // 转发它们只会让严格上游再次解析到被切断的循环。
+      if (["$defs", "definitions"].includes(key)) continue;
+      expanded[key] = expand(value, activeRefs, refDepth);
+    }
+    return expanded;
+  };
+  return expand(schema, new Set(), 0);
+}
+
+function jsonBytes(value) {
+  return Buffer.byteLength(JSON.stringify(value), "utf8");
+}
+
+function sanitizeSchema(schema, options) {
+  if (!isRecord(schema) || !hasRecursiveLocalRef(schema)) return schema;
+
+  const maxDepth = Number.isInteger(options.maxDepth) && options.maxDepth >= 0
+    ? options.maxDepth
+    : DEFAULT_MAX_DEPTH;
+  const maxBytes = Number.isInteger(options.maxBytes) && options.maxBytes > 0
+    ? options.maxBytes
+    : DEFAULT_MAX_BYTES;
+  const expanded = expandLocalRefs(schema, maxDepth);
+  if (jsonBytes(expanded) <= maxBytes) return expanded;
+
+  // 大小上限只影响从本地引用展开出来的分支：重新以零层展开把这些
+  // 分支收敛成宽松容器，根工具和所有非引用字段仍然保留。
+  return expandLocalRefs(schema, 0);
+}
+
+function sanitizeTool(tool, options) {
+  if (!isRecord(tool)) return tool;
+  let changed = false;
+  let sanitized = tool;
+  const assign = (key, value) => {
+    if (value === tool[key]) return;
+    if (!changed) sanitized = { ...tool };
+    changed = true;
+    sanitized[key] = value;
+  };
+
+  for (const key of ["parameters", "inputSchema"]) {
+    if (isRecord(tool[key])) assign(key, sanitizeSchema(tool[key], options));
+  }
+  if (isRecord(tool.function) && isRecord(tool.function.parameters)) {
+    const parameters = sanitizeSchema(tool.function.parameters, options);
+    if (parameters !== tool.function.parameters) {
+      assign("function", { ...tool.function, parameters });
+    }
+  }
+  if (Array.isArray(tool.tools)) {
+    const tools = tool.tools.map((nested) => sanitizeTool(nested, options));
+    if (tools.some((nested, index) => nested !== tool.tools[index])) assign("tools", tools);
+  }
+  return sanitized;
+}
+
+/**
+ * 为不接受递归 JSON Schema 的上游整理工具定义。
+ *
+ * 只有可达的本地 `$ref` 形成自循环或互相循环时才复制并改写对应
+ * schema；普通工具直接返回原对象，避免无意改变其他 provider 的请求。
+ *
+ * @param {unknown} tools Provider 最终收到的工具列表。
+ * @param {{maxDepth?: number, maxBytes?: number}} [options] 展开安全上限。
+ * @returns {unknown} 兼容后的工具列表。
+ */
+export function sanitizeRecursiveToolSchemas(tools, options = {}) {
+  if (!Array.isArray(tools)) return tools;
+  const sanitized = tools.map((tool) => sanitizeTool(tool, options));
+  return sanitized.some((tool, index) => tool !== tools[index]) ? sanitized : tools;
+}
