@@ -0,0 +1,48 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+
+const routerSource = readFileSync(new URL("../src/router.mjs", import.meta.url), "utf8");
+const catalogSource = readFileSync(new URL("../src/catalog.mjs", import.meta.url), "utf8");
+
+test("the Full harness direct branch runs before every routed request transformation", () => {
+  const handler = routerSource.indexOf("async function handleResponses");
+  const direct = routerSource.indexOf('if (route?.transport === "codex-native-responses")', handler);
+  const compact = routerSource.indexOf("handleRoutedCompaction(", direct);
+  const normalize = routerSource.indexOf("normalizeRoutedAgentInput(", direct);
+  const build = routerSource.indexOf("buildRoutedRequest(", direct);
+  assert.ok(handler >= 0 && direct > handler);
+  assert.ok(direct < compact, "direct transport must precede Router compaction");
+  assert.ok(direct < normalize, "direct transport must precede agent normalization");
+  assert.ok(direct < build, "direct transport must precede LiteLLM/provider request building");
+
+  const branch = routerSource.slice(direct, routerSource.indexOf("if (route && (compactV1", direct));
+  assert.match(branch, /forwardCodexNativeResponse\(/);
+  assert.match(branch, /body: encoded/);
+  assert.match(branch, /signal: controller\.signal/);
+  assert.match(branch, /pipeResponse\(upstream, response, HOP_BY_HOP_HEADERS\)/);
+  assert.doesNotMatch(
+    branch,
+    /fetchWithRetry|applyVisionBridge|repairToolSchemaRoots|ageToolResults|failover|EmptyCompletionGuard/,
+  );
+});
+
+test("dynamic ChatGPT rows bypass routed templates and are excluded from native counts", () => {
+  assert.match(catalogSource, /mergeChatGptWebCatalogModels\(/);
+  assert.match(catalogSource, /seedModelsVisible\(chatGptWebModels/);
+  assert.match(catalogSource, /!isChatGptWebModelSlug\(String\(model\.slug\)\)/);
+  const mergeCall = catalogSource.indexOf("mergeChatGptWebCatalogModels(");
+  const visionCall = catalogSource.indexOf("applyVisionBridge(routedModels");
+  assert.ok(mergeCall > visionCall, "trusted WebGPT metadata must join after Vision Bridge");
+});
+
+test("an unavailable ChatGPT Web slug fails before the generic native redirect", () => {
+  const handler = routerSource.indexOf("async function handleResponses");
+  const failClosed = routerSource.indexOf(
+    "isChatGptWebModelNamespace(requestedModel) && !chatGptWebRoute",
+    handler,
+  );
+  const redirect = routerSource.indexOf("const redirect = MODEL_BY_SLUG.get(readNativeRedirect())", handler);
+  assert.ok(failClosed > handler, "the handler must recognize the closed ChatGPT Web namespace");
+  assert.ok(failClosed < redirect, "ChatGPT Web requests must fail before any cross-provider redirect");
+});
