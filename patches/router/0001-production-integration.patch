diff --git a/test/chatgpt-web-catalog-sync.test.mjs b/test/chatgpt-web-catalog-sync.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ff93191da5a2272e1b989b17600bb199a68007b0
--- /dev/null
+++ b/test/chatgpt-web-catalog-sync.test.mjs
@@ -0,0 +1,117 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  chatGptWebCatalogFingerprint,
+  startChatGptWebCatalogSync,
+  stopChatGptWebCatalogSync,
+  syncChatGptWebCatalogOnce,
+} from "../src/chatgpt-web-catalog-sync.mjs";
+
+const light = {
+  id: "chatgpt-web/light",
+  slug: "chatgpt-web/light",
+  context_window: 1_000_000,
+  display_name: "ChatGPT/Instant",
+};
+
+test("catalog fingerprints ignore picker visibility and source ordering", () => {
+  assert.equal(
+    chatGptWebCatalogFingerprint([
+      { ...light, visibility: "hide" },
+      { id: "chatgpt-web/high", slug: "chatgpt-web/high" },
+    ]),
+    chatGptWebCatalogFingerprint([
+      { id: "chatgpt-web/high", slug: "chatgpt-web/high" },
+      light,
+    ]),
+  );
+});
+
+test("disabled probes never fetch or publish", async () => {
+  let publishes = 0;
+  let fetches = 0;
+  assert.deepEqual(await syncChatGptWebCatalogOnce({
+    enabled: () => false,
+    fetchCatalog: async () => { fetches += 1; },
+    publish: () => { publishes += 1; },
+  }), { status: "disabled" });
+  assert.equal(fetches, 0);
+  assert.equal(publishes, 0);
+});
+
+test("offline last-good restores a missing or drifted published catalog", async () => {
+  let publishes = 0;
+  assert.deepEqual(await syncChatGptWebCatalogOnce({
+    enabled: () => true,
+    fetchCatalog: async () => ({ source: "cache", models: [light] }),
+    readPublished: () => [],
+    publish: () => { publishes += 1; return { scheduled: true, queued: false }; },
+  }), { status: "restoring-cache", scheduled: true, queued: false });
+  assert.equal(publishes, 1);
+
+  assert.deepEqual(await syncChatGptWebCatalogOnce({
+    enabled: () => true,
+    fetchCatalog: async () => ({ source: "cache", models: [light] }),
+    readPublished: () => [{ ...light, visibility: "hide" }],
+    publish: () => { publishes += 1; },
+  }), { status: "offline-cache" });
+  assert.equal(publishes, 1);
+});
+
+test("recovery publishes only when live account metadata changed", async () => {
+  let publishes = 0;
+  assert.deepEqual(await syncChatGptWebCatalogOnce({
+    enabled: () => true,
+    fetchCatalog: async () => ({ source: "live", models: [light] }),
+    readPublished: () => [{ ...light, visibility: "hide" }],
+    publish: () => { publishes += 1; return { scheduled: true, queued: false }; },
+  }), { status: "unchanged" });
+  assert.equal(publishes, 0);
+
+  const changed = await syncChatGptWebCatalogOnce({
+    enabled: () => true,
+    fetchCatalog: async () => ({ source: "live", models: [{ ...light, context_window: 1_050_000 }] }),
+    readPublished: () => [light],
+    publish: () => { publishes += 1; return { scheduled: true, queued: false }; },
+  });
+  assert.deepEqual(changed, { status: "refreshing", scheduled: true, queued: false });
+  assert.equal(publishes, 1);
+});
+
+test("runtime sync polls again after failure so service recovery needs no manual catalog command", async () => {
+  stopChatGptWebCatalogSync();
+  const scheduled = [];
+  let attempts = 0;
+  const setTimer = (callback, delay) => {
+    const handle = { callback, delay, unref() {} };
+    scheduled.push(handle);
+    return handle;
+  };
+  try {
+    startChatGptWebCatalogSync({
+      sync: async () => {
+        attempts += 1;
+        if (attempts === 1) throw new Error("temporarily offline");
+        return { status: "unchanged" };
+      },
+      firstPollMs: 1_000,
+      pollMs: 2_000,
+      setTimer,
+      clearTimer() {},
+    });
+    assert.equal(scheduled.length, 1);
+    assert.equal(scheduled[0].delay, 1_000);
+
+    await scheduled.shift().callback();
+    assert.equal(attempts, 1);
+    assert.equal(scheduled.length, 1, "an offline probe must arm a recovery probe");
+    assert.equal(scheduled[0].delay, 2_000);
+
+    await scheduled.shift().callback();
+    assert.equal(attempts, 2);
+    assert.equal(scheduled.length, 1, "a successful recovery must keep refreshing");
+  } finally {
+    stopChatGptWebCatalogSync();
+  }
+});
diff --git a/test/chatgpt-web-catalog.test.mjs b/test/chatgpt-web-catalog.test.mjs
