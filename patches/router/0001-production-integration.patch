diff --git a/test/tool-schema-recursion.test.mjs b/test/tool-schema-recursion.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..57660829f33dd4aca79f918852a5d7fca074de99
--- /dev/null
+++ b/test/tool-schema-recursion.test.mjs
@@ -0,0 +1,161 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { sanitizeRecursiveToolSchemas } from "../src/tool-schema-recursion.mjs";
+
+function selfRecursiveSchema() {
+  return {
+    type: "object",
+    properties: { root: { $ref: "#/$defs/node" } },
+    $defs: {
+      node: {
+        type: "object",
+        description: "A recursive tree node",
+        properties: {
+          label: { type: "string" },
+          child: { $ref: "#/$defs/node" },
+        },
+      },
+    },
+  };
+}
+
+test("self-recursive local refs are unfolded once and cut at the repeated edge", () => {
+  const schema = selfRecursiveSchema();
+  const tools = [{ type: "function", name: "tree", parameters: schema }];
+
+  const sanitized = sanitizeRecursiveToolSchemas(tools);
+
+  assert.deepEqual(sanitized, [
+    {
+      type: "function",
+      name: "tree",
+      parameters: {
+        type: "object",
+        properties: {
+          root: {
+            type: "object",
+            description: "A recursive tree node",
+            properties: {
+              label: { type: "string" },
+              child: {
+                type: "object",
+                description: "A recursive tree node",
+                additionalProperties: true,
+              },
+            },
+          },
+        },
+      },
+    },
+  ]);
+  assert.equal(schema.properties.root.$ref, "#/$defs/node", "the caller's schema is not mutated");
+});
+
+test("mutually recursive legacy definitions are cut without dropping either object shape", () => {
+  const tools = [
+    {
+      type: "function",
+      name: "mutual",
+      function: {
+        parameters: {
+          type: "object",
+          properties: { value: { $ref: "#/definitions/a" } },
+          definitions: {
+            a: {
+              type: "object",
+              properties: { b: { $ref: "#/definitions/b" } },
+            },
+            b: {
+              type: "object",
+              properties: { a: { $ref: "#/definitions/a" } },
+            },
+          },
+        },
+      },
+    },
+  ];
+
+  const sanitized = sanitizeRecursiveToolSchemas(tools);
+  const parameters = sanitized[0].function.parameters;
+
+  assert.deepEqual(parameters, {
+    type: "object",
+    properties: {
+      value: {
+        type: "object",
+        properties: {
+          b: {
+            type: "object",
+            properties: {
+              a: { type: "object", additionalProperties: true },
+            },
+          },
+        },
+      },
+    },
+  });
+  assert.doesNotMatch(JSON.stringify(parameters), /"\$ref"|"\$defs"|"definitions"/);
+});
+
+test("namespace inputSchema and parameter aliases receive the same recursive repair", () => {
+  const schema = selfRecursiveSchema();
+  const tools = [
+    {
+      type: "namespace",
+      name: "console",
+      tools: [
+        { type: "function", name: "input", inputSchema: schema },
+        { type: "function", name: "parameters", parameters: schema },
+      ],
+    },
+  ];
+
+  const sanitized = sanitizeRecursiveToolSchemas(tools);
+
+  assert.doesNotMatch(JSON.stringify(sanitized), /"\$ref"|"\$defs"/);
+  assert.equal(sanitized[0].tools[0].inputSchema.properties.root.type, "object");
+  assert.equal(sanitized[0].tools[1].parameters.properties.root.type, "object");
+});
+
+test("acyclic schemas keep the original tool array and local refs by identity", () => {
+  const tools = [
+    {
+      type: "function",
+      name: "plain",
+      parameters: {
+        type: "object",
+        properties: { value: { $ref: "#/$defs/value" } },
+        $defs: { value: { type: "string" } },
+      },
+    },
+  ];
+
+  assert.equal(sanitizeRecursiveToolSchemas(tools), tools);
+});
+
+test("recursive expansion obeys depth and byte budgets without deleting the tool", () => {
+  const schema = selfRecursiveSchema();
+  schema.$defs.node.properties.chain = {
+    type: "object",
+    properties: {
+      one: {
+        type: "object",
+        properties: {
+          two: {
+            type: "object",
+            properties: { three: { $ref: "#/$defs/node" } },
+          },
+        },
+      },
+    },
+  };
+  const tools = [{ type: "function", name: "bounded", parameters: schema }];
+
+  const sanitized = sanitizeRecursiveToolSchemas(tools, { maxDepth: 3, maxBytes: 700 });
+
+  assert.equal(sanitized.length, 1);
+  assert.equal(sanitized[0].name, "bounded");
+  assert.doesNotMatch(JSON.stringify(sanitized), /"\$ref"|"\$defs"/);
+  assert.ok(Buffer.byteLength(JSON.stringify(sanitized[0].parameters), "utf8") <= 700);
+});
