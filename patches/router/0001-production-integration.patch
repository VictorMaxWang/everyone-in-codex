+export const CHATGPT_WEB_BASE_URL = "http://127.0.0.1:17841/v1";
+
+export const CHATGPT_WEB_MODEL_SLUGS = Object.freeze([
+  "chatgpt-web/light",
+  "chatgpt-web/medium",
+  "chatgpt-web/high",
+  "chatgpt-web/extra-high",
+  "chatgpt-web/pro",
+  "chatgpt-web/luna",
+]);
