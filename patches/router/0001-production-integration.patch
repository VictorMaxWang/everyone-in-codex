+  "openai-responses": "openai-responses",
+  "openai-chat": "openai",
+  "anthropic-messages": "anthropic",
+});
+
+function defaults(options = {}) {
+  const stateDir = options.stateDir || STATE_DIR;
+  return {
+    stateDir,
+    statePath: options.statePath ||
+      (stateDir === STATE_DIR ? CUSTOM_CONNECTIONS_PATH : path.join(stateDir, "custom-connections.json")),
+    selectionPath: options.selectionPath || PROVIDER_SELECTION_PATH,
+  };
+}
+
+function providerId(id) {
+  return `custom-${id}`;
+}
+
+function activeSecretPath(id, stateDir) {
+  return path.join(stateDir, `custom-connection-${id}.secret`);
+}
+
+function candidateSecretPath(id, stateDir) {
+  return path.join(stateDir, `custom-connection-${id}.candidate.secret`);
+}
+
+function cleanId(value, label = "connection id") {
+  const id = String(value || "").trim().toLowerCase();
+  if (!/^[a-z0-9][a-z0-9-]{0,62}$/.test(id)) {
+    throw new Error(`${label} must use 1-63 lowercase letters, digits, or hyphens.`);
+  }
+  return id;
+}
+
+function gatewaySafe(value) {
+  const safe = String(value || "")
+    .toLowerCase()
+    .replace(/[^a-z0-9-]+/g, "-")
+    .replace(/-{2,}/g, "-")
+    .replace(/^-|-$/g, "");
+  if (!safe) throw new Error("Every custom model requires a non-empty model id.");
+  return safe;
+}
+
+function loopback(url) {
+  return ["127.0.0.1", "localhost", "[::1]"].includes(url.hostname);
+}
+
+function normalizeBaseUrl(value) {
+  let url;
+  try {
+    url = new URL(String(value || ""));
+  } catch {
+    throw new Error("Custom connection baseUrl must be an absolute HTTP(S) URL.");
+  }
+  if (!["http:", "https:"].includes(url.protocol)) {
+    throw new Error("Custom connection baseUrl must be an HTTP(S) URL.");
+  }
+  if (url.username || url.password || url.search || url.hash) {
+    throw new Error("Custom connection baseUrl must not contain userinfo, query, or fragment data.");
+  }
+  if (!loopback(url) && url.protocol !== "https:") {
+    throw new Error("Remote custom connections must use HTTPS.");
+  }
+  return url.toString().replace(/\/+$/, "");
+}
+
+function normalizeModels(models) {
+  if (!Array.isArray(models) || models.length === 0) {
+    throw new Error("A custom connection requires at least one model id.");
+  }
+  const seen = new Set();
+  return models.map((raw) => {
+    const source = typeof raw === "string" ? { id: raw } : raw;
+    const id = String(source?.id || "").trim();
+    if (!id || id.length > 256) throw new Error("Every custom model requires a valid model id.");
+    if (seen.has(id)) throw new Error(`Duplicate custom model id: ${id}`);
+    seen.add(id);
+    const contextWindow = source.contextWindow ?? DEFAULT_CONTEXT_WINDOW;
+    const autoCompact = source.autoCompact ?? DEFAULT_AUTO_COMPACT;
+    if (!Number.isInteger(contextWindow) || contextWindow < 1) {
+      throw new Error(`Custom model ${id} has an invalid contextWindow.`);
+    }
+    if (!Number.isInteger(autoCompact) || autoCompact < 1 || autoCompact > contextWindow) {
+      throw new Error(`Custom model ${id} has an invalid autoCompact limit.`);
+    }
+    const modalities = source.inputModalities ?? ["text"];
+    if (
+      !Array.isArray(modalities) ||
+      modalities.length === 0 ||
+      modalities.some((item) => !["text", "image"].includes(item))
+    ) {
+      throw new Error(`Custom model ${id} has invalid inputModalities.`);
+    }
+    return {
+      id,
+      displayName: String(source.displayName || id).trim() || id,
+      contextWindow,
+      autoCompact,
+      inputModalities: [...new Set(modalities)],
+      metadataEstimated: source.metadataEstimated !== false,
+    };
+  });
+}
+
+export function planCustomConnection(input) {
+  // 元数据管理面禁止接收任何凭据字段；Key 只能走隐藏输入并经 stdin 进入独立文件。
+  for (const field of ["apiKey", "key", "secret", "token"]) {
+    if (input?.[field] !== undefined) {
+      throw new Error("API keys are accepted only by connections secret-set over stdin.");
+    }
+  }
+  const id = cleanId(input?.id);
+  const baseUrl = normalizeBaseUrl(input?.baseUrl);
+  const url = new URL(baseUrl);
+  const keyless = input?.keyless === true;
+  if (keyless && !loopback(url)) {
+    throw new Error("Only a loopback custom connection may be keyless.");
+  }
+  if (!PROTOCOLS[input?.protocol]) {
+    throw new Error(
+      "Custom connection protocol must be openai-responses, openai-chat, or anthropic-messages.",
+    );
+  }
+  return {
+    id,
+    displayName: String(input?.displayName || id).trim() || id,
+    baseUrl,
+    protocol: input.protocol,
+    keyless,
+    models: normalizeModels(input.models),
+  };
+}
+
+function emptyState() {
+  return { version: 1, active: [], candidate: null };
+}
+
+function validateStoredConnection(connection) {
+  return planCustomConnection(connection);
+}
+
+function readState(options = {}) {
+  const { statePath } = defaults(options);
+  if (!existsSync(statePath)) return emptyState();
+  const parsed = JSON.parse(readFileSync(statePath, "utf8"));
+  if (parsed?.version !== 1 || !Array.isArray(parsed.active)) {
+    throw new Error("custom-connections.json has an unsupported schema.");
+  }
+  return {
+    version: 1,
+    active: parsed.active.map(validateStoredConnection),
+    candidate: parsed.candidate === null || parsed.candidate === undefined
+      ? null
+      : Array.isArray(parsed.candidate)
+        ? parsed.candidate.map(validateStoredConnection)
+        : (() => { throw new Error("custom-connections.json candidate must be an array or null."); })(),
+  };
+}
+
+function writeState(state, options = {}) {
+  writePrivateJson(defaults(options).statePath, state);
+  return state;
+}
+
+function editableConnections(state) {
+  return state.candidate ? structuredClone(state.candidate) : structuredClone(state.active);
+}
+
+async function mutateCandidate(options, operation) {
+  const resolved = defaults(options);
+  return withModelOverlayLock(() => {
+    const state = readState(resolved);
+    const candidate = editableConnections(state);
+    const result = operation(candidate, state);
+    writeState({ version: 1, active: state.active, candidate }, resolved);
+    return result;
+  }, { stateDir: resolved.stateDir });
+}
+
+export async function createCustomConnection(input, options = {}) {
+  const connection = planCustomConnection(input);
+  await mutateCandidate(options, (candidate) => {
+    if (candidate.some((entry) => entry.id === connection.id)) {
+      throw new Error(`Custom connection ${connection.id} already exists.`);
+    }
+    candidate.push(connection);
+  });
+  return connection;
+}
+
+export async function updateCustomConnection(id, input, options = {}) {
+  const expected = cleanId(id);
+  const connection = planCustomConnection({ ...input, id: expected });
+  await mutateCandidate(options, (candidate) => {
+    const index = candidate.findIndex((entry) => entry.id === expected);
+    if (index === -1) throw new Error(`Unknown custom connection: ${expected}`);
+    candidate[index] = connection;
+  });
+  return connection;
+}
+
+export async function removeCustomConnection(id, options = {}) {
+  const expected = cleanId(id);
+  await mutateCandidate(options, (candidate) => {
+    const index = candidate.findIndex((entry) => entry.id === expected);
+    if (index === -1) throw new Error(`Unknown custom connection: ${expected}`);
+    candidate.splice(index, 1);
+    const staged = candidateSecretPath(expected, defaults(options).stateDir);
+    if (existsSync(staged)) unlinkSync(staged);
+  });
+  return { id: expected, pendingRemoval: true };
+}
+
+function stagedSecret(id, connection, options = {}) {
+  const { stateDir } = defaults(options);
+  const target = candidateSecretPath(id, stateDir);
+  if (!existsSync(target)) return undefined;
+  try {
+    const parsed = JSON.parse(readFileSync(target, "utf8"));
+    if (parsed?.version !== 1 || parsed.baseUrl !== connection.baseUrl) return undefined;
+    const value = String(parsed.value || "").trim();
+    return value || undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function reusableActiveSecret(connection, active, options = {}) {
+  const previous = active.find((entry) => entry.id === connection.id);
+  if (!previous || previous.baseUrl !== connection.baseUrl) return undefined;
+  const target = activeSecretPath(connection.id, defaults(options).stateDir);
+  if (!existsSync(target)) return undefined;
+  const value = readFileSync(target, "utf8").trim();
+  return value || undefined;
+}
+
+export async function setCustomConnectionSecret(id, value, options = {}) {
+  const expected = cleanId(id);
+  const secret = String(value || "").trim();
+  if (!secret) throw new Error("No API key was provided; nothing changed.");
+  if (Buffer.byteLength(secret) > 16 * 1024) throw new Error("The API key is too large.");
+  const resolved = defaults(options);
+  return withModelOverlayLock(() => {
+    const state = readState(resolved);
+    const candidate = state.candidate || state.active;
+    const connection = candidate.find((entry) => entry.id === expected);
+    if (!connection) throw new Error(`Unknown custom connection: ${expected}`);
+    if (connection.keyless) throw new Error(`Custom connection ${expected} is keyless.`);
+    writePrivateJson(candidateSecretPath(expected, resolved.stateDir), {
+      version: 1,
+      baseUrl: connection.baseUrl,
+      value: secret,
+    });
+    return { id: expected, configured: true };
+  }, { stateDir: resolved.stateDir });
+}
+
+function credentialConfigured(connection, state, options) {
+  return connection.keyless || Boolean(
+    stagedSecret(connection.id, connection, options) ||
+    reusableActiveSecret(connection, state.active, options),
+  );
+}
+
+export function customConnectionsSnapshot(options = {}) {
+  const state = readState(options);
+  const project = (connection) => ({
+    ...connection,
+    credentialConfigured: credentialConfigured(connection, state, options),
+  });
+  return {
+    path: defaults(options).statePath,
+    active: state.active.map(project),
+    candidate: (state.candidate || []).map(project),
+    pending: state.candidate !== null,
+    restartRequired: state.candidate !== null,
+  };
+}
+
+export function customConnectionSecretValues(options = {}) {
+  const state = readState(options);
+  const values = new Set();
+  for (const connection of [...state.active, ...(state.candidate || [])]) {
+    const active = activeSecretPath(connection.id, defaults(options).stateDir);
+    if (existsSync(active)) {
+      const value = readFileSync(active, "utf8").trim();
+      if (value) values.add(value);
+    }
+    const candidate = candidateSecretPath(connection.id, defaults(options).stateDir);
+    if (existsSync(candidate)) {
+      try {
+        const value = String(JSON.parse(readFileSync(candidate, "utf8"))?.value || "").trim();
+        if (value) values.add(value);
+      } catch {
+        // A malformed staged secret cannot be used, but any active value above
+        // is still worth redacting from a support artifact.
+      }
+    }
+  }
+  return [...values];
+}
+
+function readSelection(selectionPath) {
+  if (!existsSync(selectionPath)) return undefined;
+  try {
+    const parsed = JSON.parse(readFileSync(selectionPath, "utf8"));
+    return parsed?.version === 1 && Array.isArray(parsed.providers)
+      ? parsed.providers.map(String)
+      : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function transactionFiles(state, options) {
+  const resolved = defaults(options);
+  const ids = new Set([
+    ...state.active.map((entry) => entry.id),
+    ...(state.candidate || []).map((entry) => entry.id),
+  ]);
+  return [
+    resolved.statePath,
+    resolved.selectionPath,
+    ...[...ids].flatMap((id) => [
+      activeSecretPath(id, resolved.stateDir),
+      candidateSecretPath(id, resolved.stateDir),
+    ]),
+  ];
+}
+
+export async function applyCustomConnections(options = {}) {
+  const resolved = defaults(options);
+  return withModelOverlayLock(async () => {
+    // The model registry imports this module to merge the active cohort.
+    // Load publication lazily so the fresh publication child does not form a
+    // registry -> connections -> publication -> registry module cycle.
+    const {
+      captureModelOverlayFiles,
+      restoreModelOverlayFiles,
+      transactModelOverlayMutation,
+    } = await import("./model-overlay-publication.mjs");
+    const before = readState(resolved);
+    if (before.candidate === null) {
+      return {
+        active: before.active.map((entry) => entry.id),
+        changed: false,
+        restartRequired: false,
+      };
+    }
+    const files = transactionFiles(before, resolved);
+    const result = await transactModelOverlayMutation({
+      lock: false,
+      capture: () => captureModelOverlayFiles(files),
+      restore: restoreModelOverlayFiles,
+      applyPublication: options.applyPublication,
+      mutate: async () => {
+        for (const connection of before.candidate) {
+          if (connection.keyless) continue;
+          const secret = stagedSecret(connection.id, connection, resolved) ||
+            reusableActiveSecret(connection, before.active, resolved);
+          if (!secret) {
+            throw new Error(
+              `Custom connection ${connection.id}: a new API key is required before it can be applied.`,
+            );
+          }
+          writePrivateFile(activeSecretPath(connection.id, resolved.stateDir), `${secret}\n`);
+        }
