+const CHATGPT_WEB_MODEL_SET = new Set(CHATGPT_WEB_MODEL_SLUGS);
+const NATIVE_RESPONSE_ROUTES = new Set(["/responses", "/responses/compact"]);
+const NATIVE_HEADER_ALLOWLIST = new Set([
+  "accept",
+  "authorization",
+  "chatgpt-account-id",
+  "content-encoding",
+  "content-type",
+  "openai-beta",
+  "originator",
+  "session-id",
+  "session_id",
+  "thread-id",
+  "x-client-request-id",
+  "x-codex-beta-features",
+  "x-codex-installation-id",
+  "x-codex-parent-thread-id",
+  "x-codex-turn-metadata",
+  "x-codex-turn-state",
+  "x-codex-window-id",
+  "x-oai-attestation",
+  "x-openai-subagent",
+  "x-responsesapi-include-timing-metrics",
+]);
+
+/**
+ * 识别 Router 为 Full harness 保留的整个模型命名空间。
+ * 动态目录之外的名称也必须被识别，才能在通用 native redirect 之前拒绝。
+ */
+export function isChatGptWebModelNamespace(value) {
+  return typeof value === "string" && value.startsWith("chatgpt-web/");
+}
+
+/** 只认可 Full harness 明确实现的六条路由，前缀相似不能获得直通权限。 */
+export function isChatGptWebModelSlug(value) {
+  return typeof value === "string" && CHATGPT_WEB_MODEL_SET.has(value);
+}
+
+/**
+ * 动态目录既是账号授权范围，也是 Router 热路径的路由证书。
+ * 只有 provider 已启用且该精确 slug 已实际发布时，才构造本机直通路由。
+ */
+export function resolveChatGptWebCatalogRoute(model, catalogModels = [], enabledProviders = []) {
+  if (!isChatGptWebModelSlug(model)) return undefined;
+  if (!new Set(enabledProviders).has("chatgpt-web")) return undefined;
+  const published = Array.isArray(catalogModels) && catalogModels.some(
+    (candidate) => String(candidate?.slug || "") === model,
+  );
+  return published
+    ? { slug: model, provider: "chatgpt-web", transport: "codex-native-responses" }
+    : undefined;
+}
+
+/**
+ * 保留 WebGPT 解析原生 Codex 信封所需的最小头部集合。
+ * Cookie、Host 与 Router 内部认证均不得跨越这个环回边界。
+ */
+export function filterCodexNativeHeaders(input = {}) {
+  const output = new Headers();
+  const entries = input instanceof Headers ? input.entries() : Object.entries(input);
+  for (const [name, value] of entries) {
+    const lower = String(name).toLowerCase();
+    if (!NATIVE_HEADER_ALLOWLIST.has(lower) || value === undefined || value === null) continue;
+    output.set(lower, Array.isArray(value) ? value.join(", ") : String(value));
+  }
+  return output;
+}
+
+function nativeTarget(route, search = "") {
+  if (!NATIVE_RESPONSE_ROUTES.has(route)) {
+    throw new Error(`Unsupported native Responses route: ${String(route)}`);
+  }
+  if (search && (typeof search !== "string" || !search.startsWith("?") || search.includes("#"))) {
+    throw new Error("Native Responses search must be an ordinary query string");
+  }
+  return `${CHATGPT_WEB_BASE_URL}${route}${search}`;
+}
+
+/**
+ * 单次、无转换地把原生 Responses 请求交给本机 Full harness。
+ * 返回上游 Response 本身可保留流、背压与取消语义；这里故意没有重试或 provider 回退。
+ */
+export async function forwardCodexNativeResponse({
+  model,
+  route,
+  search = "",
+  requestHeaders = {},
+  body,
+  signal,
+  fetchImpl = fetch,
+} = {}) {
+  if (!isChatGptWebModelSlug(model)) {
+    throw new Error(`ChatGPT Web model is not allowlisted: ${String(model)}`);
+  }
+  const target = nativeTarget(route, search);
+  return fetchImpl(target, {
+    method: "POST",
+    headers: filterCodexNativeHeaders(requestHeaders),
+    body,
+    signal,
+  });
+}
