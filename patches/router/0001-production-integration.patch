+import assert from "node:assert/strict";
+import { mkdtempSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+
+// 使用隔离状态目录，避免测试读取或改写用户当前的模型选择与 provider 状态。
+const testRoot = mkdtempSync(path.join(os.tmpdir(), "zai-api-cn-glm-test-"));
+process.env.MODEL_ROUTER_USER_MODELS = path.join(testRoot, "user-models.json");
+process.env.MODEL_ROUTER_STATE_DIR = path.join(testRoot, "state");
+
+const { MODEL_BY_SLUG, PROVIDERS } = await import("../src/model-registry.mjs");
+const { zaiCacheUsageTransform } = await import("../src/zai-cache-usage.mjs");
+const { zaiResponsesCompatTransform } = await import("../src/zai-responses-compat.mjs");
+
+test("zai-api-cn uses an isolated China-region endpoint and credential boundary", () => {
+  const chinaProvider = PROVIDERS.get("zai-api-cn");
+  const globalProvider = PROVIDERS.get("zai-api");
+
+  assert.ok(chinaProvider);
+  assert.equal(chinaProvider.baseUrl, "https://open.bigmodel.cn/api/paas/v4");
+  assert.deepEqual(chinaProvider.credential.environment, ["ZAI_API_CN_KEY", "ZHIPUAI_API_KEY"]);
+  assert.equal(chinaProvider.credential.file, "zai-api-cn-key.secret");
+
+  // 中国区与全球 Z.AI 必须保持独立，防止误把通用开放平台凭据发往全球端点。
+  assert.equal(globalProvider.baseUrl, "https://api.z.ai/api/paas/v4");
+  assert.notEqual(chinaProvider.credential.file, globalProvider.credential.file);
+});
+
+test("zai-api-cn/glm-5.3-flash exposes the verified long-context metadata", () => {
+  const model = MODEL_BY_SLUG.get("zai-api-cn/glm-5.3-flash");
+
+  assert.ok(model);
+  assert.equal(model.displayName, "GLM-5.3-Flash（智谱开放平台）");
+  assert.equal(model.provider, "zai-api-cn");
+  assert.equal(model.upstreamModel, "glm-5.3-flash");
+  assert.equal(model.contextWindow, 1_000_000);
+  assert.equal(model.autoCompact, 400_000);
+  assert.deepEqual(model.inputModalities, ["text", "image"]);
+  assert.deepEqual(model.reasoningLevels.map(({ effort }) => effort), ["low", "high", "max"]);
+  assert.equal(model.defaultEffort, "max");
+  assert.equal(model.requestProfile, "glm-thinking");
+  assert.equal(model.multiAgentVersion, undefined);
+});
+
+test("zai-api-cn participates in the existing GLM streaming compatibility chain", () => {
+  assert.ok(zaiCacheUsageTransform("zai-api-cn", "text/event-stream"));
+  assert.ok(zaiResponsesCompatTransform("zai-api-cn", "text/event-stream"));
+  assert.equal(zaiCacheUsageTransform("unrelated-provider", "text/event-stream"), undefined);
+  assert.equal(zaiResponsesCompatTransform("unrelated-provider", "text/event-stream"), undefined);
+});
