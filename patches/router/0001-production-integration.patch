+  assert.deepEqual(
+    customConnectionRegistryDocument(options).providers.map((provider) => provider.protocol),
+    ["openai-responses", "openai", "anthropic"],
+  );
+});
+
+test("model-directory probe never follows a cross-origin redirect", async () => {
+  let destinationHits = 0;
+  const destination = http.createServer((_request, response) => {
+    destinationHits += 1;
+    response.end('{"data":[]}');
+  });
+  await new Promise((resolve) => destination.listen(0, "127.0.0.1", resolve));
+  const destinationPort = destination.address().port;
+  const source = http.createServer((_request, response) => {
+    response.writeHead(302, { Location: `http://127.0.0.1:${destinationPort}/v1/models` });
+    response.end();
+  });
+  await new Promise((resolve) => source.listen(0, "127.0.0.1", resolve));
+  const sourcePort = source.address().port;
+
+  try {
+    const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-probe-"));
+    const options = isolatedOptions(stateDir);
+    await createCustomConnection(
+      remoteDraft({
+        id: "local-probe",
+        baseUrl: `http://127.0.0.1:${sourcePort}/v1`,
+        keyless: true,
+      }),
+      options,
+    );
+    await assert.rejects(probeCustomConnection("local-probe", options), /cross-origin redirect/);
+    assert.equal(destinationHits, 0);
+  } finally {
+    source.close();
+    destination.close();
+  }
+});
+
+test("the fresh model registry loads active custom connections and their protocol", () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-live-registry-"));
+  writeFileSync(
+    path.join(stateDir, "custom-connections.json"),
+    `${JSON.stringify({
+      version: 1,
+      active: [remoteDraft({ protocol: "openai-chat", models: ["model-a"] })],
+      candidate: null,
+    })}\n`,
+    { mode: 0o600 },
+  );
+  writeFileSync(path.join(stateDir, "custom-connection-team-api.secret"), "secret\n", {
+    mode: 0o600,
+  });
+  const script = [
+    "const registry = await import('./src/model-registry.mjs');",
+    "const provider = registry.PROVIDERS.get('custom-team-api');",
+    "const model = registry.MODEL_BY_SLUG.get('custom-team-api/model-a');",
+    "process.stdout.write(JSON.stringify({ protocol: provider?.protocol, model, checkedIn: registry.CHECKED_IN_MODELS.some((entry) => entry.slug === 'custom-team-api/model-a') }));",
+  ].join("\n");
+  const output = execFileSync(process.execPath, ["--input-type=module", "-e", script], {
+    cwd: path.resolve(import.meta.dirname, ".."),
+    encoding: "utf8",
+    env: {
+      ...process.env,
+      MODEL_ROUTER_STATE_DIR: stateDir,
+      CODEX_HOME: stateDir,
+    },
+  });
+  const result = JSON.parse(output);
+  assert.equal(result.protocol, "openai");
+  assert.equal(result.model.upstreamModel, "model-a");
+  assert.equal(result.model.metadataEstimated, true);
+  assert.equal(result.checkedIn, false);
+});
+
+async function openPort() {
+  const server = net.createServer();
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const port = server.address().port;
+  await new Promise((resolve) => server.close(resolve));
+  return port;
+}
+
+async function waitForHealth(port, child, key) {
+  const deadline = Date.now() + 10_000;
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null) throw new Error("API forwarder exited before health was ready.");
+    try {
+      const response = await fetch(`http://127.0.0.1:${port}/health`, {
+        headers: { Authorization: `Bearer ${key}` },
+      });
+      if (response.ok) return;
+    } catch {
+      // Startup races the first few probes.
+    }
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  }
+  throw new Error("API forwarder health timed out.");
+}
+
+test("the API forwarder refuses a custom connection cross-origin redirect", async () => {
+  let destinationHits = 0;
+  let sourceHits = 0;
+  const destination = http.createServer((_request, response) => {
+    destinationHits += 1;
+    response.end('{"output":[]}');
+  });
+  await new Promise((resolve) => destination.listen(0, "127.0.0.1", resolve));
+  const destinationPort = destination.address().port;
+  const source = http.createServer((_request, response) => {
+    sourceHits += 1;
+    response.writeHead(307, { Location: `http://127.0.0.1:${destinationPort}/v1/responses` });
+    response.end();
+  });
+  await new Promise((resolve) => source.listen(0, "127.0.0.1", resolve));
+  const sourcePort = source.address().port;
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connection-forwarder-"));
+  writeFileSync(
+    path.join(stateDir, "custom-connections.json"),
+    `${JSON.stringify({
+      version: 1,
+      active: [remoteDraft({
+        id: "local-forward",
+        baseUrl: `http://127.0.0.1:${sourcePort}/v1`,
+        keyless: true,
+        models: ["model-a"],
+      })],
+      candidate: null,
+    })}\n`,
+    { mode: 0o600 },
+  );
+  const forwarderPort = await openPort();
+  const internalKey = "CUSTOM_CONNECTION_INTERNAL_TEST_KEY";
+  const child = spawn(process.execPath, [path.resolve(import.meta.dirname, "../src/api-forwarder.mjs")], {
+    cwd: path.resolve(import.meta.dirname, ".."),
+    env: {
+      ...process.env,
+      CODEX_HOME: stateDir,
+      MODEL_ROUTER_STATE_DIR: stateDir,
+      MODEL_ROUTER_API_PORT: String(forwarderPort),
+      MODEL_ROUTER_INTERNAL_KEY: internalKey,
+      MODEL_ROUTER_QUIET: "1",
+    },
+    stdio: ["ignore", "ignore", "pipe"],
+  });
+  try {
+    await waitForHealth(forwarderPort, child, internalKey);
+    const response = await fetch(`http://127.0.0.1:${forwarderPort}/v1/responses`, {
+      method: "POST",
+      headers: {
+        Authorization: `Bearer ${internalKey}`,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify({
+        model: "custom-local-forward-model-a",
+        input: "hello",
+      }),
+    });
+    assert.equal(response.status, 502);
+    assert.equal(sourceHits, 1);
+    assert.equal(destinationHits, 0);
+  } finally {
+    child.kill("SIGTERM");
+    await new Promise((resolve) => child.once("exit", resolve));
+    source.close();
+    destination.close();
+  }
+});
