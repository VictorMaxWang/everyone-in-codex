@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+
+import {
+  CHATGPT_WEB_DISPLAY_NAMES,
+  fetchChatGptWebCatalog,
+  mergeChatGptWebCatalogModels,
+  parseCodexClientVersion,
+  readChatGptWebLastGoodCache,
+  selectChatGptWebCatalogModels,
+  writeChatGptWebLastGoodCache,
+} from "../src/chatgpt-web-catalog.mjs";
+
+const EXPECTED_NAMES = {
+  "chatgpt-web/light": "ChatGPT/Instant",
+  "chatgpt-web/medium": "ChatGPT/Medium",
+  "chatgpt-web/high": "ChatGPT/High",
+  "chatgpt-web/extra-high": "ChatGPT/Extra High",
+  "chatgpt-web/pro": "ChatGPT/Pro",
+  "chatgpt-web/luna": "ChatGPT/Luna",
+};
+
+test("Codex version output becomes the required ChatGPT catalog client_version", () => {
+  assert.equal(parseCodexClientVersion("codex-cli 0.147.0"), "0.147.0");
+  assert.equal(parseCodexClientVersion("codex-cli 0.147.0-alpha.1.2"), "0.147.0-alpha.1.2");
+  assert.equal(parseCodexClientVersion("unknown"), undefined);
+});
+
+test("catalog selection keeps only exact ChatGPT Web routes and preserves their Codex metadata", () => {
+  assert.deepEqual(CHATGPT_WEB_DISPLAY_NAMES, EXPECTED_NAMES);
+  const nested = [{ effort: "high", description: "High" }];
+  const selected = selectChatGptWebCatalogModels({
+    models: [
+      { slug: "gpt-5.6-sol", display_name: "Native Sol" },
+      {
+        slug: "chatgpt-web/high",
+        display_name: "ChatGPT Web — High",
+        supported_reasoning_levels: nested,
+        context_window: 111_193,
+        multi_agent_version: "v2",
+      },
+      { slug: "chatgpt-web/unknown", display_name: "Unknown" },
+      { id: "chatgpt-web/luna", object: "model", context_window: 1_050_000 },
+    ],
+  });
+
+  assert.deepEqual(selected, [
+    {
+      slug: "chatgpt-web/high",
+      display_name: "ChatGPT/High",
+      supported_reasoning_levels: nested,
+      context_window: 111_193,
+      multi_agent_version: "v2",
+    },
+    {
+      id: "chatgpt-web/luna",
+      object: "model",
+      context_window: 1_050_000,
+      slug: "chatgpt-web/luna",
+      display_name: "ChatGPT/Luna",
+    },
+  ]);
+  assert.notEqual(selected[0].supported_reasoning_levels, nested);
+});
+
+test("trusted WebGPT rows merge without rewriting native metadata or accepting duplicates", () => {
+  const native = [{ slug: "gpt-5.6-sol", display_name: "GPT-5.6 Sol" }];
+  const merged = mergeChatGptWebCatalogModels(native, [
+    {
+      slug: "chatgpt-web/high",
+      display_name: "wrong upstream label",
+      context_window: 111_193,
+      multi_agent_version: "v2",
+      supported_reasoning_levels: [{ effort: "high", description: "High" }],
+    },
+    { slug: "gpt-5.6-sol", display_name: "must not replace native" },
+    { slug: "chatgpt-web/unknown", display_name: "must be rejected" },
+  ]);
+
+  assert.deepEqual(merged, [
+    native[0],
+    {
+      slug: "chatgpt-web/high",
+      display_name: "ChatGPT/High",
+      context_window: 111_193,
+      multi_agent_version: "v2",
+      supported_reasoning_levels: [{ effort: "high", description: "High" }],
+    },
+  ]);
+});
+
+test("the last-good helper stores only non-secret catalog rows", () => {
+  const directory = mkdtempSync(path.join(os.tmpdir(), "chatgpt-web-catalog-"));
+  const cachePath = path.join(directory, "last-good.json");
+  const models = selectChatGptWebCatalogModels({
+    models: [{ slug: "chatgpt-web/pro", display_name: "old", context_window: 112_193 }],
+    authorization: "Bearer must-not-be-cached",
+  });
+
+  writeChatGptWebLastGoodCache(cachePath, models, {
+    fetchedAt: "2026-08-23T01:02:03.000Z",
+  });
+  const raw = readFileSync(cachePath, "utf8");
+  assert.doesNotMatch(raw, /Bearer|authorization/i);
+  assert.deepEqual(readChatGptWebLastGoodCache(cachePath), {
+    fetchedAt: "2026-08-23T01:02:03.000Z",
+    models: [{
+      slug: "chatgpt-web/pro",
+      display_name: "ChatGPT/Pro",
+      context_window: 112_193,
+    }],
+  });
+
+  writeFileSync(cachePath, '{"version":999,"models":[]}');
+  assert.equal(readChatGptWebLastGoodCache(cachePath), undefined);
+});
+
+test("live catalog fetch is single-shot and updates last-good cache", async () => {
+  const directory = mkdtempSync(path.join(os.tmpdir(), "chatgpt-web-live-"));
+  const cachePath = path.join(directory, "last-good.json");
+  const controller = new AbortController();
+  const calls = [];
+  const result = await fetchChatGptWebCatalog({
+    cachePath,
+    clientVersion: "0.147.0",
+    requestHeaders: {
+      authorization: "Bearer local-session",
+      cookie: "drop-me",
+    },
+    signal: controller.signal,
+    now: () => new Date("2026-08-23T02:03:04.000Z"),
+    fetchImpl: async (...args) => {
+      calls.push(args);
+      return Response.json({
+        models: [
+          { slug: "gpt-5.6-sol", display_name: "Native" },
+          { slug: "chatgpt-web/light", display_name: "Web", context_window: 111_193 },
+        ],
+      });
+    },
+  });
+
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0][0], "http://127.0.0.1:17841/v1/models?client_version=0.147.0");
+  assert.equal(calls[0][1].method, "GET");
+  assert.equal(calls[0][1].signal, controller.signal);
+  assert.deepEqual(Object.fromEntries(calls[0][1].headers), {
+    authorization: "Bearer local-session",
+  });
+  assert.deepEqual(result, {
+    source: "live",
+    fetchedAt: "2026-08-23T02:03:04.000Z",
+    models: [{
+      slug: "chatgpt-web/light",
+      display_name: "ChatGPT/Instant",
+      context_window: 111_193,
+    }],
+  });
+  assert.deepEqual(readChatGptWebLastGoodCache(cachePath)?.models, result.models);
+});
+
+test("an unavailable live catalog reuses last-good rows without a second fetch", async () => {
+  const directory = mkdtempSync(path.join(os.tmpdir(), "chatgpt-web-offline-"));
+  const cachePath = path.join(directory, "last-good.json");
+  writeChatGptWebLastGoodCache(
+    cachePath,
+    [{ slug: "chatgpt-web/medium", display_name: "ChatGPT/Medium" }],
+    { fetchedAt: "2026-08-22T02:03:04.000Z" },
+  );
+  let calls = 0;
+  const result = await fetchChatGptWebCatalog({
+    cachePath,
+    clientVersion: "0.147.0",
+    fetchImpl: async () => {
+      calls += 1;
+      throw new Error("offline");
+    },
+  });
+
+  assert.equal(calls, 1);
+  assert.deepEqual(result, {
+    source: "cache",
+    fetchedAt: "2026-08-22T02:03:04.000Z",
+    models: [{ slug: "chatgpt-web/medium", display_name: "ChatGPT/Medium" }],
+  });
+});
