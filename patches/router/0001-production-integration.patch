+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { existsSync, mkdtempSync, readFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+
+const root = path.resolve(import.meta.dirname, "..");
+
+function run(stateDir, args, input = "") {
+  return execFileSync(process.execPath, [path.join(root, "src", "control.mjs"), ...args], {
+    cwd: root,
+    encoding: "utf8",
+    input,
+    env: {
+      ...process.env,
+      CODEX_HOME: stateDir,
+      MODEL_ROUTER_STATE_DIR: stateDir,
+      MODEL_ROUTER_TARGET: "codex",
+    },
+  });
+}
+
+test("control exposes plan, create, secret-set, list, and apply without echoing a key", () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "custom-connections-control-"));
+  const draft = JSON.stringify({
+    id: "team-api",
+    displayName: "Team API",
+    baseUrl: "https://models.example.test/v1",
+    protocol: "openai-responses",
+    models: ["model-a"],
+  });
+  const planned = JSON.parse(run(stateDir, ["connections", "plan"], draft));
+  assert.equal(planned.id, "team-api");
+  assert.equal(existsSync(path.join(stateDir, "custom-connections.json")), false);
+  const created = JSON.parse(run(stateDir, ["connections", "create"], draft));
+  assert.equal(created.connection.id, "team-api");
+  const secret = "control-test-secret";
+  const set = JSON.parse(run(stateDir, ["connections", "secret-set", "team-api"], secret));
+  assert.deepEqual(set, { id: "team-api", configured: true });
+  assert.doesNotMatch(JSON.stringify(set), /control-test-secret/);
+  assert.doesNotMatch(readFileSync(path.join(stateDir, "custom-connections.json"), "utf8"), /control-test-secret/);
+
+  const listed = JSON.parse(run(stateDir, ["connections", "list"]));
+  assert.equal(listed.candidate[0].credentialConfigured, true);
+  const applied = JSON.parse(run(stateDir, ["connections", "apply"]));
+  assert.equal(applied.restartRequired, true);
+  assert.deepEqual(applied.active, ["team-api"]);
+
+  const updatedDraft = JSON.stringify({
+    ...JSON.parse(draft),
+    displayName: "Updated Team API",
+    models: ["model-a", "model-b"],
+  });
+  const updated = JSON.parse(
+    run(stateDir, ["connections", "update", "team-api"], updatedDraft),
+  );
+  assert.equal(updated.connection.displayName, "Updated Team API");
+  const removed = JSON.parse(run(stateDir, ["connections", "remove", "team-api"]));
+  assert.equal(removed.removal.pendingRemoval, true);
+  assert.deepEqual(removed.snapshot.candidate, []);
+});
