+        const nextIds = new Set(before.candidate.map((entry) => entry.id));
+        for (const connection of before.active) {
+          if (!nextIds.has(connection.id)) {
+            const target = activeSecretPath(connection.id, resolved.stateDir);
+            if (existsSync(target)) unlinkSync(target);
+          }
+        }
+        for (const connection of [...before.active, ...before.candidate]) {
+          const staged = candidateSecretPath(connection.id, resolved.stateDir);
+          if (existsSync(staged)) unlinkSync(staged);
+        }
