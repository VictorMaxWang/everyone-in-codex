+  );
+  publicationChild = child;
+  publicationChild.unref?.();
+  const finished = () => {
+    if (publicationChild !== child) return;
+    publicationChild = undefined;
+    if (publicationQueued) {
+      publicationQueued = false;
+      requestChatGptWebCatalogPublication({ spawnImpl });
+    }
+  };
+  // spawn 本身失败也必须被消费，否则一个临时的进程创建错误会让整个
+  // Router 因未处理的 EventEmitter error 退出。
+  publicationChild.once("error", finished);
+  publicationChild.once("exit", finished);
+  return { scheduled: true, queued: false };
+}
+
+/** 单次检查只在实时目录与已发布目录不同的时候启动发布事务。 */
+export async function syncChatGptWebCatalogOnce({
+  enabled = () => readProviderSelection().includes("chatgpt-web"),
+  fetchCatalog = () => fetchChatGptWebCatalog({
+    cachePath: CHATGPT_WEB_CATALOG_CACHE_PATH,
+    requestHeaders: nativeSessionHeaders() || {},
+    fetchImpl: (target, options) => fetch(target, {
+      ...options,
+      signal: AbortSignal.timeout(5_000),
+    }),
+  }),
+  readPublished = readPublishedChatGptWebModels,
+  publish = requestChatGptWebCatalogPublication,
+} = {}) {
+  if (!enabled()) return { status: "disabled" };
+  const live = await fetchCatalog();
+  if (
+    chatGptWebCatalogFingerprint(live.models)
+    === chatGptWebCatalogFingerprint(readPublished())
+  ) {
+    return { status: live.source === "live" ? "unchanged" : "offline-cache" };
+  }
+  // last-good 不只是展示缓存，也是目录恢复源：若已发布文件缺失或漂移，
+  // 即使 WebGPT 暂时离线也要重跑同一发布事务，避免只能靠手工 catalog 修复。
+  return {
+    status: live.source === "live" ? "refreshing" : "restoring-cache",
+    ...publish(),
+  };
+}
+
+function armCatalogPoll(delayMs, loop) {
+  pollTimer = loop.setTimer(async () => {
+    pollTimer = undefined;
+    try {
+      await loop.sync();
+    } catch {
+      // 本机服务尚未登录、正在升级或暂时断线都属于预期状态；last-good
+      // 继续服务，下一轮会自动重试，且错误正文不会进入 Router 日志。
+    } finally {
+      // stop 可能发生在异步探测期间；generation 防止已取消的旧回调复活轮询。
+      if (pollActive && pollGeneration === loop.generation) {
+        armCatalogPoll(loop.pollMs, loop);
+      }
+    }
+  }, delayMs);
+  pollTimer.unref?.();
+}
+
+export function startChatGptWebCatalogSync({
+  sync = syncChatGptWebCatalogOnce,
+  firstPollMs,
+  pollMs,
+  setTimer = setTimeout,
+  clearTimer = clearTimeout,
+} = {}) {
+  if (process.env.CODEX_ROUTER_DISABLE_CHATGPT_WEB_CATALOG_SYNC === "1") return;
+  if (pollActive) return;
+  pollActive = true;
+  pollGeneration += 1;
+  pollClearTimer = clearTimer;
+  const loop = {
+    sync,
+    setTimer,
+    generation: pollGeneration,
+    pollMs: boundedDelay(
+      pollMs ?? process.env.CODEX_ROUTER_CHATGPT_WEB_CATALOG_POLL_MS,
+      DEFAULT_POLL_MS,
+    ),
+  };
+  armCatalogPoll(boundedDelay(
+    firstPollMs ?? process.env.CODEX_ROUTER_CHATGPT_WEB_CATALOG_FIRST_POLL_MS,
+    DEFAULT_FIRST_POLL_MS,
+  ), loop);
+}
+
+export function stopChatGptWebCatalogSync() {
+  pollActive = false;
+  pollGeneration += 1;
+  if (pollTimer) pollClearTimer(pollTimer);
+  pollTimer = undefined;
+  pollClearTimer = clearTimeout;
+}
diff --git a/src/chatgpt-web-catalog.mjs b/src/chatgpt-web-catalog.mjs
