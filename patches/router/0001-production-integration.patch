index 0000000000000000000000000000000000000000..c9eb5af2b630049dead781ed31c26d7d865898e2
--- /dev/null
+++ b/src/chatgpt-web-catalog.mjs
@@ -0,0 +1,198 @@
+import { existsSync, readFileSync, statSync } from "node:fs";
+import path from "node:path";
+
+import {
+  CHATGPT_WEB_BASE_URL,
+  filterCodexNativeHeaders,
+  isChatGptWebModelSlug,
+} from "./codex-native-responses.mjs";
+import { codexVersion } from "./codex-binary.mjs";
+import { writePrivateJson } from "./file-security.mjs";
+import { STATE_DIR } from "./paths.mjs";
+
+const CACHE_VERSION = 1;
+const MAX_CACHE_BYTES = 4 * 1024 * 1024;
+const SENSITIVE_KEYS = new Set([
+  "access_token",
+  "api_key",
+  "authorization",
+  "cookie",
+  "refresh_token",
+  "set-cookie",
+]);
+
+export const CHATGPT_WEB_CATALOG_CACHE_PATH =
+  process.env.CODEX_ROUTER_CHATGPT_WEB_CATALOG ||
+  path.join(STATE_DIR, "chatgpt-web-models.json");
+
+export const CHATGPT_WEB_DISPLAY_NAMES = Object.freeze({
+  "chatgpt-web/light": "ChatGPT/Instant",
+  "chatgpt-web/medium": "ChatGPT/Medium",
+  "chatgpt-web/high": "ChatGPT/High",
+  "chatgpt-web/extra-high": "ChatGPT/Extra High",
+  "chatgpt-web/pro": "ChatGPT/Pro",
+  "chatgpt-web/luna": "ChatGPT/Luna",
+});
+
+let cachedClientVersion;
+
+export function parseCodexClientVersion(value) {
+  return String(value || "").match(/\b(\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?)\b/)?.[1];
+}
+
+function localCodexClientVersion() {
+  if (cachedClientVersion === undefined) {
+    cachedClientVersion = parseCodexClientVersion(codexVersion()) || null;
+  }
+  return cachedClientVersion || undefined;
+}
+
+function safeCatalogValue(value) {
+  if (Array.isArray(value)) return value.map(safeCatalogValue);
+  if (!value || typeof value !== "object") return value;
+  const kept = {};
+  for (const [key, child] of Object.entries(value)) {
+    if (!SENSITIVE_KEYS.has(key.toLowerCase())) kept[key] = safeCatalogValue(child);
+  }
+  return kept;
+}
+
+function catalogRows(value) {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return [];
+  if (Array.isArray(value.models)) return value.models;
+  return Array.isArray(value.data) ? value.data : [];
+}
+
+/**
+ * WebGPT 的 `/models` 同时带回官方原生模型；这里只提取精确允许的六条
+ * Web 路由，并保留上游已经实测出的上下文、推理与 Native V2 元数据。
+ */
+export function selectChatGptWebCatalogModels(value) {
+  const selected = [];
+  for (const candidate of catalogRows(value)) {
+    if (!candidate || typeof candidate !== "object" || Array.isArray(candidate)) continue;
+    const slug = typeof candidate.slug === "string"
+      ? candidate.slug
+      : typeof candidate.id === "string"
+        ? candidate.id
+        : undefined;
+    if (!isChatGptWebModelSlug(slug)) continue;
+    selected.push({
+      ...safeCatalogValue(structuredClone(candidate)),
+      slug,
+      display_name: CHATGPT_WEB_DISPLAY_NAMES[slug],
+    });
+  }
+  return selected;
+}
+
+/**
+ * 将受信 WebGPT 行直接叠加到 Codex 目录，避免套用普通 provider 模板。
+ * 原生条目永远优先；即使上游返回同名行，也不能覆盖 Codex 自有模型。
+ */
+export function mergeChatGptWebCatalogModels(existingModels = [], candidates = []) {
+  const merged = new Map(
+    (Array.isArray(existingModels) ? existingModels : []).map((model) => [String(model?.slug), model]),
+  );
+  for (const model of selectChatGptWebCatalogModels({ models: candidates })) {
+    if (!merged.has(model.slug)) merged.set(model.slug, model);
+  }
+  return [...merged.values()];
+}
+
+/** 读取仅含目录元数据的 last-good 缓存；损坏或异版本文件按 miss 处理。 */
+export function readChatGptWebLastGoodCache(cachePath) {
+  if (!cachePath || !existsSync(cachePath)) return undefined;
+  try {
+    if (statSync(cachePath).size > MAX_CACHE_BYTES) return undefined;
+    const parsed = JSON.parse(readFileSync(cachePath, "utf8"));
+    if (parsed?.version !== CACHE_VERSION || !Array.isArray(parsed.models)) return undefined;
+    if (typeof parsed.fetchedAt !== "string" || !Number.isFinite(Date.parse(parsed.fetchedAt))) {
+      return undefined;
+    }
+    const models = selectChatGptWebCatalogModels({ models: parsed.models });
+    if (models.length !== parsed.models.length || models.length === 0) return undefined;
+    return { fetchedAt: parsed.fetchedAt, models };
+  } catch {
+    return undefined;
+  }
+}
+
+/** 写入非机密目录快照；认证头与账号凭据从未成为该接口的输入。 */
+export function writeChatGptWebLastGoodCache(cachePath, models, { fetchedAt } = {}) {
+  const selected = selectChatGptWebCatalogModels({ models });
+  if (!cachePath || selected.length === 0) return undefined;
+  const stamped = fetchedAt || new Date().toISOString();
+  if (!Number.isFinite(Date.parse(stamped))) return undefined;
+  writePrivateJson(cachePath, { version: CACHE_VERSION, fetchedAt: stamped, models: selected }, {
+    directoryMode: 0o700,
+  });
+  return { fetchedAt: stamped, models: selected };
+}
+
+/**
+ * 单次读取本机 WebGPT 目录；仅在实时读取失败时返回 last-good。
+ * 调用方取消时不伪装为离线命中，确保停止刷新仍然是可观察的取消。
+ */
+export async function fetchChatGptWebCatalog({
+  cachePath,
+  clientVersion = localCodexClientVersion(),
+  requestHeaders = {},
+  signal,
+  fetchImpl = fetch,
+  now = () => new Date(),
+} = {}) {
+  try {
+    if (!clientVersion) throw new Error("Codex client version is unavailable for ChatGPT Web catalog discovery");
+    const target = new URL(`${CHATGPT_WEB_BASE_URL}/models`);
+    // ChatGPT 的 Codex 模型目录要求 client_version；缺少时会返回 400。
+    // 版本来自本机 Codex 二进制，只作为查询参数，不进入 last-good 缓存。
+    target.searchParams.set("client_version", clientVersion);
+    const response = await fetchImpl(target.toString(), {
+      method: "GET",
+      headers: filterCodexNativeHeaders(requestHeaders),
+      signal,
+    });
+    if (!response.ok) throw new Error(`ChatGPT Web catalog returned HTTP ${response.status}`);
+    const models = selectChatGptWebCatalogModels(await response.json());
+    if (models.length === 0) throw new Error("ChatGPT Web catalog published no allowlisted models");
+    const current = now();
+    const fetchedAt = current instanceof Date ? current.toISOString() : new Date(current).toISOString();
+    writeChatGptWebLastGoodCache(cachePath, models, { fetchedAt });
+    return { source: "live", fetchedAt, models };
+  } catch (error) {
+    if (signal?.aborted) throw error;
+    const cached = readChatGptWebLastGoodCache(cachePath);
+    if (!cached) throw error;
+    return { source: "cache", ...cached };
+  }
+}
+
+/** 无凭据探测 Full harness 运行状态；只信任固定环回服务的结构化应答。 */
+export async function chatGptWebHealth({ fetchImpl = fetch, signal } = {}) {
+  try {
+    const response = await fetchImpl("http://127.0.0.1:17841/healthz", {
+      method: "GET",
+      signal,
+    });
+    if (!response.ok) {
+      return { ok: false, detail: `local Full harness returned HTTP ${response.status}` };
+    }
+    const payload = await response.json();
+    const serviceReady = payload?.status === "ok"
+      && payload?.service === "codex-chatgpt-web"
+      && payload?.accepting_turns !== false;
+    if (!serviceReady) {
+      return { ok: false, detail: "local Full harness is not accepting turns" };
+    }
+    if (payload.mode !== "full") {
+      return { ok: false, detail: `local WebGPT is running in ${String(payload.mode || "unknown")} mode, not Full harness` };
+    }
+    return {
+      ok: true,
+      detail: `Full harness ${String(payload.version || "unknown")} is accepting turns on 127.0.0.1:17841`,
+    };
+  } catch {
+    return { ok: false, detail: "local Full harness is not reachable on 127.0.0.1:17841" };
+  }
+}
