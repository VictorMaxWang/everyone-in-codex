+test("OpenCode Free models publish on their documented Chat and Responses surfaces", async () => {
+  const stateDir = mkdtempSync(path.join(os.tmpdir(), "opencode-free-protocols-"));
+  const userModelsPath = path.join(stateDir, "user-models.json");
+  process.env.MODEL_ROUTER_STATE_DIR = stateDir;
+  process.env.MODEL_ROUTER_USER_MODELS = userModelsPath;
+  writeFileSync(
+    userModelsPath,
+    JSON.stringify({
+      version: 1,
+      models: [
+        {
+          slug: "opencode-free/x-preview-f-free",
+          gatewayModel: "opencode-free-x-preview-f-free",
+          compHash: "opencode-free-x-preview-f-free-user-v1",
+          upstreamModel: "x-preview-f-free",
+          provider: "opencode-free",
+          listed: true,
+          displayName: "open code / Ox Alpha Free",
+          description: "Test fixture",
+          priority: 100,
+          defaultEffort: "high",
+          reasoningLevels: [{ effort: "high", description: "Deep reasoning" }],
+          contextWindow: 1000000,
+          autoCompact: 850000,
+          inputModalities: ["text", "image"],
+        },
+        {
+          slug: "opencode-free-responses/muse-spark-1.2-contributor-free",
+          gatewayModel: "opencode-free-responses-muse-spark-1-2-contributor-free",
+          compHash: "opencode-free-responses-muse-spark-1-2-contributor-free-user-v1",
+          upstreamModel: "muse-spark-1.2-contributor-free",
+          provider: "opencode-free-responses",
+          listed: true,
+          displayName: "open code / Muse Spark 1.2 Contributor Free",
+          description: "Test fixture",
+          priority: 101,
+          defaultEffort: "high",
+          reasoningLevels: [{ effort: "high", description: "Deep reasoning" }],
+          contextWindow: 1048576,
+          autoCompact: 891289,
+          inputModalities: ["text", "image"],
+          requestProfile: "opencode-responses-no-recursive-tools",
+        },
+        {
+          slug: "opencode-free/big-pickle",
+          gatewayModel: "opencode-free-big-pickle",
+          compHash: "opencode-free-big-pickle-user-v1",
+          upstreamModel: "big-pickle",
+          provider: "opencode-free",
+          listed: true,
+          displayName: "open code / Big Pickle",
+          description: "Test fixture",
+          priority: 102,
+          reasoningLevels: [],
+          contextWindow: 200000,
+          autoCompact: 170000,
+          inputModalities: ["text"],
+          requestProfile: "upstream-controlled-reasoning",
+        },
+      ],
+    }),
+    { mode: 0o600 },
+  );
+
+  try {
+    const { MODELS, providerForModel } = await import("../src/model-registry.mjs");
+    const { renderLiteLlmConfig } = await import("../src/litellm-config.mjs");
+    const rendered = renderLiteLlmConfig();
+    const blockFor = (gatewayModel) => {
+      const start = rendered.indexOf(`model_name: "${gatewayModel}"`);
+      assert.ok(start >= 0, `${gatewayModel} must be published`);
+      const next = rendered.indexOf("model_name:", start + 1);
+      return rendered.slice(start, next === -1 ? undefined : next);
+    };
+
+    const muse = MODELS.find(
+      (model) => model.gatewayModel === "opencode-free-responses-muse-spark-1-2-contributor-free",
+    );
+    assert.equal(providerForModel(muse).protocol, "openai-responses");
+    assert.equal(muse.requestProfile, "opencode-responses-no-recursive-tools");
+    assert.match(
+      blockFor(muse.gatewayModel),
+      /model: "openai\/responses\/opencode-free-responses-muse-spark-1-2-contributor-free"/,
+    );
+    assert.doesNotMatch(blockFor(muse.gatewayModel), /use_chat_completions_api/);
+
+    for (const gatewayModel of ["opencode-free-x-preview-f-free", "opencode-free-big-pickle"]) {
+      const model = MODELS.find((entry) => entry.gatewayModel === gatewayModel);
+      assert.equal(providerForModel(model).protocol, undefined);
+      assert.match(blockFor(gatewayModel), new RegExp(`model: "openai/${gatewayModel}"`));
+      assert.match(blockFor(gatewayModel), /use_chat_completions_api: true/);
+    }
+  } finally {
+    rmSync(stateDir, { recursive: true, force: true });
+  }
+});
