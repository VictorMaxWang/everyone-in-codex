+async function readConnectionDraftFromStdin() {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of process.stdin) {
+    size += chunk.length;
+    if (size > 1024 * 1024) throw new Error("The custom connection draft is too large.");
+    chunks.push(chunk);
+  }
+  const raw = Buffer.concat(chunks).toString("utf8").trim();
+  if (!raw) throw new Error("A custom connection JSON draft is required on stdin.");
+  let parsed;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw new Error("The custom connection draft on stdin is not valid JSON.");
+  }
+  return parsed;
+}
