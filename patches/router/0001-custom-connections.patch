+  } else if (action === "remove") {
+    if (!id) throw new Error("Usage: control connections remove <id>");
+    result = {
+      removal: await removeCustomConnection(id),
+      snapshot: customConnectionsSnapshot(),
+    };
+  } else if (action === "probe") {
+    if (!id) throw new Error("Usage: control connections probe <id>");
+    result = await probeCustomConnection(id);
+  } else if (action === "secret-set") {
+    if (!id) throw new Error("Usage: control connections secret-set <id>");
+    result = await setCustomConnectionSecret(id, await readSecretFromStdin());
+  } else if (action === "apply") {
+    result = await applyCustomConnections();
