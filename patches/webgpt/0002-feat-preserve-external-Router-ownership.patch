+      "--browser-only",
+      "--browser-host-descriptor",
+      descriptorPath,
+      "--port",
+      String(responsesPort),
+      "--no-codex-route",
+      "--subagent-protocol",
+      "native",
+      "--refresh-account-capabilities",
+      "--acknowledge-unofficial",
+    ], environment);
+    expect({ exitCode: refresh.exitCode, stderr: refresh.stderr }).toEqual({ exitCode: 0, stderr: "" });
+    expect(refresh.stdout).toContain("Codex routing remains externally managed");
+    expect(refresh.stdout).not.toContain("installed route");
+
+    const route = await runCli(["route", "status"], environment);
+    expect(JSON.parse(route.stdout)).toEqual({ installed: false, active: false, external: true, errors: [] });
