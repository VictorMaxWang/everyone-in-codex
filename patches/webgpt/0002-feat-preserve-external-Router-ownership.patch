+      "--subagent-protocol",
+      "native",
+      "--bigger-context",
+      "--acknowledge-unofficial",
+    ], environment);
+    expect({ exitCode: biggerContext.exitCode, stderr: biggerContext.stderr }).toEqual({ exitCode: 0, stderr: "" });
+    expect(biggerContext.stdout).toContain("refresh the external Router model catalog and restart Codex once");
+    expect(biggerContext.stdout).not.toContain("installed route");
