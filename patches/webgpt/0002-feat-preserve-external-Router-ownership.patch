+    expect({ exitCode: setup.exitCode, stderr: setup.stderr }).toEqual({ exitCode: 0, stderr: "" });
+    expect(setup.stdout).toContain("Codex routing remains externally managed");
+    expect(setup.stdout).not.toContain("installed route");
+    expect(JSON.parse(readFileSync(join(appHome, "config.json"), "utf8"))).toMatchObject({
+      codexIntegration: "external",
+      subagentProtocol: "native",
+      browserHost: "launcher",
+    });
+    expect(existsSync(join(appHome, "codex", "integration-journal.json"))).toBe(false);
+
+    const biggerContext = await runCli([
+      "setup",
+      "--browser-only",
+      "--browser-host-descriptor",
