+function attachHelperCleanupFailure(primary: Error, cleanup: unknown, message: string): Error {
+  const cleanupError = cleanup instanceof Error ? cleanup : new Error(String(cleanup));
+  if (!(primary instanceof ChatGptWebAdapterError) || primary.retryable) {
+    return new AggregateError([primary, cleanupError], message);
+  }
+
+  // 不可逆提交错误是调用方禁止自动重试的结构化边界；清理失败只能作为诊断附着，
+  // 不能把顶层错误替换成普通 AggregateError，否则上游会丢失 retryable:false。
+  const previousCause = (primary as Error & { cause?: unknown }).cause;
+  Object.defineProperty(primary, "cause", {
+    configurable: true,
+    value: new AggregateError(
+      previousCause === undefined ? [cleanupError] : [previousCause, cleanupError],
+      message,
+    ),
+  });
+  return primary;
+}
