+import { expect, test } from "bun:test";
+import {
+  BrowserHelperInboundProtocolState,
+  parseBrowserHelperInputMessage,
+} from "../src/adapters/chatgpt-web/browser-helper-protocol";
+
+test("browser helper rejects extra Send acknowledgement fields and unknown frame types", () => {
+  expect(() => parseBrowserHelperInputMessage({
+    type: "send_activation_ack",
+    id: "turn_wire_123",
+    stage: "final",
+  })).toThrow("unknown or missing fields");
+  expect(() => parseBrowserHelperInputMessage({
+    type: "submission_rewound",
+    id: "turn_wire_123",
+  })).toThrow("unknown message type");
+});
+
+test("browser helper preserves the default run contract without an absolute turn deadline", () => {
+  const message = parseBrowserHelperInputMessage({
+    type: "run",
+    id: "turn_default_123",
+    config: {
+      appName: "Codex Native",
+      browserHostDescriptorPath: "/durable/launcher.json",
+      autoApproveToolCalls: false,
+    },
+    turn: {
+      traceId: "turn_default_123",
+      modelId: "gpt-5.6-sol",
+      capabilities: { localToolsEnabled: true, solAvailable: true, proAvailable: true },
+    },
+  });
+
+  expect(message.type).toBe("run");
+  if (message.type !== "run") throw new Error("Expected a parsed run message");
+  expect(message.config.turnTimeoutMs).toBeUndefined();
+});
+
+test("browser helper inbound phases reject wrong-turn, duplicate, and out-of-order acknowledgements", () => {
+  const state = new BrowserHelperInboundProtocolState();
+  state.beginTurn("turn_phase_123");
+  expect(() => state.observePreparedSelectedAck("other_turn_123")).toThrow("not active");
+  expect(() => state.observePreparedSelectedAck("turn_phase_123")).toThrow("not pending");
+  state.expectPreparedSelectedAck("turn_phase_123");
+  state.observePreparedSelectedAck("turn_phase_123");
+  expect(() => state.observePreparedSelectedAck("turn_phase_123")).toThrow("duplicate");
+  expect(() => state.observeSendActivationAck("turn_phase_123")).toThrow("not pending");
+  state.expectSendActivationAck("turn_phase_123");
+  state.observeSendActivationAck("turn_phase_123");
+  expect(() => state.observeSendActivationAck("turn_phase_123")).toThrow("not pending");
+  state.endTurn("turn_phase_123");
+  expect(() => state.observeAbort("turn_phase_123")).toThrow("not active");
+});
