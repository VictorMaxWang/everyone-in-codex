+import type { CompiledChatGptWebPrompt } from "./prompt";
+import {
+  parseChatGptHelperSubmissionAuthorization,
+  type ChatGptHelperSubmissionAuthorization,
+} from "./helper-submission-authorization";
+
+export interface BrowserHelperRunMessage {
+  type: "run";
+  id: string;
+  config: {
+    appName: string;
+    browserHostDescriptorPath: string;
+    browserDiagnosticsPath?: string;
+    turnTimeoutMs?: number;
+    autoApproveToolCalls: boolean;
+  };
+  turn: {
+    traceId: string;
+    modelId: string;
+    reasoning?: string;
+    capabilities: ChatGptWebCapabilities;
+    nativeConnector?: boolean;
+    resumeAvailable?: boolean;
+    retainConversation?: boolean;
+    requireRetainedConversation?: boolean;
+    conversationKey?: string;
+    compaction?: boolean;
+    captureLunaCheckpoint?: boolean;
+  };
+}
+
+export interface BrowserHelperVerifyMessage {
+  type: "verify";
+  id: string;
+  config: { appName: string; browserHostDescriptorPath: string };
+}
+
+export interface BrowserHelperInspectMessage extends Omit<BrowserHelperVerifyMessage, "type"> {
+  type: "inspect";
+  detectCapabilities: boolean;
+}
+
+export interface BrowserHelperSmokeMessage extends Omit<BrowserHelperVerifyMessage, "type"> {
+  type: "smoke";
+}
+
+export type BrowserHelperMaintenanceMessage =
+  | BrowserHelperVerifyMessage
+  | BrowserHelperInspectMessage
+  | BrowserHelperSmokeMessage;
+
+export type BrowserHelperInputMessage =
+  | BrowserHelperRunMessage
+  | BrowserHelperMaintenanceMessage
+  | ChatGptHelperSubmissionAuthorization
+  | { type: "prepared_selected_ack"; id: string; prepared: CompiledChatGptWebPrompt }
+  | { type: "send_activation_ack"; id: string }
+  | { type: "abort"; id: string }
+  | { type: "shutdown" };
+
+function record(value: unknown, label: string): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw new Error(`Browser helper ${label} is not an object`);
+  }
+  return value as Record<string, unknown>;
+}
+
+function assertKeys(
+  value: Record<string, unknown>,
+  required: readonly string[],
+  optional: readonly string[] = [],
+): void {
+  const keys = Object.keys(value);
+  const allowed = new Set([...required, ...optional]);
+  if (required.some(key => !Object.hasOwn(value, key)) || keys.some(key => !allowed.has(key))) {
+    throw new Error("Browser helper input frame has unknown or missing fields");
+  }
+}
+
+function turnId(value: unknown): string {
+  if (typeof value !== "string" || !/^[A-Za-z0-9_-]{6,128}$/.test(value)) {
+    throw new Error("Browser helper input turn identity is invalid");
+  }
+  return value;
+}
+
+function stringField(value: unknown, label: string): string {
+  if (typeof value !== "string" || !value.trim()) throw new Error(`Browser helper ${label} is invalid`);
+  return value;
+}
+
+function parseMaintenanceConfig(value: unknown): BrowserHelperVerifyMessage["config"] {
+  const config = record(value, "maintenance config");
+  assertKeys(config, ["appName", "browserHostDescriptorPath"]);
+  return {
+    appName: stringField(config.appName, "app name"),
+    browserHostDescriptorPath: stringField(config.browserHostDescriptorPath, "host descriptor path"),
+  };
+}
+
+function parsePrepared(value: unknown): CompiledChatGptWebPrompt {
+  const prepared = record(value, "prepared prompt");
+  assertKeys(prepared, ["text", "images"], ["multipart", "trimmedCompactionMessages"]);
+  if (typeof prepared.text !== "string" || !Array.isArray(prepared.images)) {
+    throw new Error("Browser helper prepared prompt is invalid");
+  }
+  let multipart: CompiledChatGptWebPrompt["multipart"];
+  if (prepared.multipart !== undefined) {
+    const rawMultipart = record(prepared.multipart, "multipart prompt");
+    assertKeys(rawMultipart, ["parts", "commit"]);
+    if (!Array.isArray(rawMultipart.parts)
+      || (rawMultipart.parts.length !== 2 && rawMultipart.parts.length !== 3)
+      || rawMultipart.parts.some(part => typeof part !== "string")
+      || typeof rawMultipart.commit !== "string") {
+      throw new Error("Browser helper multipart prompt is invalid");
+    }
+    multipart = {
+      parts: rawMultipart.parts as unknown as NonNullable<CompiledChatGptWebPrompt["multipart"]>["parts"],
+      commit: rawMultipart.commit,
+    };
+  }
+  if (prepared.trimmedCompactionMessages !== undefined
+    && (!Number.isInteger(prepared.trimmedCompactionMessages)
+      || (prepared.trimmedCompactionMessages as number) < 0)) {
+    throw new Error("Browser helper compaction trim count is invalid");
+  }
+  return {
+    text: prepared.text,
+    images: prepared.images as CompiledChatGptWebPrompt["images"],
+    ...(multipart ? { multipart } : {}),
+    ...(prepared.trimmedCompactionMessages !== undefined
+      ? { trimmedCompactionMessages: prepared.trimmedCompactionMessages as number }
+      : {}),
+  };
+}
+
+function parseRun(message: Record<string, unknown>): BrowserHelperRunMessage {
+  assertKeys(message, ["type", "id", "config", "turn"]);
+  const id = turnId(message.id);
+  const config = record(message.config, "run config");
+  assertKeys(
+    config,
+    ["appName", "browserHostDescriptorPath", "autoApproveToolCalls"],
+    ["browserDiagnosticsPath", "turnTimeoutMs"],
+  );
+  const turn = record(message.turn, "run turn");
+  assertKeys(
+    turn,
+    ["traceId", "modelId", "capabilities"],
+    [
+      "reasoning", "nativeConnector", "resumeAvailable", "retainConversation",
+      "requireRetainedConversation", "conversationKey", "compaction", "captureLunaCheckpoint",
+    ],
+  );
+  const capabilities = record(turn.capabilities, "capabilities");
+  assertKeys(capabilities, ["localToolsEnabled", "solAvailable", "proAvailable"]);
+  if ([capabilities.localToolsEnabled, capabilities.solAvailable, capabilities.proAvailable]
+    .some(flag => typeof flag !== "boolean")) {
+    throw new Error("Browser helper capabilities are invalid");
+  }
+  if (turn.traceId !== id) throw new Error("Browser helper run changed turn identity");
+  if (config.turnTimeoutMs !== undefined
+    && (typeof config.turnTimeoutMs !== "number" || !Number.isFinite(config.turnTimeoutMs)
+      || config.turnTimeoutMs <= 0)) {
+    throw new Error("Browser helper run config is invalid");
+  }
+  if (typeof config.autoApproveToolCalls !== "boolean") {
+    throw new Error("Browser helper run config is invalid");
+  }
+  if (config.browserDiagnosticsPath !== undefined && typeof config.browserDiagnosticsPath !== "string") {
+    throw new Error("Browser helper diagnostics path is invalid");
+  }
+  for (const key of [
+    "nativeConnector", "resumeAvailable", "retainConversation", "requireRetainedConversation",
+    "compaction", "captureLunaCheckpoint",
+  ] as const) {
+    if (turn[key] !== undefined && typeof turn[key] !== "boolean") {
+      throw new Error(`Browser helper ${key} flag is invalid`);
+    }
+  }
+  if (turn.reasoning !== undefined && typeof turn.reasoning !== "string") {
+    throw new Error("Browser helper reasoning is invalid");
+  }
+  if (turn.conversationKey !== undefined
+    && (typeof turn.conversationKey !== "string" || !/^[a-f0-9]{64}$/.test(turn.conversationKey))) {
+    throw new Error("Browser helper conversation key is invalid");
+  }
+  return {
+    type: "run",
+    id,
+    config: {
+      appName: stringField(config.appName, "app name"),
+      browserHostDescriptorPath: stringField(config.browserHostDescriptorPath, "host descriptor path"),
+      ...(config.browserDiagnosticsPath !== undefined
+        ? { browserDiagnosticsPath: config.browserDiagnosticsPath }
+        : {}),
+      ...(config.turnTimeoutMs !== undefined ? { turnTimeoutMs: config.turnTimeoutMs } : {}),
+      autoApproveToolCalls: config.autoApproveToolCalls,
+    },
+    turn: {
+      traceId: id,
+      modelId: stringField(turn.modelId, "model id"),
+      capabilities: capabilities as unknown as ChatGptWebCapabilities,
+      ...(turn.reasoning !== undefined ? { reasoning: turn.reasoning } : {}),
+      ...(turn.nativeConnector !== undefined ? { nativeConnector: turn.nativeConnector } : {}),
+      ...(turn.resumeAvailable !== undefined ? { resumeAvailable: turn.resumeAvailable } : {}),
+      ...(turn.retainConversation !== undefined ? { retainConversation: turn.retainConversation } : {}),
+      ...(turn.requireRetainedConversation !== undefined
+        ? { requireRetainedConversation: turn.requireRetainedConversation }
+        : {}),
+      ...(turn.conversationKey !== undefined ? { conversationKey: turn.conversationKey } : {}),
+      ...(turn.compaction !== undefined ? { compaction: turn.compaction } : {}),
+      ...(turn.captureLunaCheckpoint !== undefined
+        ? { captureLunaCheckpoint: turn.captureLunaCheckpoint }
+        : {}),
+    },
+  } as BrowserHelperRunMessage;
+}
+
+/** 所有 stdin 帧在进入 helper 状态前完成封闭字段与基础类型校验。 */
+export function parseBrowserHelperInputMessage(value: unknown): BrowserHelperInputMessage {
+  const message = record(value, "input frame");
+  if (message.type === "run") return parseRun(message);
+  if (message.type === "submission_authorized") {
+    return parseChatGptHelperSubmissionAuthorization(message);
+  }
+  if (message.type === "prepared_selected_ack") {
+    assertKeys(message, ["type", "id", "prepared"]);
+    return { type: "prepared_selected_ack", id: turnId(message.id), prepared: parsePrepared(message.prepared) };
+  }
+  if (message.type === "send_activation_ack" || message.type === "abort") {
+    assertKeys(message, ["type", "id"]);
+    return { type: message.type, id: turnId(message.id) };
+  }
+  if (message.type === "shutdown") {
+    assertKeys(message, ["type"]);
+    return { type: "shutdown" };
+  }
+  if (message.type === "verify" || message.type === "smoke") {
+    assertKeys(message, ["type", "id", "config"]);
+    return { type: message.type, id: turnId(message.id), config: parseMaintenanceConfig(message.config) };
+  }
+  if (message.type === "inspect") {
+    assertKeys(message, ["type", "id", "config", "detectCapabilities"]);
+    if (typeof message.detectCapabilities !== "boolean") {
+      throw new Error("Browser helper capability detection flag is invalid");
+    }
+    return {
+      type: "inspect",
+      id: turnId(message.id),
+      config: parseMaintenanceConfig(message.config),
+      detectCapabilities: message.detectCapabilities,
+    };
+  }
+  throw new Error("Browser helper input frame has an unknown message type");
+}
+
+interface InboundTurnPhase {
+  preparedSelectionPending: boolean;
+  preparedAcknowledged: boolean;
+  sendActivationPending: boolean;
+}
+
+/** helper stdin 的 turn phase 独立于浏览器 DOM；错误 turn、重复或乱序 ACK 一律不能落到运行逻辑。 */
+export class BrowserHelperInboundProtocolState {
+  private readonly turns = new Map<string, InboundTurnPhase>();
+  private readonly operations = new Set<string>();
+
+  beginTurn(id: string): void {
+    turnId(id);
+    if (this.turns.has(id)) throw new Error(`Browser helper turn ${id} is duplicate`);
+    this.turns.set(id, {
+      preparedSelectionPending: false,
+      preparedAcknowledged: false,
+      sendActivationPending: false,
+    });
+  }
+
+  expectPreparedSelectedAck(id: string): void {
+    const phase = this.requireTurn(id);
+    if (phase.preparedSelectionPending || phase.preparedAcknowledged) {
+      throw new Error("Browser helper prompt acknowledgement phase is invalid");
+    }
+    phase.preparedSelectionPending = true;
+  }
+
+  observePreparedSelectedAck(id: string): void {
+    const phase = this.requireTurn(id);
+    if (phase.preparedAcknowledged) throw new Error("Browser helper prompt acknowledgement is duplicate");
+    if (!phase.preparedSelectionPending) {
+      throw new Error("Browser helper prompt acknowledgement is not pending");
+    }
+    phase.preparedSelectionPending = false;
+    phase.preparedAcknowledged = true;
+  }
+
+  assertAuthorizedTurn(id: string): void {
+    const phase = this.requireTurn(id);
+    if (!phase.preparedAcknowledged) {
+      throw new Error("Browser helper submission authorization preceded prompt acknowledgement");
+    }
+  }
+
+  expectSendActivationAck(id: string): void {
+    const phase = this.requireTurn(id);
+    if (!phase.preparedAcknowledged || phase.sendActivationPending) {
+      throw new Error("Browser helper Send activation phase is invalid");
+    }
+    phase.sendActivationPending = true;
+  }
+
+  observeSendActivationAck(id: string): void {
+    const phase = this.requireTurn(id);
+    if (!phase.sendActivationPending) throw new Error("Browser helper Send acknowledgement is not pending");
+    phase.sendActivationPending = false;
+  }
+
+  observeAbort(id: string): void {
+    if (!this.turns.has(id) && !this.operations.has(id)) {
+      throw new Error(`Browser helper turn ${id} is not active`);
+    }
+  }
+
+  endTurn(id: string): void {
+    this.turns.delete(id);
+  }
+
+  beginOperation(id: string): void {
+    turnId(id);
+    if (this.operations.has(id) || this.turns.has(id)) {
+      throw new Error(`Browser helper operation ${id} is duplicate`);
+    }
+    this.operations.add(id);
+  }
+
+  endOperation(id: string): void {
+    this.operations.delete(id);
+  }
+
+  private requireTurn(id: string): InboundTurnPhase {
+    const phase = this.turns.get(id);
+    if (!phase) throw new Error(`Browser helper turn ${id} is not active`);
+    return phase;
+  }
+}
