@@ -0,0 +1,57 @@
+import { expect, test } from "bun:test";
+import { ChatGptHelperTurnProtocolState } from "../src/adapters/chatgpt-web/launcher-helper-client";
+import { parseChatGptHelperSubmissionAttempt } from "../src/adapters/chatgpt-web/helper-submission-authorization";
+
+test("parent protocol composes resume selection, staged authorization, Send activation, and submission evidence", () => {
+  const state = new ChatGptHelperTurnProtocolState("turn_resume_123");
+  state.observePreparedSelected(true);
+  state.acknowledgePrepared("multipart-3");
+
+  const stageOne = parseChatGptHelperSubmissionAttempt({
+    type: "submission_attempt",
+    id: "turn_resume_123",
+    transport: "multipart-3",
+    submission: "stage-1",
+  });
+  state.observeAttempt(stageOne);
+  expect(() => state.observeAttempt(stageOne)).toThrow("duplicate or out of order");
+  state.observeStageAccepted("multipart-3", 1);
+  expect(() => state.observeStageAccepted("multipart-3", 1)).toThrow("duplicate stage 1 acceptance");
+  state.observeStageAcknowledged("multipart-3", 1);
+
+  state.observeAttempt(parseChatGptHelperSubmissionAttempt({
+    type: "submission_attempt",
+    id: "turn_resume_123",
+    transport: "multipart-3",
+    submission: "stage-2",
+  }));
+  state.observeStageAccepted("multipart-3", 2);
+  state.observeStageAcknowledged("multipart-3", 2);
+  state.observeAttempt(parseChatGptHelperSubmissionAttempt({
+    type: "submission_attempt",
+    id: "turn_resume_123",
+    transport: "multipart-3",
+    submission: "final",
+  }));
+  state.observeSendActivated();
+  state.observeSubmitted();
+
+  expect(state.isComplete()).toBeTrue();
+  expect(state.hasIrreversibleSubmission()).toBeTrue();
+  expect(() => state.observePreparedSelected(false)).toThrow("duplicate prompt selection");
+  expect(() => state.observeSubmitted()).toThrow("duplicate final acceptance");
+});
+
+test("parent protocol fails closed when final authorization precedes the required stage ACK", () => {
+  const state = new ChatGptHelperTurnProtocolState("turn_order_123");
+  state.observePreparedSelected(false);
+  state.acknowledgePrepared("multipart-2");
+
+  expect(() => state.observeAttempt(parseChatGptHelperSubmissionAttempt({
+    type: "submission_attempt",
+    id: "turn_order_123",
+    transport: "multipart-2",
+    submission: "final",
+  }))).toThrow("stage 1 acknowledgement");
+  expect(state.hasIrreversibleSubmission()).toBeFalse();
+});
