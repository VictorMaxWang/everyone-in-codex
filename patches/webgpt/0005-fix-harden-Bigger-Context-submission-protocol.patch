+export interface ChatGptRateLimitDialogObserver {
+  currentGeneration(): number;
+  waitForDismissal(afterGeneration: number, signal: AbortSignal): Promise<void>;
+  assertHealthy(): void;
+}
+
+interface ChatGptRateLimitDismissalWaiter {
+  afterGeneration: number;
+  signal: AbortSignal;
+  resolve(): void;
+  reject(error: unknown): void;
+  onAbort(): void;
+}
+
+/** generation 只在弹窗确认隐藏后递增，让 effort/send/ACK/stream 原地恢复。 */
+export class ChatGptRateLimitDialogController implements ChatGptRateLimitDialogObserver {
+  private readonly stopController = new AbortController();
+  private readonly task: Promise<void>;
+  private readonly waiters = new Set<ChatGptRateLimitDismissalWaiter>();
+  private generation = 0;
+  private monitorFailure: unknown;
+
+  constructor(
+    page: Page,
+    parentSignal?: AbortSignal,
+    private readonly onDismissed?: (generation: number) => void,
+  ) {
+    const signal = parentSignal
+      ? AbortSignal.any([this.stopController.signal, parentSignal])
+      : this.stopController.signal;
+    this.task = monitorChatGptRateLimitDialogs(page, signal, () => {
+      this.generation += 1;
+      this.onDismissed?.(this.generation);
+      this.releaseWaiters();
+    }).catch(error => {
+      this.monitorFailure = error;
+      this.releaseWaiters(error);
+    });
+  }
+
+  currentGeneration(): number {
+    return this.generation;
+  }
+
+  assertHealthy(): void {
+    if (this.monitorFailure !== undefined) throw this.monitorFailure;
+  }
+
+  async waitForDismissal(afterGeneration: number, signal: AbortSignal): Promise<void> {
+    this.assertHealthy();
+    if (this.generation > afterGeneration) return;
+    if (signal.aborted) throw new DOMException("ChatGPT rate-limit wait aborted", "AbortError");
+    await new Promise<void>((resolve, reject) => {
+      const waiter: ChatGptRateLimitDismissalWaiter = {
+        afterGeneration,
+        signal,
+        resolve,
+        reject,
+        onAbort: () => {
+          this.waiters.delete(waiter);
+          reject(new DOMException("ChatGPT rate-limit wait aborted", "AbortError"));
+        },
+      };
+      signal.addEventListener("abort", waiter.onAbort, { once: true });
+      this.waiters.add(waiter);
+      // 登记后复查一次，封住 generation 检查与 waiter 入队之间的竞态。
+      this.releaseWaiters();
+    });
+  }
+
+  async stop(assertHealthy = true): Promise<void> {
+    this.stopController.abort();
+    await this.task;
+    if (assertHealthy) this.assertHealthy();
+  }
+
+  private releaseWaiters(error?: unknown): void {
+    for (const waiter of [...this.waiters]) {
+      if (error === undefined && this.generation <= waiter.afterGeneration) continue;
+      this.waiters.delete(waiter);
+      waiter.signal.removeEventListener("abort", waiter.onAbort);
+      if (error === undefined) waiter.resolve();
+      else waiter.reject(error);
+    }
+  }
+}
