+import { expect, test } from "bun:test";
+import {
+  ChatGptHelperSubmissionAuthorizationGate,
+  parseChatGptHelperSubmissionAttempt,
+} from "../src/adapters/chatgpt-web/helper-submission-authorization";
+
+test("helper submission authorization releases only the exact pending transport boundary", async () => {
+  const attempts: unknown[] = [];
+  const gate = new ChatGptHelperSubmissionAuthorizationGate(attempt => attempts.push(attempt), 1_000);
+  let released = false;
+  const pending = gate.request({
+    type: "submission_attempt",
+    id: "turn_auth_123",
+    transport: "multipart-3",
+    submission: "stage-1",
+  }).then(() => { released = true; });
+
+  await Promise.resolve();
+  expect(released).toBeFalse();
+  expect(attempts).toEqual([{
+    type: "submission_attempt",
+    id: "turn_auth_123",
+    transport: "multipart-3",
+    submission: "stage-1",
+  }]);
+  expect(() => gate.authorize({
+    type: "submission_authorized",
+    id: "turn_auth_123",
+    transport: "multipart-3",
+    submission: "final",
+  })).toThrow("does not match");
+  expect(released).toBeFalse();
+
+  gate.authorize({
+    type: "submission_authorized",
+    id: "turn_auth_123",
+    transport: "multipart-3",
+    submission: "stage-1",
+  });
+  await pending;
+  expect(released).toBeTrue();
+  expect(() => gate.authorize({
+    type: "submission_authorized",
+    id: "turn_auth_123",
+    transport: "multipart-3",
+    submission: "stage-1",
+  })).toThrow("no pending attempt");
+
+  expect(() => parseChatGptHelperSubmissionAttempt({
+    type: "submission_attempt",
+    id: "turn_auth_123",
+    transport: "inline",
+    submission: "final",
+    prompt: "must stay private",
+  })).toThrow("unknown or missing fields");
+});
