diff --git a/src/adapters/chatgpt-web/helper-submission-authorization.ts b/src/adapters/chatgpt-web/helper-submission-authorization.ts
new file mode 100644
index 0000000..190c616
--- /dev/null
+++ b/src/adapters/chatgpt-web/helper-submission-authorization.ts
@@ -0,0 +1,154 @@
+export type ChatGptHelperSubmissionTransport = "inline" | "multipart-2" | "multipart-3";
+export type ChatGptHelperSubmissionIdentity = "stage-1" | "stage-2" | "final";
+
+export interface ChatGptHelperSubmissionAttempt {
+  type: "submission_attempt";
+  id: string;
+  transport: ChatGptHelperSubmissionTransport;
+  submission: ChatGptHelperSubmissionIdentity;
+}
+
+export interface ChatGptHelperSubmissionAuthorization {
+  type: "submission_authorized";
+  id: string;
+  transport: ChatGptHelperSubmissionTransport;
+  submission: ChatGptHelperSubmissionIdentity;
+}
+
+function assertExactKeys(value: Record<string, unknown>, expected: readonly string[]): void {
+  const keys = Object.keys(value).sort();
+  const allowed = [...expected].sort();
+  if (keys.length !== allowed.length || keys.some((key, index) => key !== allowed[index])) {
+    throw new Error("Launcher browser submission handshake has unknown or missing fields");
+  }
+}
+
+function parseTransport(value: unknown): ChatGptHelperSubmissionTransport {
+  if (value === "inline" || value === "multipart-2" || value === "multipart-3") return value;
+  throw new Error("Launcher browser submission handshake transport is invalid");
+}
+
+function parseIdentity(value: unknown): ChatGptHelperSubmissionIdentity {
+  if (value === "stage-1" || value === "stage-2" || value === "final") return value;
+  throw new Error("Launcher browser submission handshake identity is invalid");
+}
+
+function parseFrame(
+  value: unknown,
+  type: ChatGptHelperSubmissionAttempt["type"] | ChatGptHelperSubmissionAuthorization["type"],
+): Omit<ChatGptHelperSubmissionAttempt, "type"> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw new Error("Launcher browser submission handshake is not an object");
+  }
+  const frame = value as Record<string, unknown>;
+  assertExactKeys(frame, ["type", "id", "transport", "submission"]);
+  if (frame.type !== type) throw new Error("Launcher browser submission handshake type is invalid");
+  if (typeof frame.id !== "string" || !/^[A-Za-z0-9_-]{6,128}$/.test(frame.id)) {
+    throw new Error("Launcher browser submission handshake turn identity is invalid");
+  }
+  return {
+    id: frame.id,
+    transport: parseTransport(frame.transport),
+    submission: parseIdentity(frame.submission),
+  };
+}
+
+/** 父进程只接收 turn、transport 与 stage/final 身份，额外 prompt/hash/DOM 字段一律拒绝。 */
+export function parseChatGptHelperSubmissionAttempt(value: unknown): ChatGptHelperSubmissionAttempt {
+  return { type: "submission_attempt", ...parseFrame(value, "submission_attempt") };
+}
+
+/** helper 以同一封闭字段集合校验授权，防止错 turn 或错 stage 解锁真实 Enter。 */
+export function parseChatGptHelperSubmissionAuthorization(
+  value: unknown,
+): ChatGptHelperSubmissionAuthorization {
+  return { type: "submission_authorized", ...parseFrame(value, "submission_authorized") };
+}
+
+interface PendingAuthorization {
+  attempt: ChatGptHelperSubmissionAttempt;
+  resolve(): void;
+  reject(error: Error): void;
+  timer: ReturnType<typeof setTimeout>;
+  signal?: AbortSignal;
+  abortListener?: () => void;
+}
+
+/**
+ * helper 在发 attempt 前先登记 waiter；只有完全匹配的父进程授权才能跨过不可逆派发边界。
+ * timeout、abort 与 shutdown 都会回收 waiter，避免遗留授权误解锁后续提交。
+ */
+export class ChatGptHelperSubmissionAuthorizationGate {
+  private readonly pending = new Map<string, PendingAuthorization>();
+
+  constructor(
+    private readonly emitAttempt: (attempt: ChatGptHelperSubmissionAttempt) => void,
+    private readonly timeoutMs = 30_000,
+  ) {
+    if (!Number.isInteger(timeoutMs) || timeoutMs < 1) {
+      throw new Error("Launcher browser submission authorization timeout is invalid");
+    }
+  }
+
+  request(value: ChatGptHelperSubmissionAttempt, signal?: AbortSignal): Promise<void> {
+    const attempt = parseChatGptHelperSubmissionAttempt(value);
+    if (this.pending.has(attempt.id)) {
+      throw new Error(`Launcher browser submission authorization is already pending for ${attempt.id}`);
+    }
+    if (signal?.aborted) {
+      return Promise.reject(new DOMException("Launcher browser submission authorization aborted", "AbortError"));
+    }
+    return new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.rejectTurn(attempt.id, new Error("Launcher browser submission authorization timed out"));
+      }, this.timeoutMs);
+      const pending: PendingAuthorization = { attempt, resolve, reject, timer, signal };
+      if (signal) {
+        pending.abortListener = () => this.rejectTurn(
+          attempt.id,
+          new DOMException("Launcher browser submission authorization aborted", "AbortError"),
+        );
+        signal.addEventListener("abort", pending.abortListener, { once: true });
+      }
+      this.pending.set(attempt.id, pending);
+      try {
+        this.emitAttempt(attempt);
+      } catch (error) {
+        this.rejectTurn(attempt.id, error instanceof Error ? error : new Error(String(error)));
+      }
+    });
+  }
+
+  authorize(value: unknown): void {
+    const authorization = parseChatGptHelperSubmissionAuthorization(value);
+    const pending = this.pending.get(authorization.id);
+    if (!pending) throw new Error("Launcher browser submission authorization has no pending attempt");
+    if (authorization.transport !== pending.attempt.transport
+      || authorization.submission !== pending.attempt.submission) {
+      throw new Error("Launcher browser submission authorization does not match its pending attempt");
+    }
+    this.cleanup(pending);
+    this.pending.delete(authorization.id);
+    pending.resolve();
+  }
+
+  rejectTurn(id: string, error: Error): boolean {
+    const pending = this.pending.get(id);
+    if (!pending) return false;
+    this.cleanup(pending);
+    this.pending.delete(id);
+    pending.reject(error);
+    return true;
+  }
+
+  rejectAll(error: Error): void {
+    for (const id of [...this.pending.keys()]) this.rejectTurn(id, error);
+  }
+
+  private cleanup(pending: PendingAuthorization): void {
+    clearTimeout(pending.timer);
+    if (pending.signal && pending.abortListener) {
+      pending.signal.removeEventListener("abort", pending.abortListener);
+    }
+  }
+}
