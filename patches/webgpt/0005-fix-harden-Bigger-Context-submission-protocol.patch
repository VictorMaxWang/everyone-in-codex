diff --git a/tests/browser-submission-state.test.ts b/tests/browser-submission-state.test.ts
new file mode 100644
index 0000000..f3bac10
--- /dev/null
+++ b/tests/browser-submission-state.test.ts
@@ -0,0 +1,133 @@
+import { expect, test } from "bun:test";
+import type { Page } from "playwright-core";
+import {
+  ChatGptMultipartSubmissionState,
+  executeChatGptFinalSubmission,
+  executeChatGptMultipartStages,
+  protectChatGptIrreversibleSubmissionFailure,
+  throwIfChatGptRateLimitDialog,
+} from "../src/adapters/chatgpt-web/browser-worker";
+
+async function dismissCooldown(boundary: string, transitions: string[]): Promise<void> {
+  let visible = true;
+  const button = {
+    last: () => button,
+    isVisible: async () => visible,
+    press: async () => { visible = false; },
+  };
+  const dialog = {
+    filter: () => dialog,
+    last: () => dialog,
+    isVisible: async () => visible,
+    waitFor: async ({ state }: { state: string }) => {
+      if (state === "hidden" && visible) throw new Error("dialog stayed visible");
+    },
+    getByRole: () => button,
+  };
+  await throwIfChatGptRateLimitDialog({ locator: () => dialog } as unknown as Page);
+  transitions.push(`cooldown-${boundary}`);
+}
+
+test("a three-part browser transaction resumes in place without repeating an accepted submission", async () => {
+  const state = new ChatGptMultipartSubmissionState(2);
+  const sends = [0, 0, 0];
+  const transitions: string[] = [];
+
+  await executeChatGptMultipartStages(state, 2, {
+    prepareStage: async stageIndex => {
+      await dismissCooldown(stageIndex === 1 ? "stage-1-send" : "stage-2-effort", transitions);
+      transitions.push(`prepared-${stageIndex}`);
+      return { stageIndex };
+    },
+    submitStage: async (stageIndex, _context, markAttempted) => {
+      markAttempted();
+      sends[stageIndex - 1] += 1;
+      transitions.push(`accepted-${stageIndex}`);
+      return `stage-${stageIndex}`;
+    },
+    onStageAccepted: async stageIndex => {
+      transitions.push(`recorded-${stageIndex}`);
+      await dismissCooldown(`stage-${stageIndex}-accepted`, transitions);
+    },
+    waitForStageAcknowledgement: async stageIndex => {
+      // cooldown 消失只唤醒当前 ACK wait，不重新进入 submitStage。
+      await dismissCooldown(`stage-${stageIndex}-ack`, transitions);
+      transitions.push(`ack-visible-${stageIndex}`);
+    },
+    onStageAcknowledged: stageIndex => { transitions.push(`acknowledged-${stageIndex}`); },
+  });
+
+  let compactionAttempts = 0;
+  while (compactionAttempts < 2) {
+    compactionAttempts += 1;
+    if (compactionAttempts === 1) continue;
+    await dismissCooldown("compaction-final-ready", transitions);
+  }
+
+  await executeChatGptFinalSubmission(state, {
+    submit: async markAttempted => {
+      await dismissCooldown("final-send", transitions);
+      markAttempted();
+      sends[2] += 1;
+      return "final";
+    },
+    onAccepted: async () => {
+      transitions.push("final-accepted");
+      await dismissCooldown("final-response", transitions);
+    },
+  });
+
+  expect(sends).toEqual([1, 1, 1]);
+  expect(compactionAttempts).toBe(2);
+  expect(transitions).toEqual([
+    "cooldown-stage-1-send", "prepared-1", "accepted-1", "recorded-1",
+    "cooldown-stage-1-accepted", "cooldown-stage-1-ack", "ack-visible-1", "acknowledged-1",
+    "cooldown-stage-2-effort", "prepared-2", "accepted-2", "recorded-2",
+    "cooldown-stage-2-accepted", "cooldown-stage-2-ack", "ack-visible-2", "acknowledged-2",
+    "cooldown-compaction-final-ready", "cooldown-final-send", "final-accepted",
+    "cooldown-final-response",
+  ]);
+  await expect(executeChatGptFinalSubmission(state, {
+    submit: async () => "duplicate",
+    onAccepted() {},
+  })).rejects.toThrow("already accepted");
+  expect(sends).toEqual([1, 1, 1]);
+});
+
+test("a missing stage acknowledgement blocks every later stage and final commit", async () => {
+  const state = new ChatGptMultipartSubmissionState(2);
+  const sends = [0, 0, 0];
+
+  await expect(executeChatGptMultipartStages(state, 2, {
+    prepareStage: async stageIndex => stageIndex,
+    submitStage: async (stageIndex, _context, markAttempted) => {
+      markAttempted();
+      sends[stageIndex - 1] += 1;
+      return stageIndex;
+    },
+    onStageAccepted() {},
+    waitForStageAcknowledgement: async () => { throw new Error("stage ACK timed out"); },
+    onStageAcknowledged() {},
+  })).rejects.toThrow("stage ACK timed out");
+
+  expect(sends).toEqual([1, 0, 0]);
+  await expect(executeChatGptFinalSubmission(state, {
+    submit: async markAttempted => { markAttempted(); sends[2] += 1; return "final"; },
+    onAccepted() {},
+  })).rejects.toThrow("every multipart stage acknowledgement");
+  expect(sends).toEqual([1, 0, 0]);
+});
+
+test("an irreversible stage failure is normalized to a non-retryable ambiguity", () => {
+  const state = new ChatGptMultipartSubmissionState(1);
+  state.markStageAttempted(1);
+
+  expect(protectChatGptIrreversibleSubmissionFailure(
+    state,
+    new Error("helper pipe closed after authorization"),
+  )).toMatchObject({
+    status: 502,
+    code: "multipart_submission_ambiguous",
+    retryable: false,
+  });
+});
