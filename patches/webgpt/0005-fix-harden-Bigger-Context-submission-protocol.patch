+/**
+ * 浏览器本地提交状态只允许 accept -> exact ACK -> next 的单向跃迁。
+ * cooldown 只会唤醒当前等待，因此不能清除 attempt/accepted 标记或重新派发同一段。
+ */
+export class ChatGptMultipartSubmissionState {
+  private readonly attemptedStages = new Set<number>();
+  private readonly acceptedStages = new Set<number>();
+  private readonly acknowledgedStages = new Set<number>();
+  private finalAttempted = false;
+  private finalAccepted = false;
+
+  constructor(private readonly stageCount: number) {
+    if (!Number.isInteger(stageCount) || stageCount < 0 || stageCount > 2) {
+      throw new Error("ChatGPT multipart stage count is invalid");
+    }
+  }
+
+  assertStageCanSubmit(stageIndex: number): void {
+    this.assertStageIndex(stageIndex);
+    if (this.finalAccepted) throw new Error("ChatGPT final submission was already accepted");
+    if (this.acceptedStages.has(stageIndex)) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} was already accepted`);
+    }
+    if (this.attemptedStages.has(stageIndex)) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} was already attempted`);
+    }
+    if (stageIndex > 1 && !this.acknowledgedStages.has(stageIndex - 1)) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} requires stage ${stageIndex - 1} acknowledgement`);
+    }
+    if (stageIndex !== this.acknowledgedStages.size + 1) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} is out of order`);
+    }
+  }
+
+  markStageAttempted(stageIndex: number): void {
+    this.assertStageCanSubmit(stageIndex);
+    this.attemptedStages.add(stageIndex);
+  }
+
+  markStageAccepted(stageIndex: number): void {
+    this.assertStageIndex(stageIndex);
+    if (!this.attemptedStages.has(stageIndex)) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} acceptance preceded its submission attempt`);
+    }
+    if (this.acceptedStages.has(stageIndex)) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} was already accepted`);
+    }
+    this.acceptedStages.add(stageIndex);
+  }
+
+  markStageAcknowledged(stageIndex: number): void {
+    this.assertStageIndex(stageIndex);
+    if (!this.acceptedStages.has(stageIndex)) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} was not accepted`);
+    }
+    if (this.acknowledgedStages.has(stageIndex)) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} was already acknowledged`);
+    }
+    if (stageIndex !== this.acknowledgedStages.size + 1) {
+      throw new Error(`ChatGPT multipart stage ${stageIndex} acknowledgement is out of order`);
+    }
+    this.acknowledgedStages.add(stageIndex);
+  }
+
+  assertFinalCanSubmit(): void {
+    if (this.finalAccepted) throw new Error("ChatGPT final submission was already accepted");
+    if (this.finalAttempted) throw new Error("ChatGPT final submission was already attempted");
+    if (this.acknowledgedStages.size !== this.stageCount) {
+      throw new Error("ChatGPT final submission requires every multipart stage acknowledgement");
+    }
+  }
+
+  markFinalAttempted(): void {
+    this.assertFinalCanSubmit();
+    this.finalAttempted = true;
+  }
+
+  markFinalAccepted(): void {
+    if (!this.finalAttempted) throw new Error("ChatGPT final acceptance preceded its submission attempt");
+    if (this.finalAccepted) throw new Error("ChatGPT final submission was already accepted");
+    if (this.acknowledgedStages.size !== this.stageCount) {
+      throw new Error("ChatGPT final submission requires every multipart stage acknowledgement");
+    }
+    this.finalAccepted = true;
+  }
+
+  hasIrreversibleSubmission(): boolean {
+    return this.attemptedStages.size > 0 || this.finalAttempted;
+  }
+
+  hasUnconfirmedSubmissionAttempt(): boolean {
+    return [...this.attemptedStages].some(stage => !this.acceptedStages.has(stage))
+      || (this.finalAttempted && !this.finalAccepted);
+  }
+
+  private assertStageIndex(stageIndex: number): void {
+    if (!Number.isInteger(stageIndex) || stageIndex < 1 || stageIndex > this.stageCount) {
+      throw new Error(`ChatGPT multipart stage index ${stageIndex} is invalid`);
+    }
+  }
+}
+
+/** 将每段不可逆跃迁固定在真实 submit 与 ACK 两侧，调用方只能注入浏览器操作。 */
+export async function executeChatGptMultipartStages<Context, Evidence>(
+  state: ChatGptMultipartSubmissionState,
+  stageCount: number,
+  operations: {
+    prepareStage(stageIndex: number): Promise<Context>;
+    submitStage(stageIndex: number, context: Context, markAttempted: () => void): Promise<Evidence>;
+    onStageAccepted(stageIndex: number, evidence: Evidence): Promise<void> | void;
+    waitForStageAcknowledgement(stageIndex: number, context: Context, evidence: Evidence): Promise<void>;
+    onStageAcknowledged(stageIndex: number): Promise<void> | void;
+  },
+): Promise<void> {
+  if (!Number.isInteger(stageCount) || stageCount < 1 || stageCount > 2) {
+    throw new Error("ChatGPT multipart execution stage count is invalid");
+  }
+  for (let stageIndex = 1; stageIndex <= stageCount; stageIndex += 1) {
+    state.assertStageCanSubmit(stageIndex);
+    const context = await operations.prepareStage(stageIndex);
+    const evidence = await operations.submitStage(
+      stageIndex,
+      context,
+      () => state.markStageAttempted(stageIndex),
+    );
+    state.markStageAccepted(stageIndex);
+    await operations.onStageAccepted(stageIndex, evidence);
+    await operations.waitForStageAcknowledgement(stageIndex, context, evidence);
+    state.markStageAcknowledged(stageIndex);
+    await operations.onStageAcknowledged(stageIndex);
+  }
+}
+
+/** 最终 commit 沿用同一屏障，accepted 回调始终发生在后续 response wait 之前。 */
+export async function executeChatGptFinalSubmission<Evidence>(
+  state: ChatGptMultipartSubmissionState,
+  operations: {
+    submit(markAttempted: () => void): Promise<Evidence>;
+    onAccepted(evidence: Evidence): Promise<void> | void;
+  },
+): Promise<Evidence> {
+  state.assertFinalCanSubmit();
+  const evidence = await operations.submit(() => state.markFinalAttempted());
+  state.markFinalAccepted();
+  await operations.onAccepted(evidence);
+  return evidence;
+}
+
+export function protectChatGptIrreversibleSubmissionFailure(
+  state: ChatGptMultipartSubmissionState,
+  error: unknown,
+): unknown {
+  if (!state.hasIrreversibleSubmission()) return error;
+  if (!state.hasUnconfirmedSubmissionAttempt()
+    && error instanceof ChatGptWebAdapterError
+    && !error.retryable) return error;
+  const detail = error instanceof Error ? error.message : String(error);
+  return new ChatGptWebAdapterError(
+    `ChatGPT armed or accepted part of this browser submission before the remaining response became ambiguous (${detail}). The turn will not be retried automatically.`,
+    {
+      status: 502,
+      errorType: "server_error",
+      code: "multipart_submission_ambiguous",
+      retryable: false,
+    },
+  );
+}
