+test("advisor ZIP output sink waits for backpressure and fails closed above its streamed cap", async () => {
+  const module = await advisorModule<Record<string, unknown>>(
+    "../src/adapters/chatgpt-web/advisor/files",
+  );
+  const createSink = (module as unknown as {
+    createAdvisorZipOutputSink?: (output: Writable, maxBytes: number) => {
+      enqueue(chunk: Uint8Array, final: boolean): void;
+      flush(): Promise<void>;
+    };
+  } | undefined)?.createAdvisorZipOutputSink;
+  expect(typeof createSink).toBe("function");
+  if (!createSink) return;
+
+  const events: string[] = [];
+  const slow = new Writable({
+    highWaterMark: 1,
+    write(chunk, _encoding, callback) {
+      events.push(`write:${chunk.length}`);
+      setTimeout(() => {
+        events.push("released");
+        callback();
+      }, 5);
+    },
+  });
+  const sink = createSink(slow, 16);
+  sink.enqueue(new Uint8Array([1, 2]), false);
+  await sink.flush();
+  expect(events).toEqual(["write:2", "released"]);
+
+  sink.enqueue(new Uint8Array(32), false);
+  await expect(sink.flush()).rejects.toThrow(/512 MB|output limit|streamed/i);
+  expect(slow.destroyed).toBeTrue();
+});
