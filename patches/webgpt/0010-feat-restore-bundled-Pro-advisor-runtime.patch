+test("advisor manager behaves like a five-slot follow-up-capable subagent pool", async () => {
+  const module = await advisorModule<typeof import("../src/adapters/chatgpt-web/advisor/job-manager")>(
+    "../src/adapters/chatgpt-web/advisor/job-manager",
+  );
+  expect(module).toBeDefined();
+  if (!module) return;
+
+  const pending = new Map<string, { resolve(value: { text: string; artifacts: Array<{ name: string; path: string; size: number }> }): void }>();
+  const releases: string[] = [];
+  const calls: Array<{ agentId: string; prompt: string; continuation?: boolean }> = [];
+  const runtime = {
+    run: (request: {
+      agentId: string;
+      prompt: string;
+      signal: AbortSignal;
+      continuation?: boolean;
+      onQueuePosition(position: number): void;
+    }) => {
+      calls.push({ agentId: request.agentId, prompt: request.prompt, continuation: request.continuation });
+      request.onQueuePosition(2);
+      return new Promise<{ text: string; artifacts: Array<{ name: string; path: string; size: number }> }>(resolve => {
+        pending.set(request.agentId, { resolve });
+        request.signal.addEventListener("abort", () => resolve({ text: "", artifacts: [] }), { once: true });
+      });
+    },
+    release: async (agentId: string) => { releases.push(agentId); return true; },
+  };
+  const manager = new module.AdvisorJobManager({ runtime, maxAgents: 5, idleTimeoutMs: 30 * 60_000 });
+  const first = manager.spawn({ prompt: "First task", roots: ["C:\\workspace"], outputDirectory: "C:\\workspace", attachments: [] });
+  expect(first.status).toBe("queued");
+  expect(first.queuePosition).toBe(2);
+  const firstCursor = first.cursor;
+  await expect(manager.wait([{ agentId: first.agentId, afterCursor: 0 }], 600 * 60_000))
+    .resolves.toMatchObject({ timedOut: false });
+
+  for (let index = 2; index <= 5; index += 1) {
+    manager.spawn({ prompt: `Task ${index}`, roots: ["C:\\workspace"], outputDirectory: "C:\\workspace", attachments: [] });
+  }
+  expect(() => manager.spawn({
+    prompt: "Sixth task", roots: ["C:\\workspace"], outputDirectory: "C:\\workspace", attachments: [],
+  })).toThrow("at most 5 Pro advisors");
+
+  pending.get(first.agentId)!.resolve({ text: "First answer", artifacts: [] });
+  const completed = await manager.wait([{ agentId: first.agentId, afterCursor: firstCursor }], 1_000);
+  expect(completed.agents[0]).toMatchObject({ agentId: first.agentId, status: "idle" });
+  expect(JSON.stringify(completed.agents[0])).toContain("First answer");
+
+  const followup = manager.send(first.agentId, { prompt: "Follow up", attachments: [] });
+  expect(followup.agentId).toBe(first.agentId);
+  expect(calls.at(-1)).toEqual({ agentId: first.agentId, prompt: "Follow up", continuation: true });
+  await manager.cancel(first.agentId);
+  expect(manager.list().find(job => job.agentId === first.agentId)?.status).toBe("idle");
+  await manager.close(first.agentId);
+  expect(releases).toContain(first.agentId);
+  expect(manager.list().some(job => job.agentId === first.agentId)).toBeFalse();
+});
