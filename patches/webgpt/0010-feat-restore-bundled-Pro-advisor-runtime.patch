+async function activeReleaseFailureManager() {
+  const { AdvisorJobManager } = await import("../src/adapters/chatgpt-web/advisor/job-manager");
+  const { ChatGptProAdvisorRuntime } = await import("../src/adapters/chatgpt-web/advisor/runtime");
+  const counts = { registered: 0, started: 0, aborted: 0, revoked: 0, released: 0, workerClosed: 0 };
+  const broker = {
+    assertCompatible: async () => {},
+    register: async () => { counts.registered += 1; return "turn_abcdefghijklmnopqrstuvwxyz123456"; },
+    updateEnvironment() {},
+    nextToolBatch: async (_token: string, signal?: AbortSignal) => await new Promise<never>((_resolve, reject) => {
+      signal?.addEventListener("abort", () => reject(new DOMException("aborted", "AbortError")), { once: true });
+    }),
+    completeTool: async () => {},
+    revoke: async () => { counts.revoked += 1; },
+  };
+  const worker = {
+    run: async (turn: { abortSignal?: AbortSignal }) => {
+      if (!turn.abortSignal) throw new Error("Advisor MCP test requires an abort signal");
+      counts.started += 1;
+      return await new Promise<never>((_resolve, reject) => {
+        turn.abortSignal!.addEventListener("abort", () => {
+          counts.aborted += 1;
+          reject(new DOMException("aborted", "AbortError"));
+        }, { once: true });
+      });
+    },
+    close: async () => { counts.workerClosed += 1; },
+  };
+  const manager = new AdvisorJobManager({
+    runtime: new ChatGptProAdvisorRuntime({
+      broker,
+      worker,
+      releaseRetainedConversation: async () => {
+        counts.released += 1;
+        throw new Error("launcher release failed");
+      },
+    }),
+    idleTimeoutMs: 60_000,
+  });
+  manager.spawn({ prompt: "Wait for shutdown", roots: [process.cwd()], outputDirectory: process.cwd(), attachments: [] });
