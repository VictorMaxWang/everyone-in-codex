+++ b/tests/advisor-artifacts.test.ts
@@ -0,0 +1,151 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Readable } from "node:stream";
+import { ChatGptBrowserWorker } from "../src/adapters/chatgpt-web/browser-worker";
+
+test("advisor downloads only ChatGPT artifacts and never overwrites a workspace file", async () => {
+  const module = await import("../src/adapters/chatgpt-web/advisor/artifacts").catch(() => undefined);
+  expect(module).toBeDefined();
+  if (!module) return;
+
+  expect(module.isChatGptArtifactHref("sandbox:/mnt/data/report.docx")).toBeTrue();
+  expect(module.isChatGptArtifactHref("https://chatgpt.com/backend-api/files/file-123")).toBeTrue();
+  expect(module.isChatGptArtifactHref("https://example.com/report.docx")).toBeFalse();
+  expect(module.isChatGptArtifactHref("javascript:alert(1)")).toBeFalse();
+
+  const root = mkdtempSync(join(tmpdir(), "advisor-artifact-"));
+  try {
+    const fakeDownload = (content: string) => ({
+      suggestedFilename: () => "report.docx",
+      createReadStream: async () => Readable.from([Buffer.from(content)]),
+    });
+    const first = await module.saveAdvisorDownload(fakeDownload("first"), {
+      outputDirectory: root,
+      allowedRoots: [root],
+      agentId: "advisor_artifact_123",
+    });
+    expect(first.name).toBe("report.docx");
+    expect(readFileSync(first.path, "utf8")).toBe("first");
+
+    const second = await module.saveAdvisorDownload(fakeDownload("second"), {
+      outputDirectory: root,
+      allowedRoots: [root],
+      agentId: "advisor_artifact_123",
+    });
+    expect(second.path).not.toBe(first.path);
+    expect(second.name).toContain("chatgpt-pro");
+    expect(readFileSync(first.path, "utf8")).toBe("first");
+    expect(readFileSync(second.path, "utf8")).toBe("second");
+
+    writeFileSync(join(root, "CON"), "reserved", "utf8");
+    const reserved = await module.saveAdvisorDownload({
+      suggestedFilename: () => "../CON",
+      createReadStream: async () => Readable.from([Buffer.from("safe")]),
+    }, {
+      outputDirectory: root,
+      allowedRoots: [root],
+      agentId: "advisor_artifact_123",
+    });
+    expect(reserved.name.toUpperCase()).not.toBe("CON");
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+test("browser worker downloads only artifact links from the completed assistant turn", async () => {
+  const root = mkdtempSync(join(tmpdir(), "advisor-artifact-dom-"));
+  const clicked: string[] = [];
+  try {
+    const hrefs = [
+      "https://example.com/reference",
+      "sandbox:/mnt/data/final-report.docx",
+    ];
+    const anchors = {
+      count: async () => hrefs.length,
+      nth: (index: number) => ({
+        getAttribute: async (name: string) => name === "href" ? hrefs[index] : null,
+        click: async () => { clicked.push(hrefs[index]!); },
+      }),
+    };
+    const responseTurn = { locator: (selector: string) => {
+      expect(selector).toBe("a[href]");
+      return anchors;
+    } };
+    const page = {
+      waitForEvent: async (event: string) => {
+        expect(event).toBe("download");
+        return {
+          suggestedFilename: () => "final-report.docx",
+          createReadStream: async () => Readable.from([Buffer.from("report")]),
+        };
+      },
+    };
+    const downloadArtifacts = (ChatGptBrowserWorker.prototype as unknown as {
+      downloadArtifacts(page: unknown, responseTurn: unknown, options: {
+        outputDirectory: string;
+        allowedRoots: string[];
+        agentId: string;
+      }): Promise<unknown[]>;
+    }).downloadArtifacts;
+
+    expect(typeof downloadArtifacts).toBe("function");
+    const artifacts = await downloadArtifacts.call({}, page, responseTurn, {
+      outputDirectory: root,
+      allowedRoots: [root],
+      agentId: "advisor_dom_123",
+    });
+    expect(clicked).toEqual(["sandbox:/mnt/data/final-report.docx"]);
+    expect(artifacts).toEqual([
+      expect.objectContaining({ name: "final-report.docx", size: 6 }),
+    ]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("advisor materializes a bounded codex-artifact fallback without overwriting", async () => {
+  const module = await import("../src/adapters/chatgpt-web/advisor/artifacts");
+  expect(typeof (module as Record<string, unknown>).extractAdvisorArtifactBlocks).toBe("function");
+  expect(typeof (module as Record<string, unknown>).saveAdvisorArtifactBytes).toBe("function");
+  const extract = (module as unknown as {
+    extractAdvisorArtifactBlocks(text: string): {
+      text: string;
+      artifacts: Array<{ filename: string; mimeType?: string; data: Uint8Array }>;
+    };
+  }).extractAdvisorArtifactBlocks;
+  const save = (module as unknown as {
+    saveAdvisorArtifactBytes(
+      artifact: { filename: string; mimeType?: string; data: Uint8Array },
+      options: { outputDirectory: string; allowedRoots: string[]; agentId: string },
+    ): Promise<{ name: string; path: string; size: number }>;
+  }).saveAdvisorArtifactBytes;
+  const encoded = Buffer.from("ADVISOR_READY: BLUE-CEDAR-7429\n").toString("base64");
+  const parsed = extract(`Created.\n\n\`\`\`codex-artifact\n${JSON.stringify({
+    filename: "advisor-e2e-result.txt",
+    media_type: "text/plain",
+    encoding: "base64",
+    data: encoded,
+  })}\n\`\`\``);
+  expect(parsed.text).toBe("Created.");
+  expect(parsed.artifacts).toHaveLength(1);
+
+  const root = mkdtempSync(join(tmpdir(), "advisor-artifact-fallback-"));
+  try {
+    const first = await save(parsed.artifacts[0]!, {
+      outputDirectory: root,
+      allowedRoots: [root],
+      agentId: "advisor_fallback_123",
+    });
+    expect(readFileSync(first.path, "utf8")).toBe("ADVISOR_READY: BLUE-CEDAR-7429\n");
+    const second = await save(parsed.artifacts[0]!, {
+      outputDirectory: root,
+      allowedRoots: [root],
+      agentId: "advisor_fallback_123",
+    });
+    expect(second.path).not.toBe(first.path);
+    expect(readFileSync(first.path, "utf8")).toBe("ADVISOR_READY: BLUE-CEDAR-7429\n");
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
