index 0000000..75764e9
--- /dev/null
+++ b/launcher/electron/runtime-bundle-digest.cjs
@@ -0,0 +1,52 @@
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+
+function pathIsWithin(root, candidate) {
+  const relative = path.relative(root, candidate);
+  return relative === "" || (!path.isAbsolute(relative) && relative !== ".." && !relative.startsWith(`..${path.sep}`));
+}
+
+/**
+ * 摘要覆盖 manifest 之外的最终运行时全树；manifest 保存摘要本身，因此必须排除。
+ * 相对路径规范为正斜杠并排序，使构建端与 Launcher 校验端共享同一身份。
+ */
+function runtimeBundleDigest(runtimeRoot) {
+  const root = path.resolve(runtimeRoot);
+  const rootMetadata = fs.lstatSync(root);
+  if (rootMetadata.isSymbolicLink() || !rootMetadata.isDirectory()) {
+    throw new Error(`Runtime bundle root must be a real directory without a reparse point: ${root}`);
+  }
+  const canonicalRoot = fs.realpathSync.native(root);
+  const files = [];
+  const visit = (directory, prefix = "") => {
+    for (const name of fs.readdirSync(directory).sort()) {
+      const relative = prefix ? `${prefix}/${name}` : name;
+      if (relative === "manifest.json") continue;
+      const absolute = path.join(directory, name);
+      const metadata = fs.lstatSync(absolute);
+      if (metadata.isSymbolicLink()) {
+        throw new Error(`Runtime bundle digest rejects symbolic links or reparse points: ${relative}`);
+      }
+      const canonical = fs.realpathSync.native(absolute);
+      if (!pathIsWithin(canonicalRoot, canonical)) {
+        throw new Error(`Runtime bundle digest path escapes its root: ${relative}`);
+      }
+      if (metadata.isDirectory()) visit(absolute, relative);
+      else if (metadata.isFile()) files.push(relative);
+      else throw new Error(`Runtime bundle digest rejects non-regular entries: ${relative}`);
+    }
+  };
+  visit(root);
+
+  const hash = crypto.createHash("sha256");
+  for (const relative of files.sort()) {
+    hash.update(relative);
+    hash.update("\0");
+    hash.update(fs.readFileSync(path.join(root, ...relative.split("/"))));
+    hash.update("\0");
+  }
+  return hash.digest("hex");
+}
+
+module.exports = { runtimeBundleDigest };
