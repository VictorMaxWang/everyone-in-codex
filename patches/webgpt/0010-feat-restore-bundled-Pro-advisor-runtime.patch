index 0000000..0454e84
--- /dev/null
+++ b/src/adapters/chatgpt-web/advisor/workspace.ts
@@ -0,0 +1,72 @@
+import { existsSync, realpathSync } from "node:fs";
+import { isAbsolute, relative, resolve } from "node:path";
+
+function pathIdentity(value: string): string {
+  const normalized = resolve(value);
+  return process.platform === "win32" ? normalized.toLowerCase() : normalized;
+}
+
+export function isPathInside(root: string, candidate: string): boolean {
+  const nested = relative(pathIdentity(root), pathIdentity(candidate));
+  return nested === "" || (!nested.startsWith("..") && !isAbsolute(nested));
+}
+
+export function canonicalWorkspaceRoots(roots: readonly string[]): string[] {
+  if (roots.length === 0) throw new Error("Advisor requires at least one current Codex workspace root");
+  const canonical = new Map<string, string>();
+  for (const root of roots) {
+    if (typeof root !== "string" || !isAbsolute(root) || !existsSync(root)) {
+      throw new Error("Advisor workspace roots must be existing absolute paths");
+    }
+    const real = realpathSync.native(root);
+    canonical.set(pathIdentity(real), real);
+  }
+  return [...canonical.values()];
+}
+
+/**
+ * Advisor 是用户显式启用的整机只读助手。这里仍通过 realpath 固定实际目标，
+ * 但不再把普通文件访问限制在 Codex workspace 内。
+ */
+export function resolveLocalReadPath(value: string, cwd: string): string {
+  if (typeof value !== "string" || !value.trim()) throw new Error("Advisor path is empty");
+  const candidate = isAbsolute(value) ? resolve(value) : resolve(cwd, value);
+  if (!existsSync(candidate)) throw new Error(`Advisor path does not exist: ${value}`);
+  return realpathSync.native(candidate);
+}
+
+export function accessibleLocalFilesystemRoots(seedRoots: readonly string[]): string[] {
+  const candidates = [...seedRoots];
+  if (process.platform === "win32") {
+    for (let code = 65; code <= 90; code += 1) {
+      const root = `${String.fromCharCode(code)}:\\`;
+      if (existsSync(root)) candidates.push(root);
+    }
+  } else if (existsSync("/")) candidates.push("/");
+  return canonicalWorkspaceRoots(candidates);
+}
+
+/**
+ * 先 realpath 再做根目录包含判断，避免 junction、symlink 或 `..` 把只读访问带出工作区。
+ */
+export function resolveWorkspaceReadPath(
+  value: string,
+  cwd: string,
+  roots: readonly string[],
+): string {
+  const real = resolveLocalReadPath(value, cwd);
+  const canonicalRoots = canonicalWorkspaceRoots(roots);
+  if (!canonicalRoots.some(root => isPathInside(root, real))) {
+    throw new Error(`Advisor path is outside the current Codex workspace: ${value}`);
+  }
+  return real;
+}
+
+export function assertWorkspaceDirectory(
+  value: string,
+  cwd: string,
+  roots: readonly string[],
+): string {
+  const resolved = resolveWorkspaceReadPath(value, cwd, roots);
+  return resolved;
+}
