+test("advisor preserves a competing archive that wins the exclusive-open race", async () => {
+  const root = mkdtempSync(join(tmpdir(), "advisor-files-race-root-"));
+  const selection = join(root, "selection");
+  const staging = mkdtempSync(join(tmpdir(), "advisor-files-race-staging-"));
+  temporaryRoots.push(root, staging);
+  mkdirSync(selection);
+  writeFileSync(join(selection, "selected.txt"), "selected", "utf8");
+  const archive = join(staging, "advisor-race.zip");
+  const competingBytes = Buffer.from("competing actor owns this path\n", "utf8");
+  const script = `
+    import { mock } from "bun:test";
+    import * as realFs from "node:fs";
+    const archive = ${JSON.stringify(archive)};
+    const competingBytes = Buffer.from(${JSON.stringify(competingBytes.toString("base64"))}, "base64");
+    const realExistsSync = realFs.existsSync.bind(realFs);
+    const realWriteFileSync = realFs.writeFileSync.bind(realFs);
+    mock.module("node:fs", () => ({
+      ...realFs,
+      existsSync(candidate) {
+        const exists = realExistsSync(candidate);
+        if (!exists && candidate === archive) {
+          // 在初始检查返回 false 前创建竞争文件，确定性模拟另一进程赢得后续 wx open。
+          realWriteFileSync(archive, competingBytes, { flag: "wx", mode: 0o600 });
+        }
+        return exists;
+      },
+    }));
+    const { prepareAdvisorAttachments } = await import("./src/adapters/chatgpt-web/advisor/files.ts");
+    let error;
+    try {
+      await prepareAdvisorAttachments({
+        paths: [${JSON.stringify(selection)}],
+        roots: [${JSON.stringify(root)}],
+        stagingDirectory: ${JSON.stringify(staging)},
+        agentId: "advisor_race",
+      });
+    } catch (caught) {
+      error = caught instanceof Error ? caught.message : String(caught);
+    }
+    console.log(JSON.stringify({
+      error,
+      exists: realExistsSync(archive),
+      bytes: realExistsSync(archive) ? realFs.readFileSync(archive).toString("base64") : null,
+    }));
+  `;
+  const child = Bun.spawn([process.execPath, "-e", script], {
+    cwd: join(import.meta.dir, ".."),
+    stdout: "pipe",
+    stderr: "pipe",
+  });
+  const [stdout, stderr, exitCode] = await Promise.all([
+    new Response(child.stdout).text(),
+    new Response(child.stderr).text(),
+    child.exited,
+  ]);
+
+  expect({ exitCode, stderr }).toEqual({ exitCode: 0, stderr: "" });
+  expect(JSON.parse(stdout)).toEqual({
+    error: expect.stringMatching(/exist/i),
+    exists: true,
+    bytes: competingBytes.toString("base64"),
+  });
+});
