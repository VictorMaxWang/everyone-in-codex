+  assertOwner(entry, ownerPid, detail = "ownership mismatch") {
+    if (entry.ownerPid !== ownerPid) {
+      throw new Error(`Browser tab lease ${entry.key} ${detail}: expected helper ${entry.ownerPid}, received ${ownerPid}`);
+    }
+  }
