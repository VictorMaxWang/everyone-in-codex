+    }),
+    completeTool: async () => {},
+    revoke: async () => {},
+  };
+  const runtime = new runtimeModule.ChatGptProAdvisorRuntime({
+    browserHostDescriptorPath: join(tmpdir(), "unused-launcher-browser.json"),
+    broker,
+    worker,
+    releaseRetainedConversation: async (conversationKey: string) => {
+      releasedPids.push(helperPid);
+      const tab = [...turnTabs.values()].find(candidate => candidate.conversationKey === conversationKey);
+      return tab && BrowserHost.prototype.releaseTurn.call(host, tab.traceId, helperPid).released ? 1 : 0;
+    },
+  });
+  const manager = new managerModule.AdvisorJobManager({ runtime, idleTimeoutMs });
+  return { helperPid, queue, turnTabs, releasedPids, manager };
+}
