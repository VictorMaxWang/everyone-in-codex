+
+  request(key, ownerPid, now = Date.now()) {
+    this.assertKey(key);
+    this.assertOwnerPid(ownerPid);
+    const leased = this.leased.get(key);
+    if (leased) {
+      this.assertOwner(leased, ownerPid, "owned by another helper process");
+      leased.lastSeenAt = now;
+      return { state: "leased", position: 0 };
+    }
+    const queuedIndex = this.queued.findIndex(entry => entry.key === key);
+    if (queuedIndex >= 0) {
+      const queued = this.queued[queuedIndex];
+      this.assertOwner(queued, ownerPid, "owned by another helper process");
+      queued.lastSeenAt = now;
+      return { state: "queued", position: queuedIndex + 1 };
+    }
+    if (this.leased.size < this.capacity && this.queued.length === 0) {
+      this.leased.set(key, { key, ownerPid, state: "leased", lastSeenAt: now });
+      return { state: "leased", position: 0 };
+    }
+    if (this.queued.length >= this.maxQueued) throw new Error(`Browser turn queue is full (${this.maxQueued} queued turns)`);
+    this.queued.push({ key, ownerPid, state: "queued", lastSeenAt: now });
+    return { state: "queued", position: this.queued.length };
+  }
+
+  status(key, ownerPid, now = Date.now()) {
+    this.assertOwnerPid(ownerPid);
+    const leased = this.leased.get(key);
+    if (leased) {
+      this.assertOwner(leased, ownerPid);
+      leased.lastSeenAt = now;
+      return { state: "leased", position: 0 };
+    }
+    const index = this.queued.findIndex(entry => entry.key === key);
+    if (index < 0) return undefined;
+    this.assertOwner(this.queued[index], ownerPid);
+    this.queued[index].lastSeenAt = now;
+    return { state: "queued", position: index + 1 };
+  }
+
+  transfer(key, currentOwnerPid, nextOwnerPid, now = Date.now()) {
+    this.assertKey(key);
+    this.assertOwnerPid(currentOwnerPid);
+    this.assertOwnerPid(nextOwnerPid);
+    const leased = this.leased.get(key);
+    if (!leased) throw new Error(`Browser tab lease ${key} is unavailable for owner transfer`);
+    this.assertOwner(leased, currentOwnerPid);
+    leased.ownerPid = nextOwnerPid;
+    leased.lastSeenAt = now;
+  }
+
+  release(key, ownerPid, now = Date.now()) {
+    this.assertOwnerPid(ownerPid);
+    const leased = this.leased.get(key);
+    if (!leased) return false;
+    this.assertOwner(leased, ownerPid);
+    this.leased.delete(key);
+    this.grantQueued(now);
+    return true;
+  }
+
+  cancel(key, ownerPid, now = Date.now()) {
+    this.assertOwnerPid(ownerPid);
+    const leased = this.leased.get(key);
+    if (leased) {
+      this.assertOwner(leased, ownerPid);
+      this.leased.delete(key);
+      this.grantQueued(now);
+      return true;
+    }
+    const index = this.queued.findIndex(entry => entry.key === key);
+    if (index < 0) return false;
+    this.assertOwner(this.queued[index], ownerPid);
+    this.queued.splice(index, 1);
+    return true;
+  }
+
+  reapExpired(now = Date.now(), protectedKeys = new Set()) {
+    const expired = [];
+    for (const [key, entry] of this.leased) {
+      if (protectedKeys.has(key) || now - entry.lastSeenAt < this.orphanTimeoutMs) continue;
+      this.leased.delete(key);
+      expired.push({ key, ownerPid: entry.ownerPid, state: "leased" });
+    }
+    this.queued = this.queued.filter(entry => {
+      if (now - entry.lastSeenAt < this.orphanTimeoutMs) return true;
+      expired.push({ key: entry.key, ownerPid: entry.ownerPid, state: "queued" });
+      return false;
+    });
+    if (expired.length > 0) this.grantQueued(now);
+    return expired;
+  }
+
+  grantQueued(now = Date.now()) {
+    while (this.leased.size < this.capacity && this.queued.length > 0) {
+      const next = this.queued.shift();
+      next.state = "leased";
+      next.lastSeenAt = now;
+      this.leased.set(next.key, next);
+    }
