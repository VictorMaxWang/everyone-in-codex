+test("advisor closeAll forgets an aborted job even when retained release fails", async () => {
+  const module = await advisorModule<typeof import("../src/adapters/chatgpt-web/advisor/job-manager")>(
+    "../src/adapters/chatgpt-web/advisor/job-manager",
+  );
+  expect(module).toBeDefined();
+  if (!module) return;
+
+  const counts = { aborted: 0, released: 0, runtimeClosed: 0 };
+  const runtime = {
+    run: async (request: { signal: AbortSignal }) => await new Promise<never>((_resolve, reject) => {
+      request.signal.addEventListener("abort", () => {
+        counts.aborted += 1;
+        reject(new DOMException("aborted", "AbortError"));
+      }, { once: true });
+    }),
+    release: async () => {
+      counts.released += 1;
+      throw new Error("launcher release failed");
+    },
+    close: async () => { counts.runtimeClosed += 1; },
+  };
+  const manager = new module.AdvisorJobManager({ runtime, idleTimeoutMs: 60_000 });
+  manager.spawn({ prompt: "Wait for shutdown", roots: [tmpdir()], outputDirectory: tmpdir(), attachments: [] });
+
+  await manager.closeAll().catch(() => {});
+
+  expect(counts).toEqual({ aborted: 1, released: 1, runtimeClosed: 1 });
+  expect(manager.list()).toHaveLength(0);
+});
