+/** FIFO 仅占一个轻量租约；等待中的请求不会预建 WebContentsView。 */
+class BrowserTabLeaseQueue {
+  constructor(capacity = MAX_BROWSER_TABS, maxQueued = MAX_BROWSER_QUEUED_TURNS, orphanTimeoutMs = TURN_HEARTBEAT_TIMEOUT_MS) {
+    if (!Number.isInteger(capacity) || capacity < 1) throw new Error("Browser tab capacity is invalid");
+    if (!Number.isInteger(maxQueued) || maxQueued < 0) throw new Error("Browser tab queue capacity is invalid");
+    if (!Number.isInteger(orphanTimeoutMs) || orphanTimeoutMs < 1) throw new Error("Browser tab queue orphan timeout is invalid");
