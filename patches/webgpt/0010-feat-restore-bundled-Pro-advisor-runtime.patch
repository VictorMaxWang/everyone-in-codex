index 0000000..8c8796b
--- /dev/null
+++ b/src/adapters/chatgpt-web/advisor/read-only-tools.ts
@@ -0,0 +1,284 @@
+import {
+  closeSync,
+  lstatSync,
+  openSync,
+  readFileSync,
+  readSync,
+  readdirSync,
+  statSync,
+} from "node:fs";
+import { basename, extname, join, relative } from "node:path";
+import type { CodexTool } from "../../../types";
+import type { ChatGptTurnEnvironment } from "../environment";
+import type { BrokerToolRequest, BrokerToolResult } from "../turn-broker";
+import { accessibleLocalFilesystemRoots, resolveLocalReadPath } from "./workspace";
+import { saveAdvisorArtifactBytes } from "./artifacts";
+import type { ChatGptDownloadedArtifact } from "../browser-worker";
+
+const MAX_DIRECTORY_ENTRIES = 500;
+const MAX_READ_BYTES = 256 * 1024;
+const MAX_SEARCH_FILES = 2_000;
+const MAX_SEARCH_FILE_BYTES = 5 * 1024 * 1024;
+const MAX_IMAGE_BYTES = 20 * 1024 * 1024;
+function tools(): CodexTool[] {
+  return [
+    {
+      name: "list_directory",
+      description: "List at most 500 direct entries in any accessible local directory.",
+      parameters: {
+        type: "object",
+        properties: { path: { type: "string", description: "Absolute path or path relative to the current workspace cwd." } },
+        required: ["path"],
+        additionalProperties: false,
+      },
+      strict: true,
+    },
+    {
+      name: "stat_path",
+      description: "Read type, size, and modification time for any accessible local path.",
+      parameters: {
+        type: "object",
+        properties: { path: { type: "string" } },
+        required: ["path"],
+        additionalProperties: false,
+      },
+      strict: true,
+    },
+    {
+      name: "read_file",
+      description: "Read a bounded UTF-8 byte range from any accessible local regular file.",
+      parameters: {
+        type: "object",
+        properties: {
+          path: { type: "string" },
+          offset: { type: "integer", minimum: 0, default: 0 },
+          max_bytes: { type: "integer", minimum: 1, maximum: MAX_READ_BYTES, default: 65536 },
+        },
+        required: ["path"],
+        additionalProperties: false,
+      },
+      strict: true,
+    },
+    {
+      name: "search_text",
+      description: "Search ordinary UTF-8 files below any accessible local directory without invoking a shell.",
+      parameters: {
+        type: "object",
+        properties: {
+          path: { type: "string", default: "." },
+          query: { type: "string", minLength: 1, maxLength: 500 },
+          max_results: { type: "integer", minimum: 1, maximum: 100, default: 20 },
+        },
+        required: ["query"],
+        additionalProperties: false,
+      },
+      strict: true,
+    },
+    {
+      name: "view_image",
+      description: "Read one accessible local PNG, JPEG, GIF, or WebP image.",
+      parameters: {
+        type: "object",
+        properties: { path: { type: "string" }, detail: { type: "string", enum: ["high", "original"] } },
+        required: ["path"],
+        additionalProperties: false,
+      },
+      strict: true,
+    },
+    {
+      name: "deliver_artifact",
+      description: "Deliver one completed file to the selected local output directory. Creates a new file only and never overwrites an existing path.",
+      parameters: {
+        type: "object",
+        properties: {
+          filename: { type: "string", minLength: 1, maxLength: 255 },
+          media_type: { type: "string", minLength: 1, maxLength: 200 },
+          encoding: { type: "string", const: "base64" },
+          data: { type: "string", minLength: 4, maxLength: 28_000_000 },
+        },
+        required: ["filename", "media_type", "encoding", "data"],
+        additionalProperties: false,
+      },
+      strict: true,
+    },
+  ];
+}
+
+export function createAdvisorReadOnlyEnvironment(options: {
+  cwd: string;
+  roots: readonly string[];
+}): ChatGptTurnEnvironment {
+  const cwd = resolveLocalReadPath(options.cwd, options.roots[0]!);
+  const roots = accessibleLocalFilesystemRoots(options.roots);
+  return {
+    cwd,
+    roots,
+    writableRoots: [],
+    sandboxPolicy: { type: "readOnly", networkAccess: false },
+    tools: tools(),
+  };
+}
+
+function textResult(value: Record<string, unknown>): BrokerToolResult {
+  return {
+    content: [{ type: "text", text: JSON.stringify(value) }],
+    structuredContent: value,
+  };
+}
+
+function stringArgument(args: Record<string, unknown>, key: string, fallback?: string): string {
+  const value = args[key] ?? fallback;
+  if (typeof value !== "string" || !value.trim()) throw new Error(`Advisor ${key} must be a non-empty string`);
+  return value;
+}
+
+function integerArgument(
+  args: Record<string, unknown>,
+  key: string,
+  fallback: number,
+  minimum: number,
+  maximum: number,
+): number {
+  const value = args[key] ?? fallback;
+  if (!Number.isInteger(value) || (value as number) < minimum || (value as number) > maximum) {
+    throw new Error(`Advisor ${key} is outside the allowed range`);
+  }
+  return value as number;
+}
+
+function safePath(value: string, environment: ChatGptTurnEnvironment): string {
+  return resolveLocalReadPath(value, environment.cwd);
+}
+
+function imageMime(path: string): string {
+  switch (extname(path).toLowerCase()) {
+    case ".png": return "image/png";
+    case ".jpg": case ".jpeg": return "image/jpeg";
+    case ".gif": return "image/gif";
+    case ".webp": return "image/webp";
+    default: throw new Error("Advisor view_image supports PNG, JPEG, GIF, and WebP only");
+  }
+}
+
+export async function executeAdvisorReadOnlyTool(
+  request: Pick<BrokerToolRequest, "wireName" | "arguments">,
+  environment: ChatGptTurnEnvironment,
+  delivery?: {
+    outputDirectory: string;
+    agentId: string;
+    onArtifact?(artifact: ChatGptDownloadedArtifact): void;
+  },
+): Promise<BrokerToolResult> {
+  const args = request.arguments ?? {};
+  switch (request.wireName) {
+    case "list_directory": {
+      const path = safePath(stringArgument(args, "path"), environment);
+      if (!statSync(path).isDirectory()) throw new Error("Advisor list_directory path is not a directory");
+      const entries = readdirSync(path, { withFileTypes: true })
+        .slice(0, MAX_DIRECTORY_ENTRIES)
+        .map(entry => ({
+          name: entry.name,
+          type: entry.isDirectory() ? "directory" : entry.isFile() ? "file" : "other",
+          accessible: true,
+        }));
+      return textResult({ path, entries, truncated: entries.length >= MAX_DIRECTORY_ENTRIES });
+    }
+    case "stat_path": {
+      const path = safePath(stringArgument(args, "path"), environment);
+      const stat = lstatSync(path);
+      return textResult({
+        path,
+        type: stat.isDirectory() ? "directory" : stat.isFile() ? "file" : "other",
+        size: stat.size,
+        modified_at: stat.mtime.toISOString(),
+      });
+    }
+    case "read_file": {
+      const path = safePath(stringArgument(args, "path"), environment);
+      const stat = statSync(path);
+      if (!stat.isFile()) throw new Error("Advisor read_file path is not a regular file");
+      const offset = integerArgument(args, "offset", 0, 0, Number.MAX_SAFE_INTEGER);
+      const maxBytes = integerArgument(args, "max_bytes", 65_536, 1, MAX_READ_BYTES);
+      const size = Math.max(0, Math.min(maxBytes, stat.size - offset));
+      const buffer = Buffer.alloc(size);
+      const descriptor = openSync(path, "r");
+      let bytesRead = 0;
+      try { bytesRead = readSync(descriptor, buffer, 0, size, offset); }
+      finally { closeSync(descriptor); }
+      return textResult({
+        path,
+        offset,
+        bytes_read: bytesRead,
+        eof: offset + bytesRead >= stat.size,
+        text: buffer.subarray(0, bytesRead).toString("utf8"),
+      });
+    }
+    case "search_text": {
+      const root = safePath(stringArgument(args, "path", "."), environment);
+      const query = stringArgument(args, "query");
+      const maxResults = integerArgument(args, "max_results", 20, 1, 100);
+      const matches: Array<{ path: string; line: number; text: string }> = [];
+      let visited = 0;
+      const walk = (path: string) => {
+        if (matches.length >= maxResults || visited >= MAX_SEARCH_FILES) return;
+        const metadata = lstatSync(path);
+        if (metadata.isSymbolicLink()) return;
+        if (metadata.isDirectory()) {
+          for (const entry of readdirSync(path).sort((left, right) => left.localeCompare(right))) walk(join(path, entry));
+          return;
+        }
+        if (!metadata.isFile() || metadata.size > MAX_SEARCH_FILE_BYTES) return;
+        visited += 1;
+        const content = readFileSync(path, "utf8");
+        if (content.includes("\u0000")) return;
+        const needle = query.toLowerCase();
+        for (const [index, line] of content.split(/\r?\n/).entries()) {
+          if (!line.toLowerCase().includes(needle)) continue;
+          matches.push({ path: relative(environment.cwd, path) || basename(path), line: index + 1, text: line.slice(0, 1_000) });
+          if (matches.length >= maxResults) break;
+        }
+      };
+      walk(root);
+      return textResult({ query, matches, visited_files: visited, truncated: matches.length >= maxResults });
+    }
+    case "view_image": {
+      const path = safePath(stringArgument(args, "path"), environment);
+      const stat = statSync(path);
+      if (!stat.isFile() || stat.size > MAX_IMAGE_BYTES) throw new Error("Advisor image is not a regular file or exceeds 20 MB");
+      const mimeType = imageMime(path);
+      return {
+        content: [{ type: "image", data: readFileSync(path).toString("base64"), mimeType }],
+        structuredContent: { path, size: stat.size, mime_type: mimeType },
+      };
+    }
+    case "deliver_artifact": {
+      if (!delivery) throw new Error("Advisor artifact delivery channel is unavailable");
+      const filename = stringArgument(args, "filename");
+      const mediaType = stringArgument(args, "media_type");
+      if (args.encoding !== "base64") throw new Error("Advisor deliver_artifact encoding must be base64");
+      const encoded = stringArgument(args, "data");
+      if (!/^[A-Za-z0-9+/]*={0,2}$/.test(encoded) || encoded.length % 4 !== 0) {
+        throw new Error("Advisor deliver_artifact data is not valid base64");
+      }
+      const data = Buffer.from(encoded, "base64");
+      if (data.length === 0 || data.length > 20 * 1024 * 1024) {
+        throw new Error("Advisor deliver_artifact is empty or exceeds 20 MB");
+      }
+      const artifact = await saveAdvisorArtifactBytes({ filename, mimeType: mediaType, data }, {
+        outputDirectory: delivery.outputDirectory,
+        allowedRoots: [delivery.outputDirectory],
+        agentId: delivery.agentId,
+      });
+      delivery.onArtifact?.(artifact);
+      return textResult({
+        delivered: true,
+        name: artifact.name,
+        path: artifact.path,
+        size: artifact.size,
+        mime_type: artifact.mimeType ?? mediaType,
+      });
+    }
+    default:
+      throw new Error(`Codex tool ${request.wireName} is not available in read-only advisor mode`);
+  }
+}
diff --git a/src/adapters/chatgpt-web/advisor/runtime.ts b/src/adapters/chatgpt-web/advisor/runtime.ts
new file mode 100644
index 0000000..ffbdf95
--- /dev/null
+++ b/src/adapters/chatgpt-web/advisor/runtime.ts
@@ -0,0 +1,207 @@
+import { createHash } from "node:crypto";
+import { join } from "node:path";
+import {
+  CHATGPT_CONNECTOR_NAME,
+  defaultBrokerEndpoint,
+  getConfigDir,
+} from "../../../config";
+import type { CodexProviderConfig } from "../../../types";
+import {
+  ChatGptBrowserWorker,
+  type BrowserTurn,
+  type ChatGptDownloadedArtifact,
+} from "../browser-worker";
+import { CHATGPT_WEB_MODEL_ID } from "../model";
+import { releaseLauncherRetainedConversation } from "../../../launcher-browser-host";
+import {
+  RemoteTurnBroker,
+  type BrokerToolResult,
+  type TurnBrokerOwner,
+} from "../turn-broker";
+import type { AdvisorRuntime, AdvisorRuntimeRequest } from "./job-manager";
+import { compileAdvisorPrompt } from "./prompt";
+import {
+  createAdvisorReadOnlyEnvironment,
+  executeAdvisorReadOnlyTool,
+} from "./read-only-tools";
+import { extractAdvisorArtifactBlocks, saveAdvisorArtifactBytes } from "./artifacts";
+
+function advisorConversationKey(agentId: string): string {
+  return createHash("sha256").update(`chatgpt-pro-advisor:${agentId}`).digest("hex");
+}
+export function normalizeAdvisorAnswer(value: string): string {
+  const trimmed = value.trim();
+  if (!/^[A-Za-z0-9._\\-]+$/.test(trimmed)) return value;
+  return trimmed.replace(/\\([_*`~\\])/g, "$1");
+}
+
+interface AdvisorBroker extends TurnBrokerOwner {
+  assertCompatible?(): Promise<void>;
+}
+
+interface AdvisorBrowserWorker {
+  run(turn: BrowserTurn): Promise<string>;
+  close?(): Promise<void>;
+}
+
+function errorToolResult(error: unknown): BrokerToolResult {
+  const message = error instanceof Error ? error.message : String(error);
+  return {
+    content: [{ type: "text", text: JSON.stringify({ error: message }) }],
+    structuredContent: { error: message },
+    isError: true,
+  };
+}
+
+export class ChatGptProAdvisorRuntime implements AdvisorRuntime {
+  private readonly browserHostDescriptorPath: string;
+  private readonly broker: AdvisorBroker;
+  private readonly worker: AdvisorBrowserWorker;
+  private readonly releaseRetainedConversation: (conversationKey: string) => Promise<number>;
+
+  constructor(options: {
+    browserHostDescriptorPath?: string;
+    broker?: AdvisorBroker;
+    worker?: AdvisorBrowserWorker;
+    releaseRetainedConversation?: (conversationKey: string) => Promise<number>;
+  } = {}) {
+    this.browserHostDescriptorPath = options.browserHostDescriptorPath
+      ?? join(getConfigDir(), "runtime", "launcher-browser.json");
+    this.broker = options.broker ?? new RemoteTurnBroker(defaultBrokerEndpoint());
+    const provider: CodexProviderConfig = {
+      adapter: "chatgpt-web",
+      baseUrl: "https://chatgpt.com",
+      chatgptWeb: {
+        appName: CHATGPT_CONNECTOR_NAME,
+        browserHost: "launcher",
+        browserHostDescriptorPath: this.browserHostDescriptorPath,
+        autoApproveToolCalls: true,
+      },
+    };
+    this.worker = options.worker ?? ChatGptBrowserWorker.forProvider(provider);
+    this.releaseRetainedConversation = options.releaseRetainedConversation
+      ?? (conversationKey => releaseLauncherRetainedConversation(this.browserHostDescriptorPath, conversationKey));
+  }
+
+  async run(request: AdvisorRuntimeRequest): Promise<{
+    text: string;
+    artifacts: ChatGptDownloadedArtifact[];
+  }> {
+    // Pro 能力由真正的浏览器 turn 在模型选择阶段验证。这里不再运行独立的手工探针，
+    // 避免多个并发 Advisor 互相占用 session inspection 并产生伪登录失败。
+    await this.broker.assertCompatible?.();
+    const environment = createAdvisorReadOnlyEnvironment({
+      cwd: request.outputDirectory,
+      roots: request.roots,
+    });
+    const token = await this.broker.register(environment, undefined, request.agentId);
+    const artifacts: ChatGptDownloadedArtifact[] = [];
+    let toolController: AbortController | undefined;
+    let toolLoop: Promise<unknown> | undefined;
+    try {
+      // register 成功后的每一步都在同一清理边界内；即使 prompt 拒绝复制的 Codex envelope，
+      // 也必须撤销 token 并等待已经启动的只读工具循环退出。
+      toolController = new AbortController();
+      // 立即挂上 rejection handler。浏览器可能运行数分钟；若等到 finally 才 `.catch()`，
+      // Bun 会在 broker revoke 的 await 期间把 AbortError 当作未处理拒绝并终止 stdio MCP。
+      toolLoop = this.runToolLoop(token, environment, toolController.signal, {
+        outputDirectory: request.outputDirectory,
+        agentId: request.agentId,
+        onArtifact: artifact => artifacts.push(artifact),
+      }).then(
+        () => undefined,
+        error => error,
+      );
+      const prompt = compileAdvisorPrompt({
+        brief: request.prompt,
+        turnToken: token,
+        attachments: request.attachments.map(file => ({ name: file.name, size: file.size })),
+        ...(request.expectedOutputs ? { expectedOutputs: request.expectedOutputs } : {}),
+      });
+      const browserTurn: BrowserTurn = {
+        traceId: request.agentId,
+        modelId: CHATGPT_WEB_MODEL_ID,
+        reasoning: "max",
+        capabilities: { localToolsEnabled: true, solAvailable: true, proAvailable: true },
+        nativeConnector: true,
+        conversationKey: advisorConversationKey(request.agentId),
+        retainConversation: true,
+        prepare: async () => ({
+          text: prompt,
+          images: [],
+          files: request.attachments,
+          release() {},
+        }),
+        ...(request.continuation ? {
+          requireRetainedConversation: true,
+          prepareResume: async () => ({
+            text: prompt,
+            images: [],
+            files: request.attachments,
+            release() {},
+          }),
+        } : {}),
+        abortSignal: request.signal,
+        onQueuePosition: request.onQueuePosition,
+        onReasoningSummary: request.onCommentary,
+        onCommentary: request.onCommentary,
+        onTextDelta: request.onTextDelta ?? (() => {}),
+        artifactOutputDirectory: request.outputDirectory,
+        artifactAllowedRoots: [request.outputDirectory],
+        onArtifacts: downloaded => artifacts.push(...downloaded),
+      };
+      // 导航恢复由 browser helper 的统一发送前重试负责；Advisor 绝不重复调用 worker，避免重复发送。
+      const text = await this.worker.run(browserTurn);
+      const extracted = extractAdvisorArtifactBlocks(text);
+      const existingNames = new Set(artifacts.map(artifact => artifact.name.toLowerCase()));
+      for (const artifact of extracted.artifacts) {
+        if (existingNames.has(artifact.filename.toLowerCase())) continue;
+        const saved = await saveAdvisorArtifactBytes(artifact, {
+          outputDirectory: request.outputDirectory,
+          allowedRoots: [request.outputDirectory],
+          agentId: request.agentId,
+        });
+        artifacts.push(saved);
+        existingNames.add(saved.name.toLowerCase());
+      }
+      return { text: normalizeAdvisorAnswer(extracted.text), artifacts };
+    } finally {
+      toolController?.abort();
+      await Promise.resolve(this.broker.revoke(token)).catch(() => {});
+      const toolError = await toolLoop;
+      if (toolError && !(toolError instanceof DOMException && toolError.name === "AbortError")) {
+        console.error(`[chatgpt-pro-advisor] read-only tool loop stopped: ${toolError instanceof Error ? toolError.message : String(toolError)}`);
+      }
+    }
+  }
+
+  async release(agentId: string): Promise<boolean> {
+    // v4 retained tab 以稳定 conversationKey 作为释放身份，不再猜测 helper 子进程 PID。
+    return (await this.releaseRetainedConversation(advisorConversationKey(agentId))) > 0;
+  }
+
+  async close(): Promise<void> {
+    await this.worker.close?.();
+  }
+
+  private async runToolLoop(
+    token: string,
+    environment: ReturnType<typeof createAdvisorReadOnlyEnvironment>,
+    signal: AbortSignal,
+    delivery: {
+      outputDirectory: string;
+      agentId: string;
+      onArtifact(artifact: ChatGptDownloadedArtifact): void;
+    },
+  ): Promise<void> {
+    while (!signal.aborted) {
+      const batch = await this.broker.nextToolBatch(token, signal);
+      for (const request of batch) {
+        let result: BrokerToolResult;
+        try { result = await executeAdvisorReadOnlyTool(request, environment, delivery); }
+        catch (error) { result = errorToolResult(error); }
+        await this.broker.completeTool(token, request.callId, result);
+      }
+    }
+  }
+}
