+import { closeSync, createWriteStream, openSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { extname, isAbsolute, join } from "node:path";
+import type { Readable } from "node:stream";
+import { pipeline } from "node:stream/promises";
+import type { ChatGptDownloadedArtifact } from "../browser-worker";
+import { resolveLocalReadPath } from "./workspace";
+
+interface AdvisorDownloadLike {
+  suggestedFilename(): string;
+  createReadStream(): Promise<Readable | null>;
+}
+
+const WINDOWS_RESERVED_NAME = /^(?:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)/i;
+
+export function isChatGptArtifactHref(value: string): boolean {
+  if (typeof value !== "string" || !value) return false;
+  if (value.startsWith("sandbox:/mnt/data/")) return true;
+  let parsed: URL;
+  try { parsed = new URL(value, "https://chatgpt.com"); }
+  catch { return false; }
+  if (parsed.protocol !== "https:" || parsed.hostname !== "chatgpt.com") return false;
+  return parsed.pathname.startsWith("/backend-api/files/")
+    || parsed.pathname.startsWith("/backend-api/estuary/content")
+    || parsed.pathname.startsWith("/files/");
+}
+
+function safeFilename(value: string): string {
+  const leaf = value.replaceAll("\\", "/").split("/").at(-1) ?? "";
+  let safe = leaf
+    .replace(/[\u0000-\u001F\u007F<>:"/\\|?*]/g, "_")
+    .replace(/[. ]+$/g, "")
+    .trim();
+  if (!safe) safe = "chatgpt-pro-artifact";
+  if (WINDOWS_RESERVED_NAME.test(safe)) safe = `_${safe}`;
+  if (safe.length > 180) {
+    const extension = extname(safe).slice(0, 20);
+    safe = `${safe.slice(0, 180 - extension.length)}${extension}`;
+  }
+  return safe;
+}
+
+function artifactMime(path: string): string | undefined {
+  switch (extname(path).toLowerCase()) {
+    case ".pdf": return "application/pdf";
+    case ".docx": return "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
+    case ".xlsx": return "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
+    case ".pptx": return "application/vnd.openxmlformats-officedocument.presentationml.presentation";
+    case ".zip": return "application/zip";
+    case ".txt": case ".md": return "text/plain";
+    default: return undefined;
+  }
+}
+
+function candidateName(original: string, agentId: string, attempt: number): string {
+  if (attempt === 0) return original;
+  const extension = extname(original);
+  const stem = extension ? original.slice(0, -extension.length) : original;
+  const shortAgent = agentId.replace(/[^A-Za-z0-9]/g, "").slice(-12) || "advisor";
+  return `${stem}-chatgpt-pro-${shortAgent}${attempt > 1 ? `-${attempt}` : ""}${extension}`;
+}
+
+function artifactOutputDirectory(options: { outputDirectory: string; allowedRoots: readonly string[] }): string {
+  if (!isAbsolute(options.outputDirectory)) throw new Error("Advisor artifact output directory must be absolute");
+  const outputDirectory = resolveLocalReadPath(options.outputDirectory, options.outputDirectory);
+  if (!statSync(outputDirectory).isDirectory()) throw new Error("Advisor artifact output directory is not a directory");
+  return outputDirectory;
+}
+
+function allocateArtifactTarget(outputDirectory: string, suggested: string, agentId: string): {
+  descriptor: number;
+  target: string;
+} {
+  for (let attempt = 0; attempt < 1_000; attempt += 1) {
+    const name = candidateName(suggested, agentId, attempt);
+    const path = join(outputDirectory, name);
+    try { return { descriptor: openSync(path, "wx", 0o600), target: path }; }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+    }
+  }
+  throw new Error("Advisor could not allocate a unique artifact filename");
+}
+
+export function extractAdvisorArtifactBlocks(text: string): {
+  text: string;
+  artifacts: Array<{ filename: string; mimeType?: string; data: Uint8Array }>;
+} {
+  const artifacts: Array<{ filename: string; mimeType?: string; data: Uint8Array }> = [];
+  const cleaned = text.replace(/```codex-artifact\s*\r?\n([\s\S]*?)```/g, (_block, raw: string) => {
+    let value: Record<string, unknown>;
+    try { value = JSON.parse(raw.trim()) as Record<string, unknown>; }
+    catch { throw new Error("ChatGPT returned an invalid codex-artifact JSON block"); }
+    if (typeof value.filename !== "string" || !value.filename.trim()
+      || value.encoding !== "base64"
+      || typeof value.data !== "string"
+      || !/^[A-Za-z0-9+/]*={0,2}$/.test(value.data)
+      || value.data.length % 4 !== 0
+      || (value.media_type !== undefined && typeof value.media_type !== "string")) {
+      throw new Error("ChatGPT returned an invalid codex-artifact contract");
+    }
+    const data = Buffer.from(value.data, "base64");
+    if (data.length === 0 || data.length > 20 * 1024 * 1024) {
+      throw new Error("ChatGPT codex-artifact is empty or exceeds 20 MB");
+    }
+    artifacts.push({
+      filename: value.filename,
+      ...(value.media_type ? { mimeType: value.media_type as string } : {}),
+      data,
+    });
+    return "";
+  }).replace(/\n{3,}/g, "\n\n").trim();
+  return { text: cleaned, artifacts };
+}
+
+export async function saveAdvisorArtifactBytes(
+  artifact: { filename: string; mimeType?: string; data: Uint8Array },
+  options: { outputDirectory: string; allowedRoots: readonly string[]; agentId: string },
+): Promise<ChatGptDownloadedArtifact> {
+  if (!(artifact.data instanceof Uint8Array) || artifact.data.byteLength === 0 || artifact.data.byteLength > 20 * 1024 * 1024) {
+    throw new Error("Advisor fallback artifact is empty or exceeds 20 MB");
+  }
+  const outputDirectory = artifactOutputDirectory(options);
+  const allocated = allocateArtifactTarget(outputDirectory, safeFilename(artifact.filename), options.agentId);
+  try {
+    writeFileSync(allocated.descriptor, artifact.data);
+    closeSync(allocated.descriptor);
+  } catch (error) {
+    try { closeSync(allocated.descriptor); } catch {}
+    rmSync(allocated.target, { force: true });
+    throw error;
+  }
+  const stat = statSync(allocated.target);
+  return {
+    name: allocated.target.replaceAll("\\", "/").split("/").at(-1)!,
+    path: allocated.target,
+    size: stat.size,
+    ...(artifact.mimeType ? { mimeType: artifact.mimeType } : artifactMime(allocated.target) ? { mimeType: artifactMime(allocated.target) } : {}),
+  };
+}
+
+/**
+ * 先以 `wx` 独占创建目标，再把下载流写入该 fd；即使文件在检查与写入之间出现，也不会覆盖。
+ */
+export async function saveAdvisorDownload(
+  download: AdvisorDownloadLike,
+  options: { outputDirectory: string; allowedRoots: readonly string[]; agentId: string },
+): Promise<ChatGptDownloadedArtifact> {
+  const outputDirectory = artifactOutputDirectory(options);
+  const suggested = safeFilename(download.suggestedFilename());
+  const stream = await download.createReadStream();
+  if (!stream) throw new Error("ChatGPT artifact download did not expose a readable stream");
+
+  const { descriptor, target } = allocateArtifactTarget(outputDirectory, suggested, options.agentId);
+  try {
+    await pipeline(stream, createWriteStream(target, { fd: descriptor, autoClose: true }));
+  } catch (error) {
+    rmSync(target, { force: true });
+    throw error;
+  }
+  const stat = statSync(target);
+  if (!stat.isFile() || stat.size === 0) {
+    rmSync(target, { force: true });
+    throw new Error("ChatGPT artifact download was empty");
+  }
+  return {
+    name: target.replaceAll("\\", "/").split("/").at(-1)!,
+    path: target,
+    size: stat.size,
+    ...(artifactMime(target) ? { mimeType: artifactMime(target) } : {}),
+  };
+}
diff --git a/src/adapters/chatgpt-web/advisor/files.ts b/src/adapters/chatgpt-web/advisor/files.ts
new file mode 100644
index 0000000..f817818
--- /dev/null
+++ b/src/adapters/chatgpt-web/advisor/files.ts
@@ -0,0 +1,265 @@
+import {
+  createReadStream,
+  existsSync,
+  lstatSync,
+  mkdirSync,
+  readdirSync,
+  rmSync,
+  statSync,
+} from "node:fs";
+import { open } from "node:fs/promises";
+import { basename, dirname, extname, isAbsolute, join, relative, resolve } from "node:path";
+import type { Writable } from "node:stream";
+import { Zip, ZipPassThrough } from "fflate";
+import type { ChatGptWebPromptFile } from "../prompt";
+import { canonicalWorkspaceRoots, resolveLocalReadPath } from "./workspace";
+
+const MAX_UPLOAD_FILE_BYTES = 512 * 1024 * 1024;
+const MAX_ATTACHMENT_FILES = 500;
+
+export interface PreparedAdvisorAttachments {
+  files: ChatGptWebPromptFile[];
+  release(): void;
+}
+
+/** ZIP 内一个经本地路径授权和 regular-file 检查的输入条目。 */
+export interface AdvisorAttachmentEntry {
+  path: string;
+  root: string;
+  name: string;
+  size: number;
+}
+
+function mimeType(path: string): string {
+  switch (extname(path).toLowerCase()) {
+    case ".txt": case ".md": case ".log": return "text/plain";
+    case ".json": return "application/json";
+    case ".csv": return "text/csv";
+    case ".pdf": return "application/pdf";
+    case ".docx": return "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
+    case ".xlsx": return "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
+    case ".pptx": return "application/vnd.openxmlformats-officedocument.presentationml.presentation";
+    case ".zip": return "application/zip";
+    case ".png": return "image/png";
+    case ".jpg": case ".jpeg": return "image/jpeg";
+    case ".webp": return "image/webp";
+    default: return "application/octet-stream";
+  }
+}
+
+function collectEntries(path: string, selectionRoot: string, entries: AdvisorAttachmentEntry[]): void {
+  if (entries.length >= MAX_ATTACHMENT_FILES) throw new Error(`Advisor accepts at most ${MAX_ATTACHMENT_FILES} files per delegation`);
+  const metadata = lstatSync(path);
+  if (metadata.isSymbolicLink()) return;
+  if (metadata.isDirectory()) {
+    for (const child of readdirSync(path).sort((left, right) => left.localeCompare(right))) {
+      collectEntries(join(path, child), selectionRoot, entries);
+    }
+    return;
+  }
+  if (!metadata.isFile()) throw new Error(`Advisor attachment is not a regular file: ${basename(path)}`);
+  if (metadata.size > MAX_UPLOAD_FILE_BYTES) throw new Error(`Advisor attachment exceeds the 512 MB file limit: ${basename(path)}`);
+  entries.push({
+    path,
+    root: selectionRoot,
+    name: basename(path),
+    size: metadata.size,
+  });
+}
+
+function zipEntryName(entry: AdvisorAttachmentEntry, used: Set<string>): string {
+  const relativeName = relative(entry.root, entry.path).replaceAll("\\", "/") || entry.name;
+  let candidate = relativeName.replace(/^\/+/, "");
+  if (!candidate || candidate.includes("../")) candidate = entry.name;
+  if (!used.has(candidate)) {
+    used.add(candidate);
+    return candidate;
+  }
+  const extension = extname(candidate);
+  const stem = extension ? candidate.slice(0, -extension.length) : candidate;
+  for (let index = 2; ; index += 1) {
+    const next = `${stem}-${index}${extension}`;
+    if (!used.has(next)) {
+      used.add(next);
+      return next;
+    }
+  }
+}
+
+/**
+ * 把 fflate 的同步输出串行写入 Node Writable，并在每批 push 后暴露可等待的背压屏障。
+ * 超出 maxOutputBytes 时销毁输出流并让 flush 拒绝，调用方负责清理自己独占创建的路径。
+ */
+export function createAdvisorZipOutputSink(output: Writable, maxOutputBytes = MAX_UPLOAD_FILE_BYTES): {
+  enqueue(chunk: Uint8Array, final: boolean): void;
+  flush(): Promise<void>;
+} {
+  let bytes = 0;
+  let pending = Promise.resolve();
+  let ended = false;
+  const waitForDrain = (): Promise<void> => new Promise((resolveDrain, rejectDrain) => {
+    const cleanup = () => {
+      output.off("drain", onDrain);
+      output.off("error", onError);
+      output.off("close", onClose);
+    };
+    const onDrain = () => { cleanup(); resolveDrain(); };
+    const onError = (error: Error) => { cleanup(); rejectDrain(error); };
+    const onClose = () => { cleanup(); rejectDrain(new Error("Advisor ZIP output closed during backpressure")); };
+    output.once("drain", onDrain);
+    output.once("error", onError);
+    output.once("close", onClose);
+  });
+  return {
+    enqueue(chunk, final) {
+      const copy = Buffer.from(chunk);
+      pending = pending.then(async () => {
+        if (ended) throw new Error("Advisor ZIP output received bytes after its final chunk");
+        if (bytes + copy.length > maxOutputBytes) {
+          ended = true;
+          output.destroy();
+          throw new Error("Advisor streamed ZIP output exceeds the 512 MB browser upload limit");
+        }
+        bytes += copy.length;
+        if (copy.length > 0 && !output.write(copy)) await waitForDrain();
+        if (final) {
+          ended = true;
+          output.end();
+        }
+      });
+    },
+    async flush() {
+      await pending;
+    },
+  };
+}
+
+/** 创建一个独占拥有、受流式输出上限保护的 Advisor ZIP；失败时只删除本函数创建的 archive。 */
+export async function createAdvisorZipArchive(
+  entries: readonly AdvisorAttachmentEntry[],
+  outputPath: string,
+  maxOutputBytes = MAX_UPLOAD_FILE_BYTES,
+): Promise<void> {
+  // 先取得 create-exclusive FileHandle 才拥有该路径；EEXIST 表示竞争者拥有它，绝不能清理。
+  const handle = await open(outputPath, "wx", 0o600);
+  try {
+    await new Promise<void>((resolveZip, rejectZip) => {
+      const output = handle.createWriteStream({ autoClose: true });
+      let settled = false;
+      let outputFinished = false;
+      let outputError: Error | undefined;
+      let archiveError: Error | undefined;
+      let rejectOutputFailure!: (error: Error) => void;
+      const outputFailure = new Promise<never>((_resolve, reject) => { rejectOutputFailure = reject; });
+      // producer 可能正在读下一个块；先挂 catch 防止 error 事件在下一次 race 前形成未处理拒绝。
+      void outputFailure.catch(() => {});
+      const finish = (error?: Error) => {
+        if (settled) return;
+        settled = true;
+        if (error) rejectZip(error);
+        else resolveZip();
+      };
+      // Windows 上 error 先于 close；等句柄关闭后再把失败交给外层删除 partial archive。
+      output.once("error", error => {
+        outputError = error;
+        rejectOutputFailure(error);
+      });
+      output.once("finish", () => { outputFinished = true; });
+      output.once("close", () => {
+        if (outputError || archiveError) finish(outputError ?? archiveError);
+        else if (outputFinished) finish();
+        else finish(new Error("Advisor ZIP output closed before completion"));
+      });
+      const sink = createAdvisorZipOutputSink(output, maxOutputBytes);
+      const flushSink = () => Promise.race([sink.flush(), outputFailure]);
+      const zip = new Zip((error, chunk, final) => {
+        if (error) {
+          archiveError = error;
+          output.destroy();
+          return;
+        }
+        sink.enqueue(chunk, final);
+      });
+      const used = new Set<string>();
+      void (async () => {
+        try {
+          for (const entry of entries) {
+            const stream = new ZipPassThrough(zipEntryName(entry, used));
+            zip.add(stream);
+            for await (const chunk of createReadStream(entry.path, { highWaterMark: 256 * 1024 })) {
+              stream.push(new Uint8Array(chunk as Buffer), false);
+              // fflate 同步产生字节；每次 push 后等 drain，避免把整个大文件积压进内存。
+              await flushSink();
+            }
+            stream.push(new Uint8Array(), true);
+            await flushSink();
+          }
+          zip.end();
+          await flushSink();
+        } catch (error) {
+          archiveError = error instanceof Error ? error : new Error(String(error));
+          output.destroy();
+        }
+      })();
+    });
+  } catch (error) {
+    await handle.close().catch(() => {});
+    rmSync(outputPath, { force: true });
+    throw error;
+  }
+}
+
+export async function prepareAdvisorAttachments(options: {
+  paths: readonly string[];
+  roots: readonly string[];
+  stagingDirectory: string;
+  agentId: string;
+}): Promise<PreparedAdvisorAttachments> {
+  if (options.paths.length === 0) return { files: [], release() {} };
+  const cwd = canonicalWorkspaceRoots(options.roots)[0]!;
+  const entries: AdvisorAttachmentEntry[] = [];
+  let selectedDirectory = false;
+  for (const supplied of options.paths) {
+    const path = resolveLocalReadPath(supplied, cwd);
+    const directory = lstatSync(path).isDirectory();
+    selectedDirectory ||= directory;
+    collectEntries(path, directory ? path : dirname(path), entries);
+  }
+  if (entries.length === 0) throw new Error("Advisor attachment selection contains no regular files");
+  const aggregateBytes = entries.reduce((total, entry) => total + entry.size, 0);
+  if (!Number.isSafeInteger(aggregateBytes) || aggregateBytes > MAX_UPLOAD_FILE_BYTES) {
+    throw new Error("Advisor attachment aggregate exceeds the 512 MB browser upload limit");
+  }
+
+  if (!selectedDirectory && entries.length <= 10) {
+    return {
+      files: entries.map(entry => ({
+        path: entry.path,
+        name: entry.name,
+        mimeType: mimeType(entry.path),
+        size: entry.size,
+      })),
+      release() {},
+    };
+  }
+
+  if (!isAbsolute(options.stagingDirectory)) throw new Error("Advisor staging directory must be absolute");
+  mkdirSync(options.stagingDirectory, { recursive: true, mode: 0o700 });
+  const safeAgent = options.agentId.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "advisor";
+  const zipPath = resolve(options.stagingDirectory, `${safeAgent}.zip`);
+  if (existsSync(zipPath)) throw new Error("Advisor staging archive already exists");
+  let ownsArchive = false;
+  try {
+    await createAdvisorZipArchive(entries, zipPath);
+    ownsArchive = true;
+    const size = statSync(zipPath).size;
+    return {
+      files: [{ path: zipPath, name: basename(zipPath), mimeType: "application/zip", size }],
+      release() { rmSync(zipPath, { force: true }); },
+    };
+  } catch (error) {
+    // 只清理由本次调用独占创建的确定路径；同目录其他文件不属于 Advisor。
+    if (ownsArchive) rmSync(zipPath, { force: true });
+    throw error;
+  }
+}
diff --git a/src/adapters/chatgpt-web/advisor/job-manager.ts b/src/adapters/chatgpt-web/advisor/job-manager.ts
new file mode 100644
index 0000000..d447944
--- /dev/null
+++ b/src/adapters/chatgpt-web/advisor/job-manager.ts
@@ -0,0 +1,318 @@
+import { randomBytes } from "node:crypto";
+import type { ChatGptDownloadedArtifact } from "../browser-worker";
+import type { ChatGptWebPromptFile } from "../prompt";
+
+export type AdvisorJobStatus = "queued" | "running" | "idle" | "cancelling" | "error";
+
+export interface AdvisorRuntimeRequest {
+  agentId: string;
+  prompt: string;
+  roots: string[];
+  outputDirectory: string;
+  attachments: ChatGptWebPromptFile[];
+  expectedOutputs?: string[];
+  continuation?: boolean;
+  signal: AbortSignal;
+  onQueuePosition(position: number): void;
+  onCommentary?(text: string, continuation?: boolean): void;
+  onTextDelta?(text: string): void;
+}
+
+export interface AdvisorRuntime {
+  run(request: AdvisorRuntimeRequest): Promise<{ text: string; artifacts: ChatGptDownloadedArtifact[] }>;
+  release(agentId: string): Promise<boolean>;
+  close?(): Promise<void>;
+}
+
+export interface AdvisorJobEvent {
+  cursor: number;
+  type: "status" | "queue" | "commentary" | "text" | "answer" | "artifacts" | "cancelled" | "error";
+  at: string;
+  value?: unknown;
+}
+
+export interface AdvisorJobSnapshot {
+  agentId: string;
+  status: AdvisorJobStatus;
+  queuePosition?: number;
+  cursor: number;
+  createdAt: string;
+  updatedAt: string;
+  events: AdvisorJobEvent[];
+  error?: string;
+}
+
+interface AdvisorJob {
+  agentId: string;
+  status: AdvisorJobStatus;
+  queuePosition?: number;
+  cursor: number;
+  createdAt: string;
+  updatedAt: string;
+  events: AdvisorJobEvent[];
+  roots: string[];
+  outputDirectory: string;
+  controller?: AbortController;
+  operation?: Promise<void>;
+  idleTimer?: ReturnType<typeof setTimeout>;
+  error?: string;
+}
+
+function agentId(): string {
+  return `advisor_${randomBytes(18).toString("base64url")}`;
+}
+
+export class AdvisorJobManager {
+  private readonly jobs = new Map<string, AdvisorJob>();
+  private readonly waiters = new Set<() => void>();
+  private readonly maxAgents: number;
+  private readonly idleTimeoutMs: number;
+
+  constructor(private readonly options: {
+    runtime: AdvisorRuntime;
+    maxAgents?: number;
+    idleTimeoutMs?: number;
+  }) {
+    this.maxAgents = options.maxAgents ?? 5;
+    this.idleTimeoutMs = options.idleTimeoutMs ?? 30 * 60_000;
+  }
+
+  spawn(input: {
+    prompt: string;
+    roots: string[];
+    outputDirectory: string;
+    attachments: ChatGptWebPromptFile[];
+    expectedOutputs?: string[];
+    releaseAttachments?: () => void;
+  }): AdvisorJobSnapshot {
+    if (this.jobs.size >= this.maxAgents) {
+      throw new Error(`One Codex task may keep at most ${this.maxAgents} Pro advisors`);
+    }
+    const now = new Date().toISOString();
+    const job: AdvisorJob = {
+      agentId: agentId(),
+      status: "running",
+      cursor: 0,
+      createdAt: now,
+      updatedAt: now,
+      events: [],
+      roots: [...input.roots],
+      outputDirectory: input.outputDirectory,
+    };
+    this.jobs.set(job.agentId, job);
+    this.append(job, "status", "running");
+    this.start(job, input.prompt, input.attachments, input.expectedOutputs, input.releaseAttachments, false);
+    return this.snapshot(job, 0);
+  }
+
+  send(agentIdValue: string, input: {
+    prompt: string;
+    attachments: ChatGptWebPromptFile[];
+    expectedOutputs?: string[];
+    releaseAttachments?: () => void;
+  }): AdvisorJobSnapshot {
+    const job = this.job(agentIdValue);
+    if (job.status !== "idle") throw new Error(`Pro advisor ${agentIdValue} is not idle`);
+    if (job.idleTimer) clearTimeout(job.idleTimer);
+    job.idleTimer = undefined;
+    job.error = undefined;
+    job.status = "running";
+    this.append(job, "status", "running");
+    this.start(job, input.prompt, input.attachments, input.expectedOutputs, input.releaseAttachments, true);
+    return this.snapshot(job, 0);
+  }
+
+  async cancel(agentIdValue: string): Promise<AdvisorJobSnapshot> {
+    const job = this.job(agentIdValue);
+    if (!job.controller || !job.operation) return this.snapshot(job, 0);
+    job.status = "cancelling";
+    this.append(job, "status", "cancelling");
+    job.controller.abort();
+    await job.operation.catch(() => {});
+    if (this.jobs.has(job.agentId) && job.status === "cancelling") {
+      job.status = "idle";
+      this.append(job, "cancelled");
+      this.armIdleTimer(job);
+    }
+    return this.snapshot(job, 0);
+  }
+
+  async close(agentIdValue: string): Promise<{ closed: boolean }> {
+    const job = this.job(agentIdValue);
+    try {
+      if (job.controller && job.operation) {
+        job.controller.abort();
+        await job.operation.catch(() => {});
+      }
+      if (job.idleTimer) clearTimeout(job.idleTimer);
+      await this.options.runtime.release(job.agentId);
+      return { closed: true };
+    } finally {
+      // Launcher release 失败仍要移除本地 job；否则一次外部清理故障会把五槽池永久占满。
+      if (job.idleTimer) clearTimeout(job.idleTimer);
+      this.jobs.delete(job.agentId);
+      this.notify();
+    }
+  }
+
+  list(): AdvisorJobSnapshot[] {
+    return [...this.jobs.values()].map(job => this.snapshot(job, job.cursor));
+  }
+
+  async closeAll(): Promise<void> {
+    const results = await Promise.allSettled([...this.jobs.keys()].map(agentIdValue => this.close(agentIdValue)));
+    const failures = results
+      .filter((result): result is PromiseRejectedResult => result.status === "rejected")
+      .map(result => result.reason);
+    try {
+      // 即使某个 retained release 失败，也必须继续关闭共享 helper/worker。
+      await this.options.runtime.close?.();
+    } catch (error) {
+      failures.push(error);
+    }
+    if (failures.length > 0) {
+      throw new AggregateError(failures, `${failures.length} Pro advisor cleanup operation(s) failed`);
+    }
+  }
+
+  async wait(
+    targets: Array<{ agentId: string; afterCursor?: number }>,
+    timeoutMs = 30_000,
+  ): Promise<{ agents: AdvisorJobSnapshot[]; timedOut: boolean }> {
+    if (targets.length === 0 || targets.length > this.maxAgents) throw new Error("Advisor wait targets are invalid");
+    if (!Number.isInteger(timeoutMs) || timeoutMs < 0 || timeoutMs > 600 * 60_000) {
+      throw new Error("Advisor wait timeout must be between 0 and 36000000ms");
+    }
+    const snapshots = () => targets.map(target => {
+      const after = target.afterCursor ?? 0;
+      if (!Number.isInteger(after) || after < 0) throw new Error("Advisor wait cursor is invalid");
+      return this.snapshot(this.job(target.agentId), after);
+    });
+    const ready = () => snapshots().some(snapshot => snapshot.events.length > 0
+      || snapshot.status === "idle" || snapshot.status === "error");
+    if (ready() || timeoutMs === 0) return { agents: snapshots(), timedOut: !ready() };
+
+    let timedOut = false;
+    await new Promise<void>(resolveWait => {
+      let settled = false;
+      const finish = (timeout: boolean) => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        this.waiters.delete(onChange);
+        timedOut = timeout;
+        resolveWait();
+      };
+      const onChange = () => { if (ready()) finish(false); };
+      const timer = setTimeout(() => finish(true), timeoutMs);
+      this.waiters.add(onChange);
+    });
+    return { agents: snapshots(), timedOut };
+  }
+
+  private start(
+    job: AdvisorJob,
+    prompt: string,
+    attachments: ChatGptWebPromptFile[],
+    expectedOutputs?: string[],
+    releaseAttachments: () => void = () => {},
+    continuation = false,
+  ): void {
+    const controller = new AbortController();
+    job.controller = controller;
+    let operation!: Promise<void>;
+    operation = (async () => {
+      try {
+        const result = await this.options.runtime.run({
+          agentId: job.agentId,
+          prompt,
+          roots: [...job.roots],
+          outputDirectory: job.outputDirectory,
+          attachments,
+          ...(expectedOutputs ? { expectedOutputs } : {}),
+          ...(continuation ? { continuation: true } : {}),
+          signal: controller.signal,
+          onQueuePosition: position => {
+            if (controller.signal.aborted) return;
+            job.status = "queued";
+            job.queuePosition = position;
+            this.append(job, "queue", position);
+          },
+          onCommentary: (text, continuation) => this.append(job, "commentary", { text, continuation: continuation === true }),
+          onTextDelta: text => this.append(job, "text", text),
+        });
+        if (controller.signal.aborted) {
+          job.status = "idle";
+          job.queuePosition = undefined;
+          this.append(job, "cancelled");
+        } else {
+          job.status = "idle";
+          job.queuePosition = undefined;
+          this.append(job, "answer", result.text);
+          if (result.artifacts.length > 0) this.append(job, "artifacts", result.artifacts);
+        }
+        this.armIdleTimer(job);
+      } catch (error) {
+        if (controller.signal.aborted) {
+          job.status = "idle";
+          job.queuePosition = undefined;
+          this.append(job, "cancelled");
+          this.armIdleTimer(job);
+        } else {
+          job.status = "error";
+          job.queuePosition = undefined;
+          job.error = error instanceof Error ? error.message : String(error);
+          this.append(job, "error", job.error);
+        }
+      } finally {
+        releaseAttachments();
+        if (job.controller === controller) job.controller = undefined;
+        if (job.operation === operation) job.operation = undefined;
+      }
+    })();
+    job.operation = operation;
+  }
+
+  private append(job: AdvisorJob, type: AdvisorJobEvent["type"], value?: unknown): void {
+    job.cursor += 1;
+    job.updatedAt = new Date().toISOString();
+    job.events.push({ cursor: job.cursor, type, at: job.updatedAt, ...(value !== undefined ? { value } : {}) });
+    if (job.events.length > 500) job.events.splice(0, job.events.length - 500);
+    this.notify();
+  }
+
+  private armIdleTimer(job: AdvisorJob): void {
+    if (job.idleTimer) clearTimeout(job.idleTimer);
+    job.idleTimer = setTimeout(() => {
+      void this.close(job.agentId).catch(error => {
+        job.status = "error";
+        job.error = error instanceof Error ? error.message : String(error);
+        this.append(job, "error", job.error);
+      });
+    }, this.idleTimeoutMs);
+    job.idleTimer.unref?.();
+  }
+
+  private snapshot(job: AdvisorJob, afterCursor: number): AdvisorJobSnapshot {
+    return {
+      agentId: job.agentId,
+      status: job.status,
+      ...(job.queuePosition !== undefined ? { queuePosition: job.queuePosition } : {}),
+      cursor: job.cursor,
+      createdAt: job.createdAt,
+      updatedAt: job.updatedAt,
+      events: job.events.filter(event => event.cursor > afterCursor),
+      ...(job.error ? { error: job.error } : {}),
+    };
+  }
+
+  private job(agentIdValue: string): AdvisorJob {
+    const job = this.jobs.get(agentIdValue);
+    if (!job) throw new Error(`Unknown Pro advisor: ${agentIdValue}`);
+    return job;
+  }
+
+  private notify(): void {
+    for (const waiter of [...this.waiters]) waiter();
+  }
+}
diff --git a/src/adapters/chatgpt-web/advisor/mcp-server.ts b/src/adapters/chatgpt-web/advisor/mcp-server.ts
new file mode 100644
index 0000000..eb98258
--- /dev/null
+++ b/src/adapters/chatgpt-web/advisor/mcp-server.ts
@@ -0,0 +1,358 @@
+import { randomBytes } from "node:crypto";
+import { existsSync, mkdirSync, realpathSync, statSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { isAbsolute, join, resolve } from "node:path";
+import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
+import * as z from "zod/v4";
+import { getConfigDir } from "../../../config";
+import type { AdvisorJobManager, AdvisorJobSnapshot } from "./job-manager";
+import { AdvisorJobManager as JobManager } from "./job-manager";
+import { prepareAdvisorAttachments } from "./files";
+import { ChatGptProAdvisorRuntime } from "./runtime";
+import { accessibleLocalFilesystemRoots, canonicalWorkspaceRoots, resolveLocalReadPath } from "./workspace";
+
+interface AdvisorManagerLike {
+  spawn(value: Parameters<AdvisorJobManager["spawn"]>[0]): AdvisorJobSnapshot;
+  send(agentId: string, value: Parameters<AdvisorJobManager["send"]>[1]): AdvisorJobSnapshot;
+  wait(targets: Parameters<AdvisorJobManager["wait"]>[0], timeoutMs?: number): ReturnType<AdvisorJobManager["wait"]>;
+  cancel(agentId: string): ReturnType<AdvisorJobManager["cancel"]>;
+  close(agentId: string): ReturnType<AdvisorJobManager["close"]>;
+  list(): AdvisorJobSnapshot[];
+  closeAll(): Promise<void>;
+}
+
+interface AdvisorMcpEventSource {
+  once(event: string, listener: () => void): unknown;
+  off(event: string, listener: () => void): unknown;
+}
+
+function result(value: Record<string, unknown>, isError = false) {
+  return {
+    content: [{ type: "text" as const, text: JSON.stringify(value) }],
+    structuredContent: value,
+    ...(isError ? { isError: true } : {}),
+  };
+}
+
+function stagingId(): string {
+  return `advisor-upload-${randomBytes(8).toString("hex")}`;
+}
+
+function object(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? value as Record<string, unknown>
+    : undefined;
+}
+
+/**
+ * Codex CLI 0.147 does not always implement MCP roots/list. Its server-owned tool metadata still
+ * carries the canonical turn/workspace binding; require the plugin and thread identities to agree
+ * before using those paths, so a model argument can never widen filesystem authority.
+ */
+function trustedCodexAdvisorMetadata(extra: unknown): Record<string, unknown> | undefined {
+  const scope = object(extra);
+  const meta = object(scope?._meta);
+  if (!meta) return undefined;
+  const pluginId = typeof meta.plugin_id === "string" ? meta.plugin_id : "";
+  const threadId = typeof meta.threadId === "string" ? meta.threadId : "";
+  if (!/^chatgpt-pro-advisor(?:@|$)/.test(pluginId) || !threadId) return undefined;
+  const raw = meta["x-codex-turn-metadata"];
+  let metadata: Record<string, unknown> | undefined;
+  if (typeof raw === "string") {
+    try { metadata = object(JSON.parse(raw)); }
+    catch { return undefined; }
+  } else metadata = object(raw);
+  if (!metadata
+    || metadata.thread_id !== threadId
+    || typeof metadata.turn_id !== "string"
+    || !metadata.turn_id
+    || metadata.sandbox === undefined) return undefined;
+  return metadata;
+}
+
+export function codexWorkspaceRootsFromScope(extra: unknown): string[] {
+  const metadata = trustedCodexAdvisorMetadata(extra);
+  if (!metadata) return [];
+  const workspaces = object(metadata.workspaces);
+  if (!workspaces) return [];
+  const paths = Object.keys(workspaces);
+  if (paths.length === 0 || paths.some(path => !isAbsolute(path))) return [];
+  return [...new Map(paths.map(path => [
+    process.platform === "win32" ? resolve(path).toLowerCase() : resolve(path),
+    resolve(path),
+  ])).values()];
+}
+
+export function createChatGptProAdvisorMcpServer(options: {
+  manager?: AdvisorManagerLike;
+  rootProvider?: (extra?: unknown) => Promise<string[]>;
+  stagingDirectory?: string;
+} = {}): McpServer {
+  const manager = options.manager ?? new JobManager({ runtime: new ChatGptProAdvisorRuntime() });
+  const server = new McpServer({ name: "chatgpt-pro-advisor", version: "1.0.0" });
+  const rootProvider = options.rootProvider ?? (async (extra?: unknown) => {
+    let listed: string[] = [];
+    try {
+      const response = await server.server.listRoots();
+      listed = response.roots.map(root => {
+        const parsed = new URL(root.uri);
+        if (parsed.protocol !== "file:") throw new Error("ChatGPT Pro Advisor accepts filesystem MCP roots only");
+        return fileURLToPath(parsed);
+      });
+    } catch {
+      // Codex CLI 0.147 may omit the optional roots capability entirely. The server-owned turn
+      // metadata below remains the authority; never fall back to process.cwd() or model arguments.
+    }
+    return listed.length > 0 ? listed : codexWorkspaceRootsFromScope(extra);
+  });
+  const stagingDirectory = options.stagingDirectory ?? join(getConfigDir(), "runtime", "advisor-staging");
+
+  const scopeSummary = (extra: unknown) => {
+    if (!extra || typeof extra !== "object" || Array.isArray(extra)) return "scope=none";
+    const record = extra as Record<string, unknown>;
+    const keys = Object.keys(record).sort();
+    const nestedKeys = (value: unknown) => value && typeof value === "object" && !Array.isArray(value)
+      ? Object.keys(value as Record<string, unknown>).sort()
+      : [];
+    const meta = record._meta && typeof record._meta === "object" && !Array.isArray(record._meta)
+      ? record._meta as Record<string, unknown>
+      : {};
+    const rawTurnMetadata = meta["x-codex-turn-metadata"];
+    let turnMetadata: unknown = rawTurnMetadata;
+    if (typeof rawTurnMetadata === "string") {
+      try { turnMetadata = JSON.parse(rawTurnMetadata); }
+      catch { turnMetadata = undefined; }
+    }
+    const turnRecord = turnMetadata && typeof turnMetadata === "object" && !Array.isArray(turnMetadata)
+      ? turnMetadata as Record<string, unknown>
+      : undefined;
+    const workspaces = turnRecord?.workspaces && typeof turnRecord.workspaces === "object" && !Array.isArray(turnRecord.workspaces)
+      ? turnRecord.workspaces as Record<string, unknown>
+      : undefined;
+    return `scopeKeys=${keys.join(",") || "none"};metaKeys=${nestedKeys(meta).join(",") || "none"};requestInfoKeys=${nestedKeys(record.requestInfo).join(",") || "none"};turnMetadataType=${typeof rawTurnMetadata};turnMetadataKeys=${nestedKeys(turnRecord).join(",") || "none"};workspaceCount=${workspaces ? Object.keys(workspaces).length : 0}`;
+  };
+  const scope = async (extra?: unknown) => {
+    const supplied = await rootProvider(extra);
+    if (supplied.length === 0 && !trustedCodexAdvisorMetadata(extra)) {
+      throw new Error(`Advisor requires at least one current Codex workspace root (${scopeSummary(extra)})`);
+    }
+    const workspaceRoots = supplied.length > 0 ? canonicalWorkspaceRoots(supplied) : [];
+    const defaultDirectory = workspaceRoots[0] ?? process.cwd();
+    return {
+      defaultDirectory,
+      readRoots: accessibleLocalFilesystemRoots(workspaceRoots.length > 0 ? workspaceRoots : [defaultDirectory]),
+    };
+  };
+  const outputDirectory = (value: string | undefined, defaultDirectory: string) => {
+    const requested = value?.trim() || defaultDirectory;
+    const candidate = isAbsolute(requested) ? resolve(requested) : resolve(defaultDirectory, requested);
+    if (!existsSync(candidate)) mkdirSync(candidate, { recursive: true, mode: 0o700 });
+    const path = realpathSync.native(candidate);
+    if (!statSync(path).isDirectory()) throw new Error("Advisor output_directory must be an existing directory");
+    return path;
+  };
+
+  server.registerTool(
+    "spawn_pro_agent",
+    {
+      title: "Start a ChatGPT Pro advisor",
+      description: "Start one explicit GPT Pro read-only advisor in an independent Temporary Chat. Returns immediately with an agent id and queue status.",
+      inputSchema: {
+        prompt: z.string().min(1).max(100_000),
+        attachment_paths: z.array(z.string().min(1).max(16_384)).max(500).default([]),
+        expected_outputs: z.array(z.string().min(1).max(2_000)).max(20).optional(),
+        output_directory: z.string().min(1).max(16_384).optional(),
+      },
+      annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: false, openWorldHint: true },
+    },
+    async ({ prompt, attachment_paths, expected_outputs, output_directory }, extra) => {
+      const currentScope = await scope(extra);
+      const prepared = await prepareAdvisorAttachments({
+        paths: attachment_paths,
+        roots: [currentScope.defaultDirectory, ...currentScope.readRoots],
+        stagingDirectory,
+        agentId: stagingId(),
+      });
+      try {
+        return result(manager.spawn({
+          prompt,
+          roots: currentScope.readRoots,
+          outputDirectory: outputDirectory(output_directory, currentScope.defaultDirectory),
+          attachments: prepared.files,
+          ...(expected_outputs ? { expectedOutputs: expected_outputs } : {}),
+          releaseAttachments: prepared.release,
+        }) as unknown as Record<string, unknown>);
+      } catch (error) {
+        prepared.release();
+        throw error;
+      }
+    },
+  );
+
+  server.registerTool(
+    "send_message_to_pro_agent",
+    {
+      title: "Follow up with a ChatGPT Pro advisor",
+      description: "Send a concise follow-up and optional validated files to an idle Pro advisor while preserving its Temporary Chat.",
+      inputSchema: {
+        agent_id: z.string().regex(/^advisor_[A-Za-z0-9_-]{10,128}$/),
+        prompt: z.string().min(1).max(100_000),
+        attachment_paths: z.array(z.string().min(1).max(16_384)).max(500).default([]),
+        expected_outputs: z.array(z.string().min(1).max(2_000)).max(20).optional(),
+      },
+      annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: false, openWorldHint: true },
+    },
+    async ({ agent_id, prompt, attachment_paths, expected_outputs }, extra) => {
+      const currentScope = await scope(extra);
+      const prepared = await prepareAdvisorAttachments({
+        paths: attachment_paths,
+        roots: [currentScope.defaultDirectory, ...currentScope.readRoots],
+        stagingDirectory,
+        agentId: stagingId(),
+      });
+      try {
+        return result(manager.send(agent_id, {
+          prompt,
+          attachments: prepared.files,
+          ...(expected_outputs ? { expectedOutputs: expected_outputs } : {}),
+          releaseAttachments: prepared.release,
+        }) as unknown as Record<string, unknown>);
+      } catch (error) {
+        prepared.release();
+        throw error;
+      }
+    },
+  );
+
+  server.registerTool(
+    "wait_pro_agents",
+    {
+      title: "Wait for ChatGPT Pro advisors",
+      description: "Wait until one selected Pro advisor emits new events, becomes idle, or fails. Cursors prevent repeated output.",
+      inputSchema: {
+        agents: z.array(z.object({
+          agent_id: z.string().regex(/^advisor_[A-Za-z0-9_-]{10,128}$/),
+          after_cursor: z.number().int().min(0).optional(),
+        })).min(1).max(5),
+        timeout_ms: z.number().int().min(0).max(600 * 60_000).default(600 * 60_000),
+      },
+      annotations: { readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
+    },
+    async ({ agents, timeout_ms }) => result(await manager.wait(
+      agents.map(agent => ({ agentId: agent.agent_id, ...(agent.after_cursor !== undefined ? { afterCursor: agent.after_cursor } : {}) })),
+      timeout_ms,
+    ) as unknown as Record<string, unknown>),
+  );
+
+  server.registerTool(
+    "cancel_pro_agent",
+    {
+      title: "Cancel a ChatGPT Pro advisor turn",
+      description: "Stop the current Pro generation while keeping its Temporary Chat available for a follow-up.",
+      inputSchema: { agent_id: z.string().regex(/^advisor_[A-Za-z0-9_-]{10,128}$/) },
+      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: true, openWorldHint: true },
+    },
+    async ({ agent_id }) => result(await manager.cancel(agent_id) as unknown as Record<string, unknown>),
+  );
+
+  server.registerTool(
+    "close_pro_agent",
+    {
+      title: "Close a ChatGPT Pro advisor",
+      description: "Close one advisor Temporary Chat and release its shared WebGPT tab slot.",
+      inputSchema: { agent_id: z.string().regex(/^advisor_[A-Za-z0-9_-]{10,128}$/) },
+      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: true },
+    },
+    async ({ agent_id }) => result(await manager.close(agent_id) as unknown as Record<string, unknown>),
+  );
+
+  server.registerTool(
+    "list_pro_agents",
+    {
+      title: "List ChatGPT Pro advisors",
+      description: "List the Pro advisors owned by this Codex task and their current lifecycle state.",
+      inputSchema: {},
+      annotations: { readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
+    },
+    async () => result({ agents: manager.list() }),
+  );
+
+  return server;
+}
+
+export async function runChatGptProAdvisorMcpServer(options: {
+  manager?: AdvisorManagerLike;
+  transport?: StdioServerTransport;
+  input?: AdvisorMcpEventSource;
+  processEvents?: AdvisorMcpEventSource;
+  exit?: (code: number) => void;
+} = {}): Promise<void> {
+  const manager = options.manager ?? new JobManager({ runtime: new ChatGptProAdvisorRuntime() });
+  const server = createChatGptProAdvisorMcpServer({ manager });
+  const transport = options.transport ?? new StdioServerTransport();
+  const input = (options.input ?? process.stdin) as AdvisorMcpEventSource;
+  const processEvents = (options.processEvents ?? process) as AdvisorMcpEventSource;
+  const exit = options.exit ?? (code => process.exit(code));
+  let cleanupPromise: Promise<void> | undefined;
+  let cleanupErrorReported = false;
+  let terminationRequested = false;
+
+  const reportCleanupError = (error: unknown) => {
+    if (cleanupErrorReported) return;
+    cleanupErrorReported = true;
+    console.error(`[chatgpt-pro-advisor] MCP cleanup failed: ${error instanceof Error ? error.message : String(error)}`);
+  };
+  const onInputClosed = () => { void cleanup().catch(reportCleanupError); };
+  const requestTermination = (code: number) => {
+    if (terminationRequested) return;
+    terminationRequested = true;
+    void cleanup().then(
+      () => exit(code),
+      error => { reportCleanupError(error); exit(code); },
+    );
+  };
+  const onSigint = () => requestTermination(130);
+  const onSigterm = () => requestTermination(143);
+  const detach = () => {
+    input.off("end", onInputClosed);
+    input.off("close", onInputClosed);
+    processEvents.off("SIGINT", onSigint);
+    processEvents.off("SIGTERM", onSigterm);
+  };
+  const cleanup = (): Promise<void> => {
+    if (cleanupPromise) return cleanupPromise;
+    cleanupPromise = (async () => {
+      detach();
+      // 先让 manager 中止运行任务、撤销 broker token 并按 helper owner 释放 retained tab，
+      // 再关闭 MCP transport；release 失败也不能跳过 transport，错误在全部尝试后统一报告。
+      const failures: unknown[] = [];
+      try {
+        await manager.closeAll();
+      } catch (error) {
+        failures.push(error);
+      }
+      try {
+        await server.close();
+      } catch (error) {
+        failures.push(error);
+      }
+      if (failures.length > 0) {
+        throw new AggregateError(failures, `${failures.length} Advisor MCP cleanup operation(s) failed`);
+      }
+    })();
+    return cleanupPromise;
+  };
+
+  input.once("end", onInputClosed);
+  input.once("close", onInputClosed);
+  processEvents.once("SIGINT", onSigint);
+  processEvents.once("SIGTERM", onSigterm);
+  transport.onclose = () => { void cleanup().catch(reportCleanupError); };
+  try {
+    await server.connect(transport);
+  } catch (error) {
+    await cleanup().catch(reportCleanupError);
+    throw error;
+  }
+}
diff --git a/src/adapters/chatgpt-web/advisor/prompt.ts b/src/adapters/chatgpt-web/advisor/prompt.ts
new file mode 100644
index 0000000..02365e9
--- /dev/null
+++ b/src/adapters/chatgpt-web/advisor/prompt.ts
@@ -0,0 +1,50 @@
+const CODEX_CONTEXT_MARKERS = [
+  "<environment_context>",
+  "<skills_instructions>",
+  "<permissions instructions>",
+  "<app-context>",
+  "<codex_delegation>",
+  "# AGENTS.md instructions",
+] as const;
+
+export interface AdvisorPromptInput {
+  brief: string;
+  turnToken: string;
+  attachments: Array<{ name: string; size: number }>;
+  expectedOutputs?: string[];
+}
+
+export function compileAdvisorPrompt(input: AdvisorPromptInput): string {
+  const brief = input.brief.trim();
+  if (!brief || brief.length > 100_000) throw new Error("Advisor brief must contain 1 to 100000 characters");
+  if (CODEX_CONTEXT_MARKERS.some(marker => brief.includes(marker))) {
+    throw new Error("Advisor brief contains a copied Codex context envelope");
+  }
+  if (!/^turn_[A-Za-z0-9_-]{20,256}$/.test(input.turnToken)) {
+    throw new Error("Advisor turn token is invalid");
+  }
+  const attachments = input.attachments.map(file => `- ${file.name} (${file.size} bytes)`);
+  const expected = (input.expectedOutputs ?? []).map(value => value.trim()).filter(Boolean);
+  return [
+    "You are the GPT Pro read-only advisor for one Codex task.",
+    "Analyze independently and return a concrete answer. Do not claim that you changed local files.",
+    "When local evidence is needed, use Codex Native2 only through codex_tool_inventory, codex_tool_call, or codex_view_image.",
+    "The bound environment exposes directory listing, stat, bounded file reading, bounded text search, image viewing, and one controlled deliver_artifact output channel.",
+    `Use this current read-only turn_token for every Codex Native2 call: ${input.turnToken}`,
+    "",
+    "## Task brief",
+    brief,
+    ...(attachments.length > 0 ? ["", "## Uploaded attachments", ...attachments] : []),
+    ...(expected.length > 0 ? ["", "## Expected outputs", ...expected.map(value => `- ${value}`)] : []),
+    "",
+    "For every requested downloadable deliverable, first use codex_tool_inventory, then call codex_tool_call with wire_name deliver_artifact and arguments filename, media_type, encoding=base64, and the complete base64 file bytes.",
+    "deliver_artifact is the preferred output path: it can only create a new workspace file and cannot overwrite existing files.",
+    "You may also use ChatGPT's file-generation environment to write the exact requested filename under /mnt/data/.",
+    "Include a clickable sandbox:/mnt/data/<filename> link for every completed file in the final answer.",
+    "If ChatGPT cannot expose a sandbox link, include this exact fallback block with the complete file bytes encoded as base64:",
+    "```codex-artifact",
+    '{"filename":"<filename>","media_type":"<mime>","encoding":"base64","data":"<base64 bytes>"}',
+    "```",
+    "Do not claim that a file was created unless a corresponding sandbox link or valid codex-artifact block is present.",
+  ].join("\n");
+}
diff --git a/src/adapters/chatgpt-web/advisor/read-only-tools.ts b/src/adapters/chatgpt-web/advisor/read-only-tools.ts
