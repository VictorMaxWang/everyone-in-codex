@@ -514,23 +516,70 @@ export class ChatGptRateLimitDialogController implements ChatGptRateLimitDialogO
   }
 }
 
-/** 新连接就绪后仍须停止并复查旧监控；获取期间出现的 cooldown 故障不能被换页掩盖。 */
+function attachChatGptRebindSecondaryFailure(
+  primary: unknown,
+  secondary: unknown,
+  message: string,
+): unknown {
+  if (!(primary instanceof Error)) return primary;
+  const previousCause = (primary as Error & { cause?: unknown }).cause;
+  Object.defineProperty(primary, "cause", {
+    configurable: true,
+    value: previousCause === undefined
+      ? secondary
+      : new AggregateError([previousCause, secondary], message),
+  });
+  return primary;
+}
+
+/** 所有重连路径都停止并复查旧监控；controller 故障优先于并发的 acquire/cleanup 次级错误。 */
 export async function acquireChatGptRebindAfterControllerStop<T>(
   controller: Pick<ChatGptRateLimitDialogController, "assertHealthy" | "stop"> | undefined,
   acquire: () => Promise<T>,
   discard: (acquired: T) => Promise<void>,
 ): Promise<T> {
-  controller?.assertHealthy();
-  const acquired = await acquire();
+  if (controller) {
+    try {
+      controller.assertHealthy();
+    } catch (controllerError) {
+      try {
+        await controller.stop(false);
+      } catch (stopError) {
+        attachChatGptRebindSecondaryFailure(
+          controllerError,
+          stopError,
+          "ChatGPT cooldown controller health check and stop both failed",
+        );
+      }
+      throw controllerError;
+    }
+  }
+  let acquired: T;
+  try {
+    acquired = await acquire();
+  } catch (acquisitionError) {
+    try {
+      await controller?.stop();
+    } catch (controllerError) {
+      throw attachChatGptRebindSecondaryFailure(
+        controllerError,
+        acquisitionError,
+        "ChatGPT cooldown controller and replacement acquisition both failed",
+      );
+    }
+    throw acquisitionError;
+  }
   try {
     await controller?.stop();
   } catch (error) {
     try {
       await discard(acquired);
     } catch (cleanupError) {
-      if (error instanceof Error) {
-        Object.defineProperty(error, "cause", { configurable: true, value: cleanupError });
-      }
+      attachChatGptRebindSecondaryFailure(
+        error,
+        cleanupError,
+        "ChatGPT cooldown controller and replacement cleanup both failed",
+      );
     }
     throw error;
   }
