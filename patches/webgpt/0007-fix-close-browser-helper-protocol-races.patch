+test("a dialog appearing during Send activation blocks Enter after authorization", async () => {
+  let dialogVisible = false;
+  let authorizationCalls = 0;
+  let releaseActivation!: () => void;
+  let activationStarted!: () => void;
+  const activation = new Promise<void>(resolve => { releaseActivation = resolve; });
+  const activationPending = new Promise<void>(resolve => { activationStarted = resolve; });
+  const pressed: string[] = [];
+  const send = crossChatGptIrreversibleSendBoundary(
+    sendBoundaryPage(() => dialogVisible),
+    { press: async (key: string) => { pressed.push(key); } } as never,
+    {
+      authorize: () => { authorizationCalls += 1; },
+      activate: () => {
+        activationStarted();
+        return activation;
+      },
+    },
+  );
+
+  await activationPending;
+  expect(authorizationCalls).toBe(1);
+  expect(pressed).toEqual([]);
+  dialogVisible = true;
+  releaseActivation();
+  await expect(send).rejects.toMatchObject({ code: "unexpected_chatgpt_dialog", retryable: false });
+  expect(pressed).toEqual([]);
+});
