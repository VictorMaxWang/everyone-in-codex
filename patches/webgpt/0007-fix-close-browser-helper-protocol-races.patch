+ * 将授权与真实 Enter 放在同一可执行边界；每段异步握手后都重新分类 dialog，避免等待窗口绕过发送前检查。
  */
 export async function crossChatGptIrreversibleSendBoundary(
   page: Page,
@@ -422,6 +422,8 @@ export async function crossChatGptIrreversibleSendBoundary(
   await lifecycle.authorize();
   await assertChatGptIrreversibleBoundaryClear(page, rateLimitObserver);
