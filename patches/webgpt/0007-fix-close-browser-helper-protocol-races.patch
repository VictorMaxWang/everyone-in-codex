+test("a cooldown failure remains authoritative when replacement acquisition also fails", async () => {
+  const controllerFailure = new Error("cooldown monitor failed during rejected acquisition");
+  const acquisitionFailure = new Error("replacement connection failed");
+  let failed = false;
+  let stopCalls = 0;
+  const controller = {
+    assertHealthy: () => { if (failed) throw controllerFailure; },
+    stop: async () => {
+      stopCalls += 1;
+      if (failed) throw controllerFailure;
+    },
+  };
+
+  await expect(acquireChatGptRebindAfterControllerStop(
+    controller,
+    async () => {
+      failed = true;
+      await Promise.resolve();
+      throw acquisitionFailure;
+    },
+    async () => { throw new Error("no replacement connection should be discarded"); },
+  )).rejects.toBe(controllerFailure);
+  expect(stopCalls).toBe(1);
+  expect(controllerFailure.cause).toBe(acquisitionFailure);
+});
+
+test("a preexisting cooldown failure stops the old controller before skipping acquisition", async () => {
+  const controllerFailure = new Error("cooldown monitor already failed");
+  let stopCalls = 0;
+  let acquireCalls = 0;
+  const controller = {
+    assertHealthy: () => { throw controllerFailure; },
+    stop: async (assertHealthy = true) => {
+      stopCalls += 1;
+      expect(assertHealthy).toBeFalse();
+    },
+  };
+
+  await expect(acquireChatGptRebindAfterControllerStop(
+    controller,
+    async () => { acquireCalls += 1; return "new-connection"; },
+    async () => {},
+  )).rejects.toBe(controllerFailure);
+  expect(stopCalls).toBe(1);
+  expect(acquireCalls).toBe(0);
+});
