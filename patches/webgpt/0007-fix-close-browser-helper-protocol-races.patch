--- a/src/adapters/chatgpt-web/browser-helper-protocol.ts
+++ b/src/adapters/chatgpt-web/browser-helper-protocol.ts
@@ -105,6 +105,21 @@ function parsePrepared(value: unknown): CompiledChatGptWebPrompt {
   if (typeof prepared.text !== "string" || !Array.isArray(prepared.images)) {
     throw new Error("Browser helper prepared prompt is invalid");
   }
+  const images = prepared.images.map((value): CompiledChatGptWebPrompt["images"][number] => {
+    const image = record(value, "prepared image");
+    assertKeys(image, ["ref", "imageUrl"], ["detail"]);
