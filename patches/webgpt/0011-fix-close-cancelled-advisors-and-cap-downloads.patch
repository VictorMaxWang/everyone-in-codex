+
+test("advisor removes a partial browser download that exceeds 20 MiB", async () => {
+  const module = await import("../src/adapters/chatgpt-web/advisor/artifacts");
+  const root = mkdtempSync(join(tmpdir(), "advisor-artifact-limit-"));
+  try {
+    const chunks = Array.from({ length: 21 }, () => Buffer.alloc(1024 * 1024));
+    await expect(module.saveAdvisorDownload({
+      suggestedFilename: () => "oversized.bin",
+      createReadStream: async () => Readable.from(chunks),
+    }, {
+      outputDirectory: root,
+      allowedRoots: [root],
+      agentId: "advisor_artifact_limit_123",
+    })).rejects.toThrow("exceeds 20 MB");
+    expect(readdirSync(root)).toEqual([]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
