diff --git a/src/adapters/chatgpt-web/browser-helper-navigation-retry.ts b/src/adapters/chatgpt-web/browser-helper-navigation-retry.ts
new file mode 100644
index 0000000..5ea56fd
--- /dev/null
+++ b/src/adapters/chatgpt-web/browser-helper-navigation-retry.ts
@@ -0,0 +1,124 @@
+import { ChatGptWebAdapterError } from "./adapter-error";
+import type { CompiledChatGptWebPrompt } from "./prompt";
+import { CHATGPT_TEMPORARY_CHAT_URL } from "../../chatgpt-session";
+
+export type ChatGptInitialNavigationNetworkCode =
+  | "ERR_CONNECTION_CLOSED"
+  | "ERR_PROXY_CONNECTION_FAILED"
+  | "ERR_NAME_NOT_RESOLVED";
+
+const initialNavigationNetworkCodes = new Set<ChatGptInitialNavigationNetworkCode>([
+  "ERR_CONNECTION_CLOSED",
+  "ERR_PROXY_CONNECTION_FAILED",
+  "ERR_NAME_NOT_RESOLVED",
+]);
+
+export class ChatGptInitialNavigationError extends ChatGptWebAdapterError {
+  readonly networkCode: ChatGptInitialNavigationNetworkCode;
+
+  constructor(networkCode: ChatGptInitialNavigationNetworkCode, cause: Error) {
+    super(`ChatGPT initial Temporary Chat navigation failed with ${networkCode}`, {
+      status: 502,
+      errorType: "server_error",
+      code: "chatgpt_initial_navigation_failed",
+      retryable: true,
+    });
+    Object.defineProperty(this, "cause", { configurable: true, value: cause });
+    this.networkCode = networkCode;
+  }
+}
+
+export function brandChatGptInitialNavigationError(
+  error: unknown,
+): ChatGptInitialNavigationError | undefined {
+  const cause = error instanceof Error ? error : new Error(String(error));
+  const matches = [...cause.message.matchAll(/(?:^|[^A-Z0-9_])(ERR_[A-Z0-9_]+)(?=$|[^A-Z0-9_])/g)]
+    .map(match => match[1]!);
+  const uniqueCodes = [...new Set(matches)];
+  if (uniqueCodes.length !== 1) return undefined;
+  const [networkCode] = uniqueCodes;
+  if (!initialNavigationNetworkCodes.has(networkCode as ChatGptInitialNavigationNetworkCode)) return undefined;
+  return new ChatGptInitialNavigationError(networkCode as ChatGptInitialNavigationNetworkCode, cause);
+}
+
+export async function navigateChatGptInitialTemporaryChat(page: {
+  goto: (url: string, options: { waitUntil: "domcontentloaded"; timeout: number }) => Promise<unknown>;
+}): Promise<void> {
+  try {
+    await page.goto(CHATGPT_TEMPORARY_CHAT_URL, {
+      waitUntil: "domcontentloaded",
+      timeout: 60_000,
+    });
+  } catch (error) {
+    throw brandChatGptInitialNavigationError(error) ?? error;
+  }
+}
+
+export const BROWSER_HELPER_NAVIGATION_RETRY_DELAY_MS = 5_000;
+
+export async function waitForBrowserHelperNavigationRetry(
+  delayMs: number,
+  signal?: AbortSignal,
+): Promise<void> {
+  if (signal?.aborted) throw new DOMException("Browser helper turn aborted", "AbortError");
+  await new Promise<void>((resolve, reject) => {
+    const timer = setTimeout(finish, delayMs);
+    const abort = () => finish(new DOMException("Browser helper turn aborted", "AbortError"));
+    function finish(error?: Error): void {
+      clearTimeout(timer);
+      signal?.removeEventListener("abort", abort);
+      if (error) reject(error);
+      else resolve();
+    }
+    signal?.addEventListener("abort", abort, { once: true });
+  });
+}
+
+export async function runBrowserHelperNavigationRetry<T>(options: {
+  runAttempt: (attempt: 1 | 2) => Promise<T>;
+  abortSignal?: AbortSignal;
+  retainedContinuation?: boolean;
+  hasIrreversibleSubmission?: () => boolean;
+  waitBeforeRetry?: (delayMs: number, signal?: AbortSignal) => Promise<void>;
+}): Promise<T> {
+  try {
+    return await options.runAttempt(1);
+  } catch (error) {
+    if (!(error instanceof ChatGptInitialNavigationError)
+      || options.retainedContinuation
+      || options.hasIrreversibleSubmission?.()) throw error;
+    // 第一次 worker 返回前会走完自身 finally 与 launcher /turn/end；只有 await 完全退栈后，
+    // helper 才等待并创建第二个 surface，避免同一 logical run 的两个页面重叠。
+    await (options.waitBeforeRetry ?? waitForBrowserHelperNavigationRetry)(
+      BROWSER_HELPER_NAVIGATION_RETRY_DELAY_MS,
+      options.abortSignal,
+    );
+    if (options.hasIrreversibleSubmission?.()) throw error;
+    return options.runAttempt(2);
+  }
+}
+
+export class BrowserHelperPreparedSelectionReplayGate {
+  private selected?: boolean;
+
+  async observe(reused: boolean, publish: (reused: boolean) => Promise<void>): Promise<void> {
+    if (this.selected === undefined) {
+      await publish(reused);
+      this.selected = reused;
+      return;
+    }
+    if (this.selected !== reused) {
+      throw new Error("Browser helper prompt selection changed across navigation retry");
+    }
+  }
+}
+
+export function freezeBrowserHelperPreparedPrompt<T extends CompiledChatGptWebPrompt>(prepared: T): T {
+  for (const image of prepared.images) Object.freeze(image);
+  Object.freeze(prepared.images);
+  if (prepared.multipart) {
+    Object.freeze(prepared.multipart.parts);
+    Object.freeze(prepared.multipart);
+  }
+  return Object.freeze(prepared);
+}
