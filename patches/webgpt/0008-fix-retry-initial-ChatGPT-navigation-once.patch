diff --git a/tests/browser-helper-navigation-retry.test.ts b/tests/browser-helper-navigation-retry.test.ts
new file mode 100644
index 0000000..2b3ce63
--- /dev/null
+++ b/tests/browser-helper-navigation-retry.test.ts
@@ -0,0 +1,184 @@
+import { expect, test } from "bun:test";
+import {
+  BROWSER_HELPER_NAVIGATION_RETRY_DELAY_MS,
+  BrowserHelperPreparedSelectionReplayGate,
+  ChatGptInitialNavigationError,
+  brandChatGptInitialNavigationError,
+  freezeBrowserHelperPreparedPrompt,
+  navigateChatGptInitialTemporaryChat,
+  runBrowserHelperNavigationRetry,
+} from "../src/adapters/chatgpt-web/browser-helper-navigation-retry";
+
+test.each([
+  "ERR_CONNECTION_CLOSED",
+  "ERR_PROXY_CONNECTION_FAILED",
+  "ERR_NAME_NOT_RESOLVED",
+])("initial Temporary Chat navigation brands the exact allowlisted network code %s", networkCode => {
+  const cause = new Error(`page.goto: net::${networkCode} at https://chatgpt.com/?temporary-chat=true`);
+  const branded = brandChatGptInitialNavigationError(cause);
+
+  expect(branded).toBeInstanceOf(ChatGptInitialNavigationError);
+  expect(branded?.status).toBe(502);
+  expect(branded?.errorType).toBe("server_error");
+  expect(branded?.code).toBe("chatgpt_initial_navigation_failed");
+  expect(branded?.retryable).toBeTrue();
+  expect(branded?.networkCode).toBe(networkCode);
+  expect(branded?.cause).toBe(cause);
+});
+
+test.each([
+  "ERR_TIMED_OUT",
+  "ERR_CONNECTION_CLOSED_EXTRA",
+  "ERR_CONNECTION_CLOSED ERR_NAME_NOT_RESOLVED",
+  "HTTP 502",
+  "Cloudflare challenge",
+])("initial Temporary Chat navigation does not brand a non-exact failure: %s", detail => {
+  const cause = new Error(`page.goto: net::${detail}`);
+  expect(brandChatGptInitialNavigationError(cause)).toBeUndefined();
+});
+
+test.each([
+  "ERR_CONNECTION_CLOSED",
+  "ERR_PROXY_CONNECTION_FAILED",
+  "ERR_NAME_NOT_RESOLVED",
+])("helper retries one fully unwound fresh surface after %s", async networkCode => {
+  const events: string[] = [];
+  let activeSurfaces = 0;
+  let maximumActiveSurfaces = 0;
+  let attempts = 0;
+  const result = await runBrowserHelperNavigationRetry({
+    runAttempt: async attempt => {
+      attempts += 1;
+      activeSurfaces += 1;
+      maximumActiveSurfaces = Math.max(maximumActiveSurfaces, activeSurfaces);
+      events.push(`surface-${attempt}-start`);
+      try {
+        if (attempt === 1) {
+          throw brandChatGptInitialNavigationError(new Error(`page.goto: net::${networkCode}`))!;
+        }
+        events.push("final-submit");
+        return "complete";
+      } finally {
+        events.push(`surface-${attempt}-release`);
+        activeSurfaces -= 1;
+      }
+    },
+    waitBeforeRetry: async delayMs => { events.push(`wait-${delayMs}`); },
+  });
+
+  expect(BROWSER_HELPER_NAVIGATION_RETRY_DELAY_MS).toBe(5_000);
+  expect(result).toBe("complete");
+  expect(attempts).toBe(2);
+  expect(maximumActiveSurfaces).toBe(1);
+  expect(events).toEqual([
+    "surface-1-start",
+    "surface-1-release",
+    "wait-5000",
+    "surface-2-start",
+    "final-submit",
+    "surface-2-release",
+  ]);
+});
+
+test("helper returns the second branded navigation failure without looping", async () => {
+  const first = brandChatGptInitialNavigationError(new Error("net::ERR_CONNECTION_CLOSED"))!;
+  const second = brandChatGptInitialNavigationError(new Error("net::ERR_NAME_NOT_RESOLVED"))!;
+  let attempts = 0;
+  const run = runBrowserHelperNavigationRetry({
+    runAttempt: async attempt => {
+      attempts += 1;
+      throw attempt === 1 ? first : second;
+    },
+    waitBeforeRetry: async () => {},
+  });
+
+  await expect(run).rejects.toBe(second);
+  expect(attempts).toBe(2);
+});
+
+test("helper does not retry ordinary, retained, or post-submission failures", async () => {
+  const ordinary = new Error("page.goto: net::ERR_TIMED_OUT");
+  const branded = brandChatGptInitialNavigationError(new Error("net::ERR_CONNECTION_CLOSED"))!;
+  for (const scenario of [
+    { error: ordinary },
+    { error: branded, retainedContinuation: true },
+    { error: branded, hasIrreversibleSubmission: () => true },
+  ]) {
+    let attempts = 0;
+    const run = runBrowserHelperNavigationRetry({
+      runAttempt: async () => { attempts += 1; throw scenario.error; },
+      retainedContinuation: scenario.retainedContinuation,
+      hasIrreversibleSubmission: scenario.hasIrreversibleSubmission,
+      waitBeforeRetry: async () => { throw new Error("must not wait"); },
+    });
+    await expect(run).rejects.toBe(scenario.error);
+    expect(attempts).toBe(1);
+  }
+});
+
+test("aborting the fixed retry delay ends with AbortError before a second surface", async () => {
+  const controller = new AbortController();
+  let attempts = 0;
+  const run = runBrowserHelperNavigationRetry({
+    abortSignal: controller.signal,
+    runAttempt: async () => {
+      attempts += 1;
+      throw brandChatGptInitialNavigationError(new Error("net::ERR_CONNECTION_CLOSED"))!;
+    },
+  });
+  await Promise.resolve();
+  controller.abort();
+
+  await expect(run).rejects.toMatchObject({ name: "AbortError" });
+  expect(attempts).toBe(1);
+});
+
+test("the second surface suppresses an identical prepared-selection prelude and rejects a conflict", async () => {
+  const gate = new BrowserHelperPreparedSelectionReplayGate();
+  const published: boolean[] = [];
+  const publish = async (reused: boolean) => { published.push(reused); };
+
+  await gate.observe(false, publish);
+  await gate.observe(false, publish);
+  expect(published).toEqual([false]);
+  await expect(gate.observe(true, publish)).rejects.toThrow("changed across navigation retry");
+  expect(published).toEqual([false]);
+});
+
+test("both surfaces receive one immutable prepared payload owned by the logical helper run", () => {
+  const source = {
+    text: "inspect",
+    images: [{ ref: "codex-input-image-1", imageUrl: "data:image/png;base64,AA==" }],
+    multipart: { parts: ["stage", "final"] as [string, string], commit: "commit" },
+  };
+  const prepared = freezeBrowserHelperPreparedPrompt(source);
+
+  expect(prepared).toBe(source);
+  expect(Object.isFrozen(prepared)).toBeTrue();
+  expect(Object.isFrozen(prepared.images)).toBeTrue();
+  expect(Object.isFrozen(prepared.images[0])).toBeTrue();
+  expect(Object.isFrozen(prepared.multipart)).toBeTrue();
+  expect(Object.isFrozen(prepared.multipart?.parts)).toBeTrue();
+});
+
+test("only the initial fresh Temporary Chat goto converts an allowlisted network failure", async () => {
+  const calls: unknown[] = [];
+  const allowedCause = new Error("page.goto: net::ERR_PROXY_CONNECTION_FAILED");
+  const page = {
+    goto: async (...args: unknown[]) => { calls.push(args); throw allowedCause; },
+  };
+
+  await expect(navigateChatGptInitialTemporaryChat(page)).rejects.toMatchObject({
+    code: "chatgpt_initial_navigation_failed",
+    networkCode: "ERR_PROXY_CONNECTION_FAILED",
+  });
+  expect(calls).toEqual([[
+    "https://chatgpt.com/?temporary-chat=true",
+    { waitUntil: "domcontentloaded", timeout: 60_000 },
+  ]]);
+
+  const ordinaryCause = new Error("page.goto: net::ERR_TIMED_OUT");
+  await expect(navigateChatGptInitialTemporaryChat({
+    goto: async () => { throw ordinaryCause; },
+  })).rejects.toBe(ordinaryCause);
+});
