+          timeout: 60_000,
+        });
+      }
       await captureDiagnostic?.("temporary-chat-navigation-complete");
     }
     let composer: Locator;
@@ -3689,6 +3694,7 @@ export class ChatGptBrowserWorker {
           () => this.prepareTemporaryChatSurface(
