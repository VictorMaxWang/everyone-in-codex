+fn codex_config_override_arguments(
+    arguments: &[OsString],
+    encoded: Option<OsString>,
+) -> ShimResult<Vec<OsString>> {
+    let Some(app_server_index) = app_server_subcommand_index(arguments) else {
+        return Ok(arguments.to_vec());
+    };
+    let Some(encoded) = encoded else {
+        return Ok(arguments.to_vec());
+    };
+    let text = encoded
+        .to_str()
+        .ok_or("CODEXHOST_CODEX_CONFIG_OVERRIDES must be UTF-8")?;
+    if text.is_empty()
+        || text.len() > 8192
+        || text
+            .chars()
+            .any(|character| matches!(character, '\r' | '\n' | '\0'))
+    {
+        return Err("CODEXHOST_CODEX_CONFIG_OVERRIDES has an invalid shape".into());
+    }
+    let required = [
+        "model_provider",
+        "model_catalog_json",
+        "model_providers.everyone-in-codex.name",
+        "model_providers.everyone-in-codex.base_url",
+        "model_providers.everyone-in-codex.wire_api",
+        "model_providers.everyone-in-codex.requires_openai_auth",
+        "model_providers.everyone-in-codex.env_key",
+    ];
+    let overrides = text.split('\u{1f}').collect::<Vec<_>>();
+    if overrides.len() != required.len() {
+        return Err("CODEXHOST_CODEX_CONFIG_OVERRIDES must contain all required keys".into());
+    }
+    let mut seen = std::collections::HashSet::new();
+    for assignment in &overrides {
+        let Some((key, value)) = assignment.split_once('=') else {
+            return Err("CODEXHOST_CODEX_CONFIG_OVERRIDES contains an invalid assignment".into());
+        };
+        if !required.contains(&key) || !seen.insert(key) {
+            return Err("CODEXHOST_CODEX_CONFIG_OVERRIDES contains a duplicate key".into());
+        }
+        let valid = match key {
+            "model_provider" => value == r#""everyone-in-codex""#,
+            "model_catalog_json" => valid_catalog_override_path(value),
+            "model_providers.everyone-in-codex.name" => value == r#""Everyone in Codex""#,
+            "model_providers.everyone-in-codex.base_url" => valid_gateway_base_url(value),
+            "model_providers.everyone-in-codex.wire_api" => value == r#""responses""#,
+            "model_providers.everyone-in-codex.requires_openai_auth" => value == "false",
+            "model_providers.everyone-in-codex.env_key" => {
+                value == r#""EVERYONE_CODEX_LEASE_CAPABILITY""#
+            }
+            _ => false,
+        };
+        if !valid {
+            return Err("CODEXHOST_CODEX_CONFIG_OVERRIDES contains an unsafe value".into());
+        }
+    }
+    let mut routed = arguments.to_vec();
+    let injected = overrides
+        .into_iter()
+        .flat_map(|value| [OsString::from("-c"), OsString::from(value)])
+        .collect::<Vec<_>>();
+    routed.splice(app_server_index..app_server_index, injected);
+    Ok(routed)
+}
+
+fn valid_catalog_override_path(value: &str) -> bool {
+    let Some(path_text) = value
+        .strip_prefix('"')
+        .and_then(|text| text.strip_suffix('"'))
+    else {
+        return false;
+    };
+    let bytes = path_text.as_bytes();
+    let windows_absolute =
+        bytes.len() >= 3 && bytes[0].is_ascii_alphabetic() && bytes[1] == b':' && bytes[2] == b'/';
+    let unix_absolute = path_text.starts_with('/');
+    (windows_absolute || unix_absolute)
+        && !path_text.contains('\\')
+        && !path_text.split('/').any(|segment| segment == "..")
+        && !path_text
+            .chars()
+            .any(|character| character.is_control() || character == '"')
+}
+
+fn valid_gateway_base_url(value: &str) -> bool {
+    let Some(port) = value
+        .strip_prefix(r#""http://127.0.0.1:"#)
+        .and_then(|text| text.strip_suffix(r#"/v1""#))
+    else {
+        return false;
+    };
+    !port.is_empty()
+        && port.bytes().all(|byte| byte.is_ascii_digit())
+        && port.parse::<u16>().is_ok_and(|number| number > 0)
+}
