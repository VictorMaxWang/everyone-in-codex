+/// Build the ephemeral Electron arguments owned by this Launcher invocation.
+fn desktop_arguments(options: &ResolvedLaunchOptions, control: &RuntimeControl) -> Vec<OsString> {
+    let mut arguments = vec![control.inspector_argument.clone()];
+    if let Some(directory) = &options.desktop_user_data_dir {
+        // 使用单个 `--user-data-dir=` 参数，避免 Windows 路径中的空格被二次拆分。
+        let mut argument = OsString::from("--user-data-dir=");
+        argument.push(directory.as_os_str());
+        arguments.push(argument);
+    }
+    arguments
+}
