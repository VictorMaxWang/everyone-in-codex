+        throw new Error("Configured Grok Model context window is invalid");
+      }
+      contextWindowTokensByModel.set(ref.id, model.contextWindow);
+    }
+    const supportedThinkingOptionIds = (model.reasoningLevels ?? []).map((level) => {
+      const id = harnessThinkingOptionIdSchema.parse(level);
