+fn codex_profile_arguments(
+    arguments: &[OsString],
+    profile: Option<OsString>,
+) -> ShimResult<Vec<OsString>> {
+    let Some(profile) = profile else {
+        return Ok(arguments.to_vec());
+    };
+    let profile_text = profile
+        .to_str()
+        .ok_or("CODEXHOST_CODEX_PROFILE must be UTF-8")?;
+    if profile_text.is_empty()
+        || !profile_text
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    {
+        return Err("CODEXHOST_CODEX_PROFILE contains unsupported characters".into());
+    }
+    let Some(app_server_index) = app_server_subcommand_index(arguments) else {
+        return Ok(arguments.to_vec());
+    };
+    if arguments[..app_server_index].iter().any(|argument| {
+        argument.to_str().is_some_and(|value| {
+            value == "-p"
+                || value == "--profile"
+                || value.starts_with("--profile=")
+                || value.starts_with("-p=")
+        })
+    }) {
+        return Err("Codex app-server arguments already contain an explicit profile".into());
+    }
+
+    // Profile 必须位于 `app-server` 子命令前，Codex CLI 才会把它识别为全局选项。
+    let mut profiled = arguments.to_vec();
+    profiled.splice(
+        app_server_index..app_server_index,
+        [OsString::from("-p"), profile],
+    );
+    Ok(profiled)
+}
