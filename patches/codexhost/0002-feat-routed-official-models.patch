new file mode 100644
index 0000000..ad83b45
--- /dev/null
+++ b/packages/harness-adapter/src/session-registration.ts
@@ -0,0 +1,109 @@
+export const EVERYONE_CODEX_HOST_CONTROL_URL_ENV = "EVERYONE_CODEX_HOST_CONTROL_URL";
+export const EVERYONE_CODEX_HOST_CONTROL_CAPABILITY_ENV = "EVERYONE_CODEX_HOST_CONTROL_CAPABILITY";
+export const EVERYONE_CODEX_SESSION_TOKEN_ENV = "EVERYONE_CODEX_SESSION_TOKEN";
+
+export type RoutedHarnessId = "pi" | "omp" | "deepseek-harness" | "grok" | "claude-code";
+
+export interface HarnessSessionRegistrationInput {
+  environment: NodeJS.ProcessEnv;
+  harnessId: RoutedHarnessId;
+  sessionId: string;
+  cwd: string;
+  workspaceRoots?: readonly string[];
+  permissionMode: string;
+}
+
+export interface HarnessSessionRegistration {
+  sessionToken: string;
+  environment: NodeJS.ProcessEnv;
+  close(): Promise<void>;
+}
+
+function environmentValue(environment: NodeJS.ProcessEnv, name: string): string | undefined {
+  return Object.entries(environment).find(([key]) => key.toLowerCase() === name.toLowerCase())?.[1];
+}
+
+function controlEndpoint(raw: string): URL {
+  const url = new URL(raw);
+  if (
+    url.protocol !== "http:" ||
+    !["127.0.0.1", "localhost", "[::1]"].includes(url.hostname) ||
+    (url.pathname !== "/" && url.pathname !== "") ||
+    url.search ||
+    url.hash
+  ) {
+    throw new Error("Everyone in Codex Host control URL must be a loopback HTTP origin");
+  }
+  return url;
+}
+
+function nonBlank(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+/**
+ * 注册一个 Harness Session，并只把短期 token 下沉给该 Session 的客户端进程。
+ * 主项目拥有控制面；CodexHost overlay 只实现最小、可撤销的客户端边界。
+ */
+export async function registerHarnessSession(
+  input: HarnessSessionRegistrationInput,
+  fetcher: typeof fetch = fetch,
+): Promise<HarnessSessionRegistration | null> {
+  const rawUrl = environmentValue(input.environment, EVERYONE_CODEX_HOST_CONTROL_URL_ENV);
+  const capability = environmentValue(
+    input.environment,
+    EVERYONE_CODEX_HOST_CONTROL_CAPABILITY_ENV,
+  );
+  if (rawUrl === undefined && capability === undefined) return null;
+  if (!nonBlank(rawUrl) || !nonBlank(capability)) {
+    throw new Error("Everyone in Codex Host control configuration is incomplete");
+  }
+  const origin = controlEndpoint(rawUrl);
+  const endpoint = new URL("/v1/sessions", origin);
+  const response = await fetcher(endpoint, {
+    method: "POST",
+    headers: {
+      authorization: `Bearer ${capability}`,
+      "content-type": "application/json",
+    },
+    body: JSON.stringify({
+      harnessId: input.harnessId,
+      sessionId: input.sessionId,
+      cwd: input.cwd,
+      workspaceRoots: input.workspaceRoots ?? [input.cwd],
+      permissionMode: input.permissionMode,
+    }),
+  });
+  if (!response.ok) throw new Error("Everyone in Codex Session registration was rejected");
+  const sessionToken = response.headers.get("x-everyone-codex-session") ?? undefined;
+  if (!nonBlank(sessionToken)) {
+    throw new Error("Everyone in Codex Session registration returned no token");
+  }
+  const sessionEnvironment = { ...input.environment };
+  for (const key of Object.keys(sessionEnvironment)) {
+    if (
+      [EVERYONE_CODEX_HOST_CONTROL_URL_ENV, EVERYONE_CODEX_HOST_CONTROL_CAPABILITY_ENV].some(
+        (name) => name.toLowerCase() === key.toLowerCase(),
+      )
+    ) {
+      Reflect.deleteProperty(sessionEnvironment, key);
+    }
+  }
+  sessionEnvironment[EVERYONE_CODEX_SESSION_TOKEN_ENV] = sessionToken;
+
+  let closed = false;
+  return {
+    sessionToken,
+    environment: sessionEnvironment,
+    close: async () => {
+      if (closed) return;
+      closed = true;
+      const deletion = new URL(`/v1/sessions/${encodeURIComponent(sessionToken)}`, origin);
+      const deleted = await fetcher(deletion, {
+        method: "DELETE",
+        headers: { authorization: `Bearer ${capability}` },
+      });
+      if (!deleted.ok) throw new Error("Everyone in Codex Session revocation was rejected");
+    },
+  };
+}
