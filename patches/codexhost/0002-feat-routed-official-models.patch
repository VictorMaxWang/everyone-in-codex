+import { describe, expect, it, vi } from "vitest";
+
+import {
+  EVERYONE_CODEX_SESSION_TOKEN_ENV,
+  registerHarnessSession,
+} from "../src/session-registration.js";
+
+describe("Harness Session registration", () => {
+  it("registers, projects only the Session token, and revokes exactly once", async () => {
+    const fetcher = vi
+      .fn<typeof fetch>()
+      .mockResolvedValueOnce(new Response("{}", {
+        headers: { "x-everyone-codex-session": "session-secret" },
+      }))
+      .mockResolvedValueOnce(new Response(null, { status: 204 }));
+    const registration = await registerHarnessSession(
+      {
+        environment: {
+          EVERYONE_CODEX_HOST_CONTROL_URL: "http://127.0.0.1:54321",
+          EVERYONE_CODEX_HOST_CONTROL_CAPABILITY: "host-secret",
+        },
+        harnessId: "pi",
+        sessionId: "session-1",
+        cwd: "C:\\workspace",
+        workspaceRoots: ["C:\\workspace"],
+        permissionMode: "default",
+      },
+      fetcher,
+    );
+
+    expect(registration?.environment[EVERYONE_CODEX_SESSION_TOKEN_ENV]).toBe("session-secret");
+    const post = fetcher.mock.calls[0];
+    expect(post?.[0].toString()).toBe("http://127.0.0.1:54321/v1/sessions");
+    expect(JSON.parse(String(post?.[1]?.body))).toEqual({
+      harnessId: "pi",
+      sessionId: "session-1",
+      cwd: "C:\\workspace",
+      workspaceRoots: ["C:\\workspace"],
+      permissionMode: "default",
+    });
+
+    await registration?.close();
+    await registration?.close();
+    expect(fetcher).toHaveBeenCalledTimes(2);
+    expect(fetcher.mock.calls[1]?.[0].toString()).toBe(
+      "http://127.0.0.1:54321/v1/sessions/session-secret",
+    );
+  });
+
+  it("is inert without a configured Host control pair", async () => {
+    await expect(
+      registerHarnessSession({
+        environment: {},
+        harnessId: "omp",
+        sessionId: "session-2",
+        cwd: "/workspace",
+        permissionMode: "read-only",
+      }),
+    ).resolves.toBeNull();
+  });
+});
