diff --git a/packages/host-runtime/test/gateway-product-update-coordinator.test.ts b/packages/host-runtime/test/gateway-product-update-coordinator.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39735a5163e3dccf76bd261942843b83fff9619e
--- /dev/null
+++ b/packages/host-runtime/test/gateway-product-update-coordinator.test.ts
@@ -0,0 +1,94 @@
+import { describe, expect, it, vi } from "vitest";
+
+import {
+  GatewayProductUpdateCoordinator,
+  createGatewayProductUpdateCoordinatorFromEnvironment,
+} from "../src/gateway-product-update-coordinator.js";
+
+describe("GatewayProductUpdateCoordinator", () => {
+  it("proxies the compatible update RPCs to the Fusion product endpoints", async () => {
+    const fetch = vi.fn(async (input: string, _init: RequestInit) => {
+      const method = input.split("/").at(-1);
+      const payload =
+        method === "check"
+          ? {
+              currentVersion: "0.3.1",
+              installation: "windows-installer",
+              latestVersion: "0.3.1",
+              updateAvailable: false,
+              installationAvailable: false,
+              releaseNotes: null,
+              releaseNotesUrl: null,
+              status: null,
+              error: null,
+            }
+          : method === "start"
+            ? {
+                status: {
+                  version: "0.3.2",
+                  installation: "windows-installer",
+                  phase: "waiting-for-exit",
+                  updatedAt: 1,
+                  error: null,
+                },
+              }
+            : { status: null };
+      return new Response(JSON.stringify(payload), { status: 200 });
+    });
+    const coordinator = new GatewayProductUpdateCoordinator({
+      controlUrl: "http://127.0.0.1:7441/",
+      capability: "fixture-capability",
+      launcherPid: 1234,
+      leaseId: "lease-one",
+      launcherExecutable: "C:\\EveryoneCodex\\codexhost.exe",
+      runtimeDescriptorPath: "C:\\EveryoneCodex\\desktop-runtime-v1.json",
+      fetch,
+    });
+
+    await coordinator.check();
+    await coordinator.start();
+    await coordinator.status();
+    expect(fetch.mock.calls.map(([url]) => url)).toEqual([
+      "http://127.0.0.1:7441/v1/product-update/check",
+      "http://127.0.0.1:7441/v1/product-update/start",
+      "http://127.0.0.1:7441/v1/product-update/status",
+    ]);
+    for (const [, init] of fetch.mock.calls) {
+      expect(JSON.parse(String(init?.body))).toEqual({
+        launcherPid: 1234,
+        leaseId: "lease-one",
+        launcherExecutable: "C:\\EveryoneCodex\\codexhost.exe",
+        runtimeDescriptorPath: "C:\\EveryoneCodex\\desktop-runtime-v1.json",
+      });
+      expect(init?.headers).toMatchObject({ authorization: "Bearer fixture-capability" });
+    }
+  });
+
+  it("requires the Fusion control pair, launcher pid and exact lease id together", () => {
+    expect(createGatewayProductUpdateCoordinatorFromEnvironment({})).toBeNull();
+    expect(() =>
+      createGatewayProductUpdateCoordinatorFromEnvironment({
+        EVERYONE_CODEX_HOST_CONTROL_URL: "http://127.0.0.1:7441",
+        EVERYONE_CODEX_HOST_CONTROL_CAPABILITY: "fixture-capability",
+        CODEXHOST_LAUNCHER_PID: "1234",
+      }),
+    ).toThrow("Product update control environment is incomplete");
+  });
+
+  it("never exposes a Gateway body or host capability in errors", async () => {
+    const coordinator = new GatewayProductUpdateCoordinator({
+      controlUrl: "http://127.0.0.1:7441/",
+      capability: "fixture-capability",
+      launcherPid: 1234,
+      leaseId: "lease-one",
+      launcherExecutable: "C:\\EveryoneCodex\\codexhost.exe",
+      runtimeDescriptorPath: "C:\\EveryoneCodex\\desktop-runtime-v1.json",
+      fetch: vi.fn(async () => new Response("private-body", { status: 500 })),
+    });
+    await expect(coordinator.check()).rejects.toThrow(
+      "Product update Gateway request failed (HTTP 500)",
+    );
+    await expect(coordinator.check()).rejects.not.toThrow("private-body");
+    await expect(coordinator.check()).rejects.not.toThrow("fixture-capability");
+  });
+});
