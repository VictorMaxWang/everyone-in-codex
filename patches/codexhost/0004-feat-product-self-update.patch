new file mode 100644
index 0000000000000000000000000000000000000000..df93b3ccc9b2a8a4cc31263068c5f33fb08c5479
--- /dev/null
+++ b/packages/host-runtime/src/gateway-product-update-coordinator.ts
@@ -0,0 +1,177 @@
+import path from "node:path";
+
+import {
+  updateCheckResultSchema,
+  updateStartResultSchema,
+  updateStatusResultSchema,
+  type UpdateCheckResult,
+  type UpdateStartResult,
+  type UpdateStatusResult,
+} from "@codexhost/shared-contracts";
+
+import {
+  EVERYONE_CODEX_HOST_CONTROL_CAPABILITY_ENV,
+  EVERYONE_CODEX_HOST_CONTROL_URL_ENV,
+} from "./connection-coordinator.js";
+import type { HostUpdateCoordinator } from "./update-coordinator.js";
+
+const PRODUCT_LEASE_ID_ENV = "EVERYONE_CODEX_LEASE_ID";
+const LAUNCHER_PID_ENV = "CODEXHOST_LAUNCHER_PID";
+const LAUNCHER_EXECUTABLE_ENV = "CODEXHOST_LAUNCHER_EXECUTABLE";
+const RUNTIME_DESCRIPTOR_ENV = "CODEXHOST_RUNTIME_DESCRIPTOR_PATH";
+const RESPONSE_MAX_BYTES = 2 * 1024 * 1024;
+const REQUEST_TIMEOUT_MS = 30 * 60 * 1_000;
+
+type GatewayFetch = (input: string, init: RequestInit) => Promise<Response>;
+
+function controlOrigin(value: string): string {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error("Product update control URL must be an HTTP 127.0.0.1 origin");
+  }
+  if (
+    url.protocol !== "http:" ||
+    url.hostname !== "127.0.0.1" ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash ||
+    url.pathname !== "/"
+  ) {
+    throw new Error("Product update control URL must be an HTTP 127.0.0.1 origin");
+  }
+  return url.origin;
+}
+
+export interface GatewayProductUpdateCoordinatorOptions {
+  controlUrl: string;
+  capability: string;
+  launcherPid: number;
+  leaseId: string;
+  launcherExecutable: string;
+  runtimeDescriptorPath: string;
+  fetch?: GatewayFetch;
+  timeoutMs?: number;
+}
+
+/** Fusion 模式只代理产品更新；它没有访问任何上游组件 updater 的代码路径。 */
+export class GatewayProductUpdateCoordinator implements HostUpdateCoordinator {
+  readonly #origin: string;
+  readonly #capability: string;
+  readonly #launcherPid: number;
+  readonly #leaseId: string;
+  readonly #launcherExecutable: string;
+  readonly #runtimeDescriptorPath: string;
+  readonly #fetch: GatewayFetch;
+  readonly #timeoutMs: number;
+
+  constructor(options: GatewayProductUpdateCoordinatorOptions) {
+    this.#origin = controlOrigin(options.controlUrl);
+    if (!options.capability || options.capability.length > 16_384) {
+      throw new Error("Product update control capability is invalid");
+    }
+    if (!Number.isSafeInteger(options.launcherPid) || options.launcherPid < 1) {
+      throw new Error("Product update launcher pid is invalid");
+    }
+    if (!/^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/u.test(options.leaseId)) {
+      throw new Error("Product update lease id is invalid");
+    }
+    if (
+      !path.isAbsolute(options.launcherExecutable) ||
+      !path.isAbsolute(options.runtimeDescriptorPath)
+    ) {
+      throw new Error("Product update launcher paths are invalid");
+    }
+    this.#capability = options.capability;
+    this.#launcherPid = options.launcherPid;
+    this.#leaseId = options.leaseId;
+    this.#launcherExecutable = path.resolve(options.launcherExecutable);
+    this.#runtimeDescriptorPath = path.resolve(options.runtimeDescriptorPath);
+    this.#fetch = options.fetch ?? globalThis.fetch.bind(globalThis);
+    this.#timeoutMs = options.timeoutMs ?? REQUEST_TIMEOUT_MS;
+  }
+
+  async check(signal?: AbortSignal): Promise<UpdateCheckResult> {
+    return updateCheckResultSchema.parse(await this.#post("check", signal));
+  }
+
+  async start(): Promise<UpdateStartResult> {
+    return updateStartResultSchema.parse(await this.#post("start"));
+  }
+
+  async status(): Promise<UpdateStatusResult> {
+    return updateStatusResultSchema.parse(await this.#post("status"));
+  }
+
+  async #post(method: "check" | "start" | "status", outerSignal?: AbortSignal): Promise<unknown> {
+    const timeoutSignal = AbortSignal.timeout(this.#timeoutMs);
+    const signal = outerSignal ? AbortSignal.any([outerSignal, timeoutSignal]) : timeoutSignal;
+    let response: Response;
+    try {
+      response = await this.#fetch(`${this.#origin}/v1/product-update/${method}`, {
+        method: "POST",
+        redirect: "error",
+        signal,
+        headers: {
+          authorization: `Bearer ${this.#capability}`,
+          "content-type": "application/json",
+        },
+        body: JSON.stringify({
+          launcherPid: this.#launcherPid,
+          leaseId: this.#leaseId,
+          launcherExecutable: this.#launcherExecutable,
+          runtimeDescriptorPath: this.#runtimeDescriptorPath,
+        }),
+      });
+    } catch {
+      throw new Error("Product update Gateway request failed");
+    }
+    if (!response.ok) {
+      throw new Error(`Product update Gateway request failed (HTTP ${response.status})`);
+    }
+    const contentLength = Number(response.headers.get("content-length"));
+    if (Number.isFinite(contentLength) && contentLength > RESPONSE_MAX_BYTES) {
+      throw new Error("Product update Gateway returned an invalid response");
+    }
+    try {
+      const body = await response.text();
+      if (Buffer.byteLength(body, "utf8") > RESPONSE_MAX_BYTES) throw new Error("too large");
+      return JSON.parse(body) as unknown;
+    } catch {
+      throw new Error("Product update Gateway returned an invalid response");
+    }
+  }
+}
+
+export function createGatewayProductUpdateCoordinatorFromEnvironment(
+  environment: NodeJS.ProcessEnv,
+): GatewayProductUpdateCoordinator | null {
+  const controlUrl = environment[EVERYONE_CODEX_HOST_CONTROL_URL_ENV];
+  const capability = environment[EVERYONE_CODEX_HOST_CONTROL_CAPABILITY_ENV];
+  if (!controlUrl && !capability) return null;
+  const launcherPid = Number(environment[LAUNCHER_PID_ENV]);
+  const leaseId = environment[PRODUCT_LEASE_ID_ENV];
+  const launcherExecutable = environment[LAUNCHER_EXECUTABLE_ENV];
+  const runtimeDescriptorPath = environment[RUNTIME_DESCRIPTOR_ENV];
+  if (
+    !controlUrl ||
+    !capability ||
+    !Number.isSafeInteger(launcherPid) ||
+    launcherPid < 1 ||
+    !leaseId ||
+    !launcherExecutable ||
+    !runtimeDescriptorPath
+  ) {
+    throw new Error("Product update control environment is incomplete");
+  }
+  return new GatewayProductUpdateCoordinator({
+    controlUrl,
+    capability,
+    launcherPid,
+    leaseId,
+    launcherExecutable,
+    runtimeDescriptorPath,
+  });
+}
