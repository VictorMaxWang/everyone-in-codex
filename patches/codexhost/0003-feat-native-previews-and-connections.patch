+}): DeepSeekPresentedToolItem {
+  const view = viewRecord(input.view, "call");
+  if (view?.card === "terminal" && nonBlankString(view.title)) {
+    return {
+      type: "commandExecution",
+      itemId: input.itemId,
+      command: view.title,
+      cwd: path.resolve(input.cwd, nonBlankString(view.cwd) ? view.cwd : "."),
+    };
+  }
