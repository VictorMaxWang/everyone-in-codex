new file mode 100644
index 0000000..614286e
--- /dev/null
+++ b/packages/harness-adapter/src/action-preview.ts
@@ -0,0 +1,144 @@
+import type { HostItemId, HostTurnId } from "@codexhost/shared-contracts";
+
+import type {
+  HarnessOutput,
+  HostApprovalInteraction,
+  HostItem,
+  HostItemOutcome,
+  HostItemSnapshot,
+} from "./text-session.js";
+
+export interface ActionPreviewStart {
+  turnId: HostTurnId;
+  nativeCallId: string;
+  item: HostItem;
+}
+
+export interface ActionCompletion {
+  outcome: HostItemOutcome;
+  item?: HostItem;
+}
+
+export interface NativeActionRecord {
+  nativeCallId: string;
+  item: HostItem;
+  outcome: HostItemOutcome;
+}
+
+export interface ActionPreviewLease {
+  readonly itemId: HostItemId;
+  linkApproval(interaction: HostApprovalInteraction): void;
+  appendOutput(text: string): void;
+  complete(result: ActionCompletion): void;
+}
+
+interface ActivePreview {
+  turnId: HostTurnId;
+  nativeCallId: string;
+  item: HostItem;
+  lease: ActionPreviewLease;
+  completed: boolean;
+}
+
+/**
+ * 将一个 Harness 的 native call 生命周期收敛为单个 Host Item。
+ * Adapter 只负责翻译原生事件；本模块负责 item identity、审批关联和终态顺序。
+ */
+export class ActionPreviewModule {
+  readonly #active = new Map<string, ActivePreview>();
+
+  constructor(readonly emit: (output: HarnessOutput) => unknown) {}
+
+  begin(input: ActionPreviewStart): ActionPreviewLease {
+    const existing = this.#active.get(input.nativeCallId);
+    if (existing) {
+      if (
+        existing.turnId !== input.turnId ||
+        existing.item.itemId !== input.item.itemId ||
+        existing.item.type !== input.item.type
+      ) {
+        throw new Error("Native Action ID was reused for another Host Item");
+      }
+      if (existing.completed) throw new Error("Native Action restarted after completion");
+      return existing.lease;
+    }
+
+    const state = {} as ActivePreview;
+    const lease: ActionPreviewLease = {
+      itemId: input.item.itemId,
+      linkApproval: (interaction) => this.#linkApproval(state, interaction),
+      appendOutput: (text) => this.#appendOutput(state, text),
+      complete: (result) => this.#complete(state, result),
+    };
+    Object.assign(state, { ...input, lease, completed: false });
+    this.#active.set(input.nativeCallId, state);
+    this.emit({
+      kind: "event",
+      event: { type: "item.started", turnId: input.turnId, item: input.item },
+    });
+    return lease;
+  }
+
+  restore(records: readonly NativeActionRecord[]): HostItemSnapshot[] {
+    return records.map(({ item, outcome }) => ({ item, outcome }));
+  }
+
+  finalizeTurn(turnId: HostTurnId, outcome: HostItemOutcome): void {
+    for (const state of this.#active.values()) {
+      if (state.turnId === turnId && !state.completed) this.#complete(state, { outcome });
+    }
+  }
+
+  #linkApproval(state: ActivePreview, interaction: HostApprovalInteraction): void {
+    this.#requireOpen(state);
+    if (interaction.turnId !== state.turnId) {
+      throw new Error("Native Approval references another Turn");
+    }
+    if (interaction.itemId && interaction.itemId !== state.item.itemId) {
+      throw new Error("Native Approval references another Host Item");
+    }
+    this.emit({ kind: "interaction", interaction: { ...interaction, itemId: state.item.itemId } });
+  }
+
+  #appendOutput(state: ActivePreview, text: string): void {
+    this.#requireOpen(state);
+    if (state.item.type !== "commandExecution") {
+      throw new Error("Only Command Execution previews accept streamed output");
+    }
+    state.item = { ...state.item, output: (state.item.output ?? "") + text };
+    this.emit({
+      kind: "event",
+      event: {
+        type: "item.updated",
+        turnId: state.turnId,
+        itemId: state.item.itemId,
+        update: { type: "output.append", text },
+      },
+    });
+  }
+
+  #complete(state: ActivePreview, result: ActionCompletion): void {
+    this.#requireOpen(state);
+    if (result.item) {
+      if (result.item.itemId !== state.item.itemId || result.item.type !== state.item.type) {
+        throw new Error("Native Action completion references another Host Item");
+      }
+      state.item = result.item;
+    }
+    state.completed = true;
+    this.emit({
+      kind: "event",
+      event: {
+        type: "item.completed",
+        turnId: state.turnId,
+        snapshot: { item: state.item, outcome: result.outcome },
+      },
+    });
+  }
+
+  #requireOpen(state: ActivePreview): void {
+    // 同一 native call 的所有事件必须落在同一个 Item 上；终态后继续写入会导致
+    // Desktop 出现重复执行卡，因此在公共边界直接失败关闭。
+    if (state.completed) throw new Error("Native Action output follows Item completion");
+  }
+}
