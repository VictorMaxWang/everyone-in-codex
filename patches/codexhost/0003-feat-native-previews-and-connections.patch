diff --git a/tests/e2e/renderer-harness-command-control.spec.ts b/tests/e2e/renderer-harness-command-control.spec.ts
new file mode 100644
index 0000000..224e566
--- /dev/null
+++ b/tests/e2e/renderer-harness-command-control.spec.ts
@@ -0,0 +1,121 @@
+import { expect, test } from "@playwright/test";
+import { build } from "esbuild";
+import path from "node:path";
+
+const repositoryRoot = path.resolve(import.meta.dirname, "../..");
+const browserExecutable = process.env.CODEXHOST_PLAYWRIGHT_EXECUTABLE_PATH;
+if (browserExecutable) test.use({ launchOptions: { executablePath: browserExecutable } });
+
+const { outputFiles } = await build({
+  stdin: {
+    contents: `
+      import { mountRendererHarnessCommandControl } from "./packages/renderer-extension/src/renderer-harness-command-control.ts";
+
+      globalThis.setupHarnessCommands = () => {
+        globalThis.selections = [];
+        globalThis.refreshCount = 0;
+        const parent = document.createElement("div");
+        document.body.append(parent);
+        const control = mountRendererHarnessCommandControl(
+          parent,
+          null,
+          (command, arguments_) => globalThis.selections.push({ command, arguments: arguments_ }),
+          async () => {
+            globalThis.refreshCount += 1;
+            control.setCommands([
+              {
+                id: "pi.review",
+                invocation: "/review",
+                label: "Review code",
+                description: "Review one path",
+                argumentMode: "text",
+                argumentHint: "<path>",
+                argumentRequired: true,
+              },
+              {
+                id: "pi.recap",
+                invocation: "/recap",
+                label: "Recap",
+                argumentMode: "none",
+              },
+            ]);
+          },
+        );
+        control.setCommands([
+          {
+            id: "pi.review",
+            invocation: "/review",
+            label: "Review code",
+            description: "Review one path",
+            argumentMode: "text",
+            argumentHint: "<path>",
+            argumentRequired: true,
+          },
+        ]);
+        globalThis.commandControl = control;
+      };
+    `,
+    resolveDir: repositoryRoot,
+    sourcefile: "renderer-harness-command-control-e2e-entry.ts",
+    loader: "ts",
+  },
+  bundle: true,
+  format: "iife",
+  platform: "browser",
+  target: "es2024",
+  write: false,
+});
+
+const browserBundle = outputFiles[0]?.text;
+if (!browserBundle) throw new Error("Harness command control E2E bundle was not generated");
+
+async function setup(page: import("@playwright/test").Page, language = "en") {
+  await page.setContent(`<!doctype html><html lang="${language}"><body></body></html>`);
+  await page.addScriptTag({ content: browserBundle! });
+  await page.evaluate(() => {
+    const setup = Reflect.get(globalThis, "setupHarnessCommands");
+    if (typeof setup !== "function") throw new Error("Harness command setup is unavailable");
+    setup();
+  });
+}
+
+test("refreshes on every open and executes required text with a full invocation preview", async ({
+  page,
+}) => {
+  await setup(page);
+  const trigger = page.getByRole("button", { name: "Harness commands" });
+  await trigger.click();
+  await expect.poll(() => page.evaluate(() => Reflect.get(globalThis, "refreshCount"))).toBe(1);
+
+  await page.getByRole("menuitem", { name: /\/review/ }).click();
+  const input = page.getByRole("textbox", { name: "Command arguments" });
+  await expect(input).toBeFocused();
+  await expect(input).toHaveAttribute("placeholder", "<path>");
+  await expect(page.getByRole("button", { name: "Run" })).toBeDisabled();
+  await input.fill("src/index.ts");
+  await expect(page.locator("[data-command-preview]")).toHaveText("/review src/index.ts");
+  await input.press("Enter");
+  await expect
+    .poll(() => page.evaluate(() => Reflect.get(globalThis, "selections")))
+    .toMatchObject([{ command: { id: "pi.review" }, arguments: { text: "src/index.ts" } }]);
+
+  await trigger.click();
+  await expect.poll(() => page.evaluate(() => Reflect.get(globalThis, "refreshCount"))).toBe(2);
+});
+
+test("Escape returns from text input to the command list and restores focus", async ({ page }) => {
+  await setup(page);
+  await page.getByRole("button", { name: "Harness commands" }).click();
+  await page.getByRole("menuitem", { name: /\/review/ }).click();
+  await page.getByRole("textbox", { name: "Command arguments" }).press("Escape");
+  await expect(page.getByRole("menuitem", { name: /\/review/ })).toBeFocused();
+});
+
+test("uses Chinese Run and Cancel labels when the Codex document is Chinese", async ({ page }) => {
+  await setup(page, "zh-CN");
+  await page.getByRole("button", { name: "Harness 命令" }).click();
+  await page.getByRole("menuitem", { name: /\/review/ }).click();
+  await expect(page.getByRole("button", { name: "运行" })).toBeVisible();
+  await page.getByRole("button", { name: "取消" }).click();
+  await expect(page.getByRole("menuitem", { name: /\/review/ })).toBeFocused();
+});
