+/** 将已关联的 Command/File Host Item 投影为 Codex 原生审批请求。 */
+export function projectCodexNativeApprovalRequest(input: {
+  threadId: string;
+  interaction: HostApprovalInteraction;
+  item: NativeApprovalItem;
+  cwd: string;
+  startedAtMs: number;
+}): CodexApprovalRequestProjection {
+  const { interaction, item } = input;
+  validateActions(interaction);
+  const allow = requiredActionForEffect(interaction, "allowOnce");
+  const allowForSession = optionalActionForEffect(interaction, "allowForSession");
+  const deny = requiredActionForEffect(interaction, "deny");
+  if (actionsForEffect(interaction, "allowAlways").length !== 0) {
+    throw new Error("Native Codex Approval cannot preserve allowAlways scope");
+  }
+  const denyResponse: HostApprovalResponse = { type: "approval", actionId: deny.id };
+  const availableDecisions = [
+    "accept",
+    ...(allowForSession ? (["acceptForSession"] as const) : []),
+    "decline",
+  ];
+  const commonParams = {
+    threadId: input.threadId,
+    turnId: interaction.turnId,
+    itemId: item.itemId,
+    startedAtMs: input.startedAtMs,
+    ...(interaction.description ? { reason: interaction.description } : {}),
+  };
+
+  return {
+    request:
+      item.type === "commandExecution"
+        ? {
+            method: "item/commandExecution/requestApproval",
+            params: {
+              ...commonParams,
+              environmentId: null,
+              command: item.command,
+              cwd: item.cwd ?? input.cwd,
+              commandActions:
+                item.commandActions && item.commandActions.length > 0
+                  ? item.commandActions
+                  : [{ type: "unknown", command: item.command }],
+              availableDecisions,
+            },
+          }
+        : {
+            method: "item/fileChange/requestApproval",
+            params: { ...commonParams },
+          },
+    denyResponse,
+    parseResponse(result) {
+      if (
+        !isRecord(result) ||
+        Object.keys(result).length !== 1 ||
+        typeof result.decision !== "string"
+      ) {
+        throw responseError("contains a malformed native decision");
+      }
+      if (result.decision === "accept") return { type: "approval", actionId: allow.id };
+      if (result.decision === "acceptForSession") {
+        if (!allowForSession) throw responseError("contains an undeclared session scope");
+        return { type: "approval", actionId: allowForSession.id };
+      }
+      if (result.decision === "decline" || result.decision === "cancel") return denyResponse;
+      throw responseError("contains an unsupported native decision");
+    },
+  };
+}
