diff --git a/packages/harness-adapter/src/path-action-preview.ts b/packages/harness-adapter/src/path-action-preview.ts
new file mode 100644
index 0000000..6c32a15
--- /dev/null
+++ b/packages/harness-adapter/src/path-action-preview.ts
@@ -0,0 +1,352 @@
+import { lstat, readFile, realpath } from "node:fs/promises";
+import { isAbsolute, relative, resolve, sep } from "node:path";
+
+import { applyPatch, createTwoFilesPatch, parsePatch } from "diff";
+
+import type { JsonValue } from "@codexhost/shared-contracts";
+
+import type { HarnessError, HostFileChange } from "./text-session.js";
+
+const MAX_FILES = 32;
+const MAX_TEXT_BYTES = 4 * 1024 * 1024;
+const PATH_KEYS = ["path", "file_path", "filePath", "target"] as const;
+const CONTENT_KEYS = ["content", "text"] as const;
+const OLD_TEXT_KEYS = ["old_string", "oldString", "old_text", "oldText"] as const;
+const NEW_TEXT_KEYS = ["new_string", "newString", "new_text", "newText", "replacement"] as const;
+const MOVE_SOURCE_KEYS = ["source", "sourcePath", "from", "path", "file_path", "filePath"] as const;
+const MOVE_TARGET_KEYS = [
+  "destination",
+  "destinationPath",
+  "dest",
+  "destPath",
+  "to",
+  "move_path",
+  "movePath",
+  "target",
+] as const;
+const PATCH_KEYS = ["patch", "unifiedDiff", "unified_diff"] as const;
+
+export interface PathActionPreviewInput {
+  toolName: string;
+  arguments: JsonValue;
+  cwd: string;
+  workspaceRoots: readonly string[];
+}
+
+export interface PathActionPreviewLease {
+  readonly changes: readonly HostFileChange[];
+  revalidate(): Promise<HarnessError | null>;
+  verifyActual(actual: readonly HostFileChange[]): HarnessError | null;
+}
+
+interface Baseline {
+  path: string;
+  content: Buffer | null;
+}
+
+function record(value: JsonValue): Record<string, JsonValue> | null {
+  return typeof value === "object" && value !== null && !Array.isArray(value) ? value : null;
+}
+
+function firstString(
+  value: Record<string, JsonValue>,
+  keys: readonly string[],
+  allowEmpty = false,
+): string | undefined {
+  for (const key of keys) {
+    const candidate = value[key];
+    if (typeof candidate === "string" && (allowEmpty || candidate.length > 0)) return candidate;
+  }
+  return undefined;
+}
+
+function inside(root: string, path: string): boolean {
+  const child = relative(root, path);
+  return child === "" || (!child.startsWith(`..${sep}`) && child !== ".." && !isAbsolute(child));
+}
+
+async function safePath(
+  candidate: string,
+  cwd: string,
+  workspaceRoots: readonly string[],
+): Promise<string | null> {
+  const target = resolve(cwd, candidate);
+  for (const configuredRoot of workspaceRoots) {
+    let root: string;
+    try {
+      root = await realpath(resolve(configuredRoot));
+    } catch {
+      continue;
+    }
+    if (!inside(root, target)) continue;
+    const child = relative(root, target);
+    let cursor = root;
+    for (const part of child.split(sep).filter(Boolean)) {
+      cursor = resolve(cursor, part);
+      try {
+        // 不跟随 symlink/junction：预览看到的文件必须与批准后真正落盘的文件一致。
+        if ((await lstat(cursor)).isSymbolicLink()) return null;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === "ENOENT") break;
+        return null;
+      }
+    }
+    return target;
+  }
+  return null;
+}
+
+async function optionalFile(path: string): Promise<Buffer | null> {
+  try {
+    const stat = await lstat(path);
+    if (!stat.isFile() || stat.isSymbolicLink()) return null;
+    return await readFile(path);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return null;
+    throw error;
+  }
+}
+
+function text(buffer: Buffer | null): string | null {
+  if (!buffer) return "";
+  if (buffer.includes(0)) return null;
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(buffer);
+  } catch {
+    return null;
+  }
+}
+
+function protocolError(message: string): HarnessError {
+  return { code: "protocolError", message, retryable: true };
+}
+
+function patchBody(unifiedDiff: string): unknown {
+  try {
+    const parsed = parsePatch(unifiedDiff);
+    if (parsed.length !== 1) return null;
+    // Diff header 的相对/绝对路径只是展示差异；安全边界仍以 estimator 的绝对基线为准。
+    return parsed[0]?.hunks.map(({ oldStart, oldLines, newStart, newLines, lines }) => ({
+      oldStart,
+      oldLines,
+      newStart,
+      newLines,
+      lines,
+    }));
+  } catch {
+    return null;
+  }
+}
+
+function sameChanges(
+  left: readonly HostFileChange[],
+  right: readonly HostFileChange[],
+  cwd: string,
+): boolean {
+  if (left.length !== right.length) return false;
+  return left.every((expected, index) => {
+    const actual = right[index];
+    const expectedBody = patchBody(expected.unifiedDiff);
+    const actualBody = actual ? patchBody(actual.unifiedDiff) : null;
+    return (
+      actual !== undefined &&
+      expected.kind === actual.kind &&
+      resolve(cwd, expected.path) === resolve(cwd, actual.path) &&
+      (expected.movePath === undefined) === (actual.movePath === undefined) &&
+      (expected.movePath === undefined ||
+        (actual.movePath !== undefined &&
+          resolve(cwd, expected.movePath) === resolve(cwd, actual.movePath))) &&
+      expectedBody !== null &&
+      actualBody !== null &&
+      JSON.stringify(expectedBody) === JSON.stringify(actualBody)
+    );
+  });
+}
+
+function lease(
+  changes: HostFileChange[],
+  baselines: Baseline[],
+  cwd: string,
+): PathActionPreviewLease {
+  return {
+    changes,
+    async revalidate() {
+      for (const baseline of baselines) {
+        const current = await optionalFile(baseline.path);
+        if (
+          (baseline.content === null) !== (current === null) ||
+          (baseline.content !== null && current !== null && !baseline.content.equals(current))
+        ) {
+          return protocolError(`File changed after preview: ${baseline.path}`);
+        }
+      }
+      return null;
+    },
+    verifyActual(actual) {
+      return sameChanges(changes, actual, cwd)
+        ? null
+        : protocolError("Actual File Change differs from the approved preview");
+    },
+  };
+}
+
+function patch(path: string, before: string, after: string, kind: HostFileChange["kind"]): string {
+  const oldName = kind === "add" ? "/dev/null" : `a/${path}`;
+  const newName = kind === "delete" ? "/dev/null" : `b/${path}`;
+  return createTwoFilesPatch(oldName, newName, before, after, "", "", { context: 3 });
+}
+
+function withinTextLimit(...values: string[]): boolean {
+  return values.reduce((sum, value) => sum + Buffer.byteLength(value), 0) <= MAX_TEXT_BYTES;
+}
+
+function exactOccurrence(text: string, search: string): number | null {
+  if (search.length === 0) return null;
+  const first = text.indexOf(search);
+  if (first < 0 || text.indexOf(search, first + search.length) >= 0) return null;
+  return first;
+}
+
+function patchPath(value: string): string | null {
+  if (value === "/dev/null") return null;
+  return value.startsWith("a/") || value.startsWith("b/") ? value.slice(2) : value;
+}
+
+async function unifiedPatchPreview(
+  patchText: string,
+  input: PathActionPreviewInput,
+): Promise<PathActionPreviewLease | null> {
+  let patches;
+  try {
+    patches = parsePatch(patchText);
+  } catch {
+    return null;
+  }
+  if (patches.length === 0 || patches.length > MAX_FILES) return null;
+  const changes: HostFileChange[] = [];
+  const baselines: Baseline[] = [];
+  const seen = new Set<string>();
+  let textBytes = 0;
+
+  for (const parsed of patches) {
+    const oldName = patchPath(parsed.oldFileName);
+    const newName = patchPath(parsed.newFileName);
+    if (!oldName && !newName) return null;
+    const oldPath = oldName ? await safePath(oldName, input.cwd, input.workspaceRoots) : null;
+    const newPath = newName ? await safePath(newName, input.cwd, input.workspaceRoots) : null;
+    if ((oldName && !oldPath) || (newName && !newPath)) return null;
+
+    const kind: HostFileChange["kind"] = !oldPath ? "add" : !newPath ? "delete" : "update";
+    const primaryPath = oldPath ?? newPath;
+    if (!primaryPath || seen.has(primaryPath)) return null;
+    seen.add(primaryPath);
+    const beforeBuffer = await optionalFile(primaryPath);
+    if ((kind === "add" && beforeBuffer) || (kind !== "add" && !beforeBuffer)) return null;
+    const before = text(beforeBuffer);
+    if (before === null) return null;
+    const after = applyPatch(before, parsed, { fuzzFactor: 0 });
+    if (after === false) return null;
+    textBytes += Buffer.byteLength(before) + Buffer.byteLength(after);
+    if (textBytes > MAX_TEXT_BYTES) return null;
+
+    const movePath = oldPath && newPath && oldPath !== newPath ? newPath : undefined;
+    if (movePath) {
+      const destination = await optionalFile(movePath);
+      if (destination) return null;
+      baselines.push({ path: movePath, content: destination });
+    }
+    baselines.push({ path: primaryPath, content: beforeBuffer });
+    changes.push({
+      path: primaryPath,
+      kind,
+      ...(movePath ? { movePath } : {}),
+      unifiedDiff: patch(primaryPath, before, after, kind),
+    });
+  }
+  return lease(changes, baselines, input.cwd);
+}
+
+/**
+ * 在不写盘、不执行命令的前提下推算路径类工具的 File Change。
+ * 输入不足、路径越界或内容不可安全解释时返回 null，让 Adapter 使用通用工具预览。
+ */
+export async function estimatePathActionPreview(
+  input: PathActionPreviewInput,
+): Promise<PathActionPreviewLease | null> {
+  const args = record(input.arguments);
+  if (!args || input.workspaceRoots.length === 0) return null;
+  const operation = input.toolName.toLowerCase();
+  if (operation.includes("patch")) {
+    const patchText = firstString(args, PATCH_KEYS);
+    return patchText ? unifiedPatchPreview(patchText, input) : null;
+  }
+  if (operation.includes("move")) {
+    const rawSource = firstString(args, MOVE_SOURCE_KEYS);
+    const rawTarget = firstString(args, MOVE_TARGET_KEYS);
+    if (!rawSource || !rawTarget) return null;
+    const source = await safePath(rawSource, input.cwd, input.workspaceRoots);
+    const target = await safePath(rawTarget, input.cwd, input.workspaceRoots);
+    if (!source || !target || source === target) return null;
+    const sourceBuffer = await optionalFile(source);
+    const targetBuffer = await optionalFile(target);
+    const before = text(sourceBuffer);
+    if (!sourceBuffer || targetBuffer || before === null || !withinTextLimit(before)) return null;
+    return lease(
+      [
+        {
+          path: source,
+          kind: "update",
+          movePath: target,
+          unifiedDiff: patch(source, before, before, "update"),
+        },
+      ],
+      [
+        { path: source, content: sourceBuffer },
+        { path: target, content: targetBuffer },
+      ],
+      input.cwd,
+    );
+  }
+
+  const rawPath = firstString(args, PATH_KEYS);
+  if (!rawPath) return null;
+  const path = await safePath(rawPath, input.cwd, input.workspaceRoots);
+  if (!path) return null;
+  const beforeBuffer = await optionalFile(path);
+  const before = text(beforeBuffer);
+  if (before === null) return null;
+
+  let after: string;
+  let kind: HostFileChange["kind"];
+  if (operation.includes("delete")) {
+    if (!beforeBuffer) return null;
+    after = "";
+    kind = "delete";
+  } else if (operation.includes("append")) {
+    const content = firstString(args, CONTENT_KEYS, true);
+    if (content === undefined) return null;
+    after = before + content;
+    kind = beforeBuffer ? "update" : "add";
+  } else if (/(?:edit|replace)/u.test(operation)) {
+    if (!beforeBuffer) return null;
+    const oldText = firstString(args, OLD_TEXT_KEYS, true);
+    const newText = firstString(args, NEW_TEXT_KEYS, true);
+    if (oldText === undefined || newText === undefined) return null;
+    const occurrence = exactOccurrence(before, oldText);
+    if (occurrence === null) return null;
+    after = before.slice(0, occurrence) + newText + before.slice(occurrence + oldText.length);
+    kind = "update";
+  } else if (/(?:write|create)/u.test(operation)) {
+    const content = firstString(args, CONTENT_KEYS, true);
+    if (content === undefined || (operation.includes("create") && beforeBuffer)) return null;
+    after = content;
+    kind = beforeBuffer ? "update" : "add";
+  } else {
+    return null;
+  }
+
+  if (!withinTextLimit(before, after)) return null;
+  const changes = [{ path, kind, unifiedDiff: patch(path, before, after, kind) }];
+  if (changes.length > MAX_FILES) return null;
+  return lease(changes, [{ path, content: beforeBuffer }], input.cwd);
+}
