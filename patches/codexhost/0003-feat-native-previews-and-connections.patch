index 0000000..10c9f31
--- /dev/null
+++ b/packages/host-runtime/src/connection-coordinator.ts
@@ -0,0 +1,146 @@
+export const EVERYONE_CODEX_HOST_CONTROL_URL_ENV = "EVERYONE_CODEX_HOST_CONTROL_URL";
+export const EVERYONE_CODEX_HOST_CONTROL_CAPABILITY_ENV = "EVERYONE_CODEX_HOST_CONTROL_CAPABILITY";
+
+const CONNECTION_REQUEST_TIMEOUT_MS = 30 * 60 * 1_000;
+const CONNECTION_RESPONSE_MAX_BYTES = 2 * 1024 * 1024;
+
+type GatewayFetch = (input: string, init: RequestInit) => Promise<Response>;
+
+export interface ConnectionCoordinator {
+  inspect(params: unknown): Promise<unknown>;
+  createCustom(params: unknown): Promise<unknown>;
+  createKeySession(params: unknown): Promise<unknown>;
+  startLogin(params: unknown): Promise<unknown>;
+  remove(params: unknown): Promise<unknown>;
+  apply(params: unknown): Promise<unknown>;
+}
+
+export interface GatewayConnectionCoordinatorOptions {
+  controlUrl: string;
+  capability: string;
+  fetch?: GatewayFetch;
+  timeoutMs?: number;
+}
+
+function controlOrigin(value: string): string {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error("Connections control URL must be an HTTP 127.0.0.1 origin");
+  }
+  if (
+    url.protocol !== "http:" ||
+    url.hostname !== "127.0.0.1" ||
+    url.username !== "" ||
+    url.password !== "" ||
+    url.search !== "" ||
+    url.hash !== "" ||
+    url.pathname !== "/"
+  ) {
+    throw new Error("Connections control URL must be an HTTP 127.0.0.1 origin");
+  }
+  return url.origin;
+}
+
+/**
+ * 连接中心的 Host-only 代理。Capability 只保存在当前对象闭包中，Renderer 与诊断输出
+ * 永远看不到它；Gateway 的错误正文同样不会越过本机控制边界。
+ */
+export class GatewayConnectionCoordinator implements ConnectionCoordinator {
+  readonly #origin: string;
+  readonly #capability: string;
+  readonly #fetch: GatewayFetch;
+  readonly #timeoutMs: number;
+
+  constructor(options: GatewayConnectionCoordinatorOptions) {
+    this.#origin = controlOrigin(options.controlUrl);
+    if (!options.capability || options.capability.length > 16_384) {
+      throw new Error("Connections control capability is invalid");
+    }
+    if (
+      options.timeoutMs !== undefined &&
+      (!Number.isSafeInteger(options.timeoutMs) || options.timeoutMs < 1)
+    ) {
+      throw new Error("Connections control timeout is invalid");
+    }
+    this.#capability = options.capability;
+    this.#fetch = options.fetch ?? globalThis.fetch.bind(globalThis);
+    this.#timeoutMs = options.timeoutMs ?? CONNECTION_REQUEST_TIMEOUT_MS;
+  }
+
+  inspect(params: unknown): Promise<unknown> {
+    return this.#post("/v1/connections/inspect", params);
+  }
+
+  createCustom(params: unknown): Promise<unknown> {
+    return this.#post("/v1/connections/custom/create", params);
+  }
+
+  createKeySession(params: unknown): Promise<unknown> {
+    return this.#post("/v1/connections/key-session", params);
+  }
+
+  startLogin(params: unknown): Promise<unknown> {
+    return this.#post("/v1/connections/login", params);
+  }
+
+  remove(params: unknown): Promise<unknown> {
+    return this.#post("/v1/connections/remove", params);
+  }
+
+  apply(params: unknown): Promise<unknown> {
+    return this.#post("/v1/connections/apply", params);
+  }
+
+  async #post(pathname: string, params: unknown): Promise<unknown> {
+    const abortController = new AbortController();
+    const timeout = setTimeout(() => abortController.abort(), this.#timeoutMs);
+    timeout.unref?.();
+    let response: Response;
+    try {
+      response = await this.#fetch(`${this.#origin}${pathname}`, {
+        method: "POST",
+        redirect: "error",
+        signal: abortController.signal,
+        headers: {
+          authorization: `Bearer ${this.#capability}`,
+          "content-type": "application/json",
+        },
+        body: JSON.stringify(params),
+      });
+    } catch {
+      throw new Error("Connections Gateway request failed");
+    } finally {
+      clearTimeout(timeout);
+    }
+    if (!response.ok) {
+      throw new Error(`Connections Gateway request failed (HTTP ${response.status})`);
+    }
+    const contentLength = Number(response.headers.get("content-length"));
+    if (Number.isFinite(contentLength) && contentLength > CONNECTION_RESPONSE_MAX_BYTES) {
+      throw new Error("Connections Gateway returned an invalid response");
+    }
+    try {
+      const body = await response.text();
+      if (Buffer.byteLength(body, "utf8") > CONNECTION_RESPONSE_MAX_BYTES) {
+        throw new Error("response too large");
+      }
+      return JSON.parse(body) as unknown;
+    } catch {
+      throw new Error("Connections Gateway returned an invalid response");
+    }
+  }
+}
+
+export function createGatewayConnectionCoordinatorFromEnvironment(
+  environment: NodeJS.ProcessEnv,
+): GatewayConnectionCoordinator | null {
+  const controlUrl = environment[EVERYONE_CODEX_HOST_CONTROL_URL_ENV];
+  const capability = environment[EVERYONE_CODEX_HOST_CONTROL_CAPABILITY_ENV];
+  if (!controlUrl && !capability) return null;
+  if (!controlUrl || !capability) {
+    throw new Error("Connections control environment is incomplete");
+  }
+  return new GatewayConnectionCoordinator({ controlUrl, capability });
+}
