@@ -0,0 +1,200 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  connectionInspectionSchema,
+  customConnectionCreateParamsSchema,
+} from "@codexhost/shared-contracts";
+
+describe("Connection contracts", () => {
+  it("accepts a non-sensitive snapshot grouped by scope", () => {
+    expect(
+      connectionInspectionSchema.parse({
+        connections: [
+          {
+            id: "router.deepseek",
+            displayName: "DeepSeek",
+            scope: "shared-model-source",
+            owner: "router",
+            kind: "router-provider",
+            state: "connected",
+            detail: "API provider",
+            consumers: ["codex", "pi", "omp"],
+            modelCount: 2,
+            pending: false,
+            loginAvailable: false,
+            removable: false,
+          },
+          {
+            id: "harness.claude",
+            displayName: "Claude Code",
+            scope: "harness-identity",
+            owner: "harness",
+            kind: "harness-login",
+            state: "needs-login",
+            detail: null,
+            consumers: ["claude-code"],
+            modelCount: 0,
+            pending: false,
+            loginAvailable: true,
+            removable: false,
+          },
+        ],
+        pendingCount: 0,
+        applyRequired: false,
+        activity: { activeTurnCount: 0 },
+        operation: null,
+      }),
+    ).toMatchObject({ connections: [{ modelCount: 2 }, { state: "needs-login" }] });
+  });
+
+  it("accepts all three custom API protocols and multiple Model IDs", () => {
+    for (const protocol of [
+      "openai-responses",
+      "openai-chat-completions",
+      "anthropic-messages",
+    ] as const) {
+      expect(
+        customConnectionCreateParamsSchema.parse({
+          draft: {
+            displayName: "Private API",
+            baseUrl: "https://api.example.com/v1",
+            protocol,
+            modelIds: ["model-a", "model-b"],
+            keyless: false,
+          },
+          secret: { mode: "secure-prompt" },
+        }),
+      ).toMatchObject({ draft: { protocol, modelIds: ["model-a", "model-b"] } });
+    }
+  });
+
+  it("allows keyless only for a loopback Base URL", () => {
+    const loopback = {
+      draft: {
+        displayName: "Local runtime",
+        baseUrl: "http://127.0.0.1:8080/v1",
+        protocol: "openai-responses",
+        modelIds: ["local-model"],
+        keyless: true,
+      },
+      secret: { mode: "keyless" },
+    };
+    expect(customConnectionCreateParamsSchema.parse(loopback)).toEqual(loopback);
+    expect(() =>
+      customConnectionCreateParamsSchema.parse({
+        ...loopback,
+        draft: { ...loopback.draft, baseUrl: "https://api.example.com/v1" },
+      }),
+    ).toThrow(/loopback/iu);
+  });
+
+  it.each([
+    "http://api.example.com/v1",
+    "https://user:pass@api.example.com/v1",
+    "https://api.example.com/v1?token=secret",
+    "https://api.example.com/v1#secret",
+  ])("rejects unsafe remote Base URL %s", (baseUrl) => {
+    expect(() =>
+      customConnectionCreateParamsSchema.parse({
+        draft: {
+          displayName: "Unsafe",
+          baseUrl,
+          protocol: "openai-responses",
+          modelIds: ["model"],
+          keyless: false,
+        },
+        secret: { mode: "secure-prompt" },
+      }),
+    ).toThrow();
+  });
+
+  it("rejects duplicate consumers, Model IDs, and Connection IDs", () => {
+    const connection = {
+      id: "duplicate",
+      displayName: "Duplicate",
+      scope: "shared-model-source",
+      owner: "router",
+      kind: "router-provider",
+      state: "connected",
+      detail: null,
+      consumers: ["codex", "codex"],
+      modelCount: 1,
+      pending: false,
+      loginAvailable: false,
+      removable: false,
+    };
+    expect(() =>
+      connectionInspectionSchema.parse({
+        connections: [connection],
+        pendingCount: 0,
+        applyRequired: false,
+        activity: { activeTurnCount: 1 },
+        operation: null,
+      }),
+    ).toThrow(/consumer/iu);
+    expect(() =>
+      customConnectionCreateParamsSchema.parse({
+        draft: {
+          displayName: "Duplicate Models",
+          baseUrl: "https://api.example.com/v1",
+          protocol: "openai-responses",
+          modelIds: ["same", "same"],
+          keyless: false,
+        },
+        secret: { mode: "secure-prompt" },
+      }),
+    ).toThrow(/Model/iu);
+    expect(() =>
+      connectionInspectionSchema.parse({
+        connections: [
+          { ...connection, consumers: ["codex"] },
+          { ...connection, consumers: [] },
+        ],
+        pendingCount: 0,
+        applyRequired: false,
+        activity: { activeTurnCount: 0 },
+        operation: null,
+      }),
+    ).toThrow(/Connection/iu);
+  });
+
+  it("rejects credentials from renderer-visible snapshots and create requests", () => {
+    expect(() =>
+      connectionInspectionSchema.parse({
+        connections: [
+          {
+            id: "custom.secret",
+            displayName: "Secret",
+            scope: "shared-model-source",
+            owner: "router",
+            kind: "custom-api",
+            state: "connected",
+            detail: null,
+            consumers: ["codex"],
+            modelCount: 1,
+            pending: false,
+            loginAvailable: false,
+            removable: true,
+            apiKey: "fixture-must-not-cross-contract",
+          },
+        ],
+        pendingCount: 0,
+        applyRequired: false,
+        activity: { activeTurnCount: 0 },
+        operation: null,
+      }),
+    ).toThrow();
+    expect(() =>
+      customConnectionCreateParamsSchema.parse({
+        draft: {
+          displayName: "Secret",
+          baseUrl: "https://api.example.com/v1",
+          protocol: "openai-responses",
+          modelIds: ["model"],
+          keyless: false,
+        },
+        secret: { mode: "encrypted", apiKey: "plaintext" },
+      }),
+    ).toThrow();
+  });
+});
