+import { mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { describe, expect, it } from "vitest";
+
+import { estimatePathActionPreview } from "../src/index.js";
+
+describe("path Action preview", () => {
+  it("estimates Write/Create from common path and content aliases without changing files", async () => {
+    const root = await mkdtemp(join(tmpdir(), "codexhost-preview-"));
+    try {
+      const existing = join(root, "existing.txt");
+      await writeFile(existing, "old\n", "utf8");
+
+      const write = await estimatePathActionPreview({
+        toolName: "Write",
+        arguments: { file_path: "existing.txt", content: "new\n" },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const create = await estimatePathActionPreview({
+        toolName: "CreateFile",
+        arguments: { filePath: "created.txt", text: "created\n" },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+
+      expect(write?.changes).toMatchObject([
+        { path: existing, kind: "update", unifiedDiff: expect.stringContaining("+new") },
+      ]);
+      expect(create?.changes).toMatchObject([
+        {
+          path: join(root, "created.txt"),
+          kind: "add",
+          unifiedDiff: expect.stringContaining("+created"),
+        },
+      ]);
+      expect(await readFile(existing, "utf8")).toBe("old\n");
+      await expect(readFile(join(root, "created.txt"), "utf8")).rejects.toMatchObject({
+        code: "ENOENT",
+      });
+    } finally {
+      await rm(root, { recursive: true, force: true });
+    }
+  });
+
+  it("estimates Append, Edit, Replace, Delete, and Move while rejecting ambiguous replacement", async () => {
+    const root = await mkdtemp(join(tmpdir(), "codexhost-preview-"));
+    try {
+      await writeFile(join(root, "append.txt"), "first\n", "utf8");
+      await writeFile(join(root, "edit.txt"), "alpha beta gamma\n", "utf8");
+      await writeFile(join(root, "ambiguous.txt"), "same same\n", "utf8");
+      await writeFile(join(root, "delete.txt"), "remove\n", "utf8");
+      await writeFile(join(root, "from.txt"), "move\n", "utf8");
+
+      const append = await estimatePathActionPreview({
+        toolName: "AppendFile",
+        arguments: { path: "append.txt", text: "second\n" },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const edit = await estimatePathActionPreview({
+        toolName: "Edit",
+        arguments: {
+          target: "edit.txt",
+          old_string: "beta",
+          new_string: "delta",
+        },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const ambiguous = await estimatePathActionPreview({
+        toolName: "Replace",
+        arguments: {
+          filePath: "ambiguous.txt",
+          oldString: "same",
+          newString: "changed",
+        },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const deleted = await estimatePathActionPreview({
+        toolName: "DeleteFile",
+        arguments: { file_path: "delete.txt" },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const moved = await estimatePathActionPreview({
+        toolName: "MoveFile",
+        arguments: { source: "from.txt", target: "to.txt" },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+
+      expect(append?.changes[0]).toMatchObject({
+        kind: "update",
+        unifiedDiff: expect.stringContaining("+second"),
+      });
+      expect(edit?.changes[0]).toMatchObject({
+        kind: "update",
+        unifiedDiff: expect.stringContaining("+alpha delta gamma"),
+      });
+      expect(ambiguous).toBeNull();
+      expect(deleted?.changes[0]).toMatchObject({
+        path: join(root, "delete.txt"),
+        kind: "delete",
+        unifiedDiff: expect.stringContaining("-remove"),
+      });
+      expect(moved?.changes).toMatchObject([
+        {
+          path: join(root, "from.txt"),
+          movePath: join(root, "to.txt"),
+          kind: "update",
+        },
+      ]);
+    } finally {
+      await rm(root, { recursive: true, force: true });
+    }
+  });
+
+  it("estimates a multi-file unified patch", async () => {
+    const root = await mkdtemp(join(tmpdir(), "codexhost-preview-"));
+    try {
+      await writeFile(join(root, "first.txt"), "old\n", "utf8");
+      const unifiedDiff = [
+        "--- a/first.txt",
+        "+++ b/first.txt",
+        "@@ -1 +1 @@",
+        "-old",
+        "+new",
+        "--- /dev/null",
+        "+++ b/second.txt",
+        "@@ -0,0 +1 @@",
+        "+second",
+        "",
+      ].join("\n");
+
+      const preview = await estimatePathActionPreview({
+        toolName: "ApplyPatch",
+        arguments: { unified_diff: unifiedDiff },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+
+      expect(preview?.changes).toMatchObject([
+        {
+          path: join(root, "first.txt"),
+          kind: "update",
+          unifiedDiff: expect.stringContaining("+new"),
+        },
+        {
+          path: join(root, "second.txt"),
+          kind: "add",
+          unifiedDiff: expect.stringContaining("+second"),
+        },
+      ]);
+      expect(await readFile(join(root, "first.txt"), "utf8")).toBe("old\n");
+    } finally {
+      await rm(root, { recursive: true, force: true });
+    }
+  });
+
+  it("falls back for workspace escape, reparse points, binary data, and hard limits", async () => {
+    const root = await mkdtemp(join(tmpdir(), "codexhost-preview-root-"));
+    const outside = await mkdtemp(join(tmpdir(), "codexhost-preview-outside-"));
+    try {
+      await writeFile(join(outside, "secret.txt"), "secret\n", "utf8");
+      await writeFile(join(root, "binary.bin"), Buffer.from([0, 1, 2]));
+      const link = join(root, "junction");
+      await symlink(outside, link, process.platform === "win32" ? "junction" : "dir");
+
+      const escaped = await estimatePathActionPreview({
+        toolName: "Write",
+        arguments: {
+          path: join("..", outside.split(/[\\/]/u).at(-1) ?? "", "secret.txt"),
+          text: "x",
+        },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const reparsed = await estimatePathActionPreview({
+        toolName: "Write",
+        arguments: { path: join("junction", "secret.txt"), text: "x" },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const binary = await estimatePathActionPreview({
+        toolName: "Write",
+        arguments: { path: "binary.bin", text: "x" },
+        cwd: root,
+        workspaceRoots: [root],
+      });
+      const oversized = await estimatePathActionPreview({
+        toolName: "Create",
+        arguments: { path: "large.txt", text: "x".repeat(4 * 1024 * 1024 + 1) },
+        cwd: root,
+        workspaceRoots: [root],
