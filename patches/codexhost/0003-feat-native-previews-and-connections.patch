+import { z } from "zod";
+
+const nonBlankTextSchema = z.string().refine((value) => value.trim().length > 0, {
+  message: "Value must not be empty or whitespace",
+});
+
+export const connectionIdSchema = nonBlankTextSchema
+  .max(256)
+  .regex(/^[A-Za-z0-9._~-]+$/u, "Connection ID must use transport-safe characters")
+  .brand<"ConnectionId">();
+
+export const connectionScopeSchema = z.enum(["shared-model-source", "harness-identity"]);
+export const connectionOwnerSchema = z.enum(["router", "codex2", "webgpt", "harness"]);
+export const connectionKindSchema = z.enum([
+  "router-provider",
+  "custom-api",
+  "codex2",
+  "webgpt",
+  "router-oauth",
+  "harness-login",
+]);
+export const connectionStateSchema = z.enum(["connected", "needs-login", "checking", "error"]);
+export const connectionProtocolSchema = z.enum([
+  "openai-responses",
+  "openai-chat-completions",
+  "anthropic-messages",
+]);
+export const connectionConsumerSchema = z.enum([
+  "codex",
+  "pi",
+  "omp",
+  "deepseek-harness",
+  "grok",
+  "claude-code",
+]);
+
+const uniqueConsumersSchema = z
+  .array(connectionConsumerSchema)
+  .max(6)
+  .superRefine((values, ctx) => {
+    const seen = new Set<string>();
+    for (const [index, value] of values.entries()) {
+      if (seen.has(value)) {
+        ctx.addIssue({
+          code: "custom",
+          path: [index],
+          message: "Connection consumers must be unique",
+        });
+      }
+      seen.add(value);
+    }
+  });
+
+export const connectionSnapshotSchema = z
+  .object({
+    id: connectionIdSchema,
+    displayName: nonBlankTextSchema.max(128),
+    scope: connectionScopeSchema,
+    owner: connectionOwnerSchema,
+    kind: connectionKindSchema,
+    state: connectionStateSchema,
+    detail: z.string().max(1_024).nullable(),
+    consumers: uniqueConsumersSchema,
+    modelCount: z.number().int().nonnegative(),
+    pending: z.boolean(),
+    loginAvailable: z.boolean(),
+    removable: z.boolean(),
+    protocol: connectionProtocolSchema.optional(),
+    baseUrl: z.string().max(2_048).optional(),
+  })
+  .strict();
+
+export const connectionOperationSchema = z
+  .object({
+    id: nonBlankTextSchema.max(256),
+    kind: z.enum(["create", "login", "remove", "apply"]),
+    state: z.enum(["running", "waiting-user", "succeeded", "failed"]),
+    message: z.string().max(2_000).nullable(),
+  })
+  .strict();
+
+/** Renderer 可见的只读目录；禁止在此契约中加入 API Key、OAuth Token 或登录会话。 */
+export const connectionInspectionSchema = z
+  .object({
+    connections: z.array(connectionSnapshotSchema).max(256),
+    pendingCount: z.number().int().nonnegative(),
+    applyRequired: z.boolean(),
+    activity: z.object({ activeTurnCount: z.number().int().nonnegative() }).strict(),
+    operation: connectionOperationSchema.nullable(),
+  })
+  .strict()
+  .superRefine((inspection, context) => {
+    const ids = new Set<string>();
+    for (const [index, connection] of inspection.connections.entries()) {
+      if (ids.has(connection.id)) {
+        context.addIssue({
+          code: "custom",
+          path: ["connections", index, "id"],
+          message: "Connection IDs must be unique",
+        });
+      }
+      ids.add(connection.id);
+    }
+    const pendingCount = inspection.connections.filter(({ pending }) => pending).length;
+    if (pendingCount !== inspection.pendingCount) {
+      context.addIssue({
+        code: "custom",
+        path: ["pendingCount"],
+        message: "pendingCount must match pending Connections",
+      });
+    }
+    if (inspection.applyRequired !== pendingCount > 0) {
+      context.addIssue({
+        code: "custom",
+        path: ["applyRequired"],
+        message: "applyRequired must match pending Connections",
+      });
+    }
+  });
+
+interface ParsedConnectionUrl {
+  readonly protocol: "http:" | "https:";
+  readonly hostname: string;
+  readonly hasUserinfo: boolean;
+}
+
+function parsedConnectionUrl(value: string): ParsedConnectionUrl | null {
+  const match = /^(https?):\/\/([^/?#\s]+)(?:\/[^?#\s]*)?$/u.exec(value);
+  if (!match?.[1] || !match[2]) return null;
+  const hasUserinfo = match[2].includes("@");
+  const authority = match[2].slice(match[2].lastIndexOf("@") + 1);
+  const hostname = authority.startsWith("[")
+    ? authority.slice(1, authority.indexOf("]"))
+    : (authority.split(":", 1)[0] ?? "");
+  if (!hostname) return null;
+  return { protocol: `${match[1]}:` as "http:" | "https:", hostname, hasUserinfo };
+}
+
+function isLoopbackUrl(value: string): boolean {
+  const parsed = parsedConnectionUrl(value);
+  if (!parsed) return false;
+  const hostname = parsed.hostname.toLowerCase();
+  return hostname === "localhost" || hostname === "127.0.0.1" || hostname === "::1";
+}
+
+export const connectionBaseUrlSchema = nonBlankTextSchema
+  .max(2_048)
+  .pipe(z.url())
+  .superRefine((value, context) => {
+    const parsed = parsedConnectionUrl(value);
+    if (!parsed) {
+      context.addIssue({ code: "custom", message: "Base URL must be a valid URL" });
+      return;
+    }
+    if (parsed.hasUserinfo || value.includes("?") || value.includes("#")) {
+      context.addIssue({
+        code: "custom",
+        message: "Base URL must not contain userinfo, query, or fragment",
+      });
+    }
+    if (parsed.protocol !== "https:" && !isLoopbackUrl(value)) {
+      context.addIssue({ code: "custom", message: "Remote Base URL must use HTTPS" });
+    }
+    if (parsed.protocol !== "https:" && parsed.protocol !== "http:") {
+      context.addIssue({ code: "custom", message: "Base URL must use HTTP or HTTPS" });
+    }
+  });
+
+const connectionModelIdSchema = nonBlankTextSchema.max(512);
+const uniqueModelIdsSchema = z
+  .array(connectionModelIdSchema)
+  .min(1)
+  .max(128)
+  .superRefine((values, ctx) => {
+    const seen = new Set<string>();
+    for (const [index, value] of values.entries()) {
+      if (seen.has(value)) {
+        ctx.addIssue({ code: "custom", path: [index], message: "Model IDs must be unique" });
+      }
+      seen.add(value);
+    }
+  });
+
+export const customConnectionDraftSchema = z
+  .object({
+    displayName: nonBlankTextSchema.max(128),
+    baseUrl: connectionBaseUrlSchema,
+    protocol: connectionProtocolSchema,
+    modelIds: uniqueModelIdsSchema,
+    keyless: z.boolean(),
+  })
+  .strict()
+  .superRefine((draft, context) => {
+    if (draft.keyless && !isLoopbackUrl(draft.baseUrl)) {
+      context.addIssue({
+        code: "custom",
+        path: ["baseUrl"],
+        message: "Keyless Connections are allowed only for a loopback Base URL",
+      });
+    }
+  });
+
+export const connectionSecretInputSchema = z.discriminatedUnion("mode", [
+  z.object({ mode: z.literal("secure-prompt") }).strict(),
+  z.object({ mode: z.literal("keyless") }).strict(),
+  z
+    .object({
+      mode: z.literal("encrypted"),
+      keySessionId: nonBlankTextSchema.max(256),
+      algorithm: z.literal("RSA-OAEP-256"),
+      ciphertextBase64: nonBlankTextSchema.max(32_768).regex(/^[A-Za-z0-9+/]+={0,2}$/u),
+    })
+    .strict(),
+]);
+
+/** 自定义连接写入边界；密钥只能由本机安全输入或一次性 RSA 密文承载。 */
+export const customConnectionCreateParamsSchema = z
+  .object({
+    draft: customConnectionDraftSchema,
+    secret: connectionSecretInputSchema,
+  })
+  .strict()
+  .superRefine(({ draft, secret }, context) => {
+    if (draft.keyless !== (secret.mode === "keyless")) {
+      context.addIssue({
+        code: "custom",
+        path: ["secret", "mode"],
+        message: "Keyless draft and secret mode must agree",
+      });
+    }
+  });
+
+export const connectionReceiptSchema = z
+  .object({ connection: connectionSnapshotSchema, applyRequired: z.boolean() })
+  .strict();
+export const connectionKeySessionResultSchema = z
+  .object({
+    id: nonBlankTextSchema.max(256),
+    publicKeySpkiBase64: nonBlankTextSchema.max(16_384).regex(/^[A-Za-z0-9+/]+={0,2}$/u),
+    expiresAtMs: z.number().int().positive(),
+  })
+  .strict();
+export const connectionLoginStartParamsSchema = z.object({ id: connectionIdSchema }).strict();
+export const connectionLoginOperationSchema = connectionOperationSchema.refine(
+  ({ kind }) => kind === "login",
+  { message: "Login operation must have login kind" },
+);
+export const connectionRemoveParamsSchema = z.object({ id: connectionIdSchema }).strict();
+export const connectionRemoveReceiptSchema = z
+  .object({ id: connectionIdSchema, pending: z.literal(true) })
+  .strict();
+export const connectionApplyParamsSchema = z.object({}).strict();
+export const connectionApplyReceiptSchema = z
+  .object({
+    operation: connectionOperationSchema,
+    applyRequired: z.boolean(),
+    publishedModelCount: z.number().int().nonnegative(),
+  })
+  .strict();
+
+export type ConnectionId = z.infer<typeof connectionIdSchema>;
+export type ConnectionScope = z.infer<typeof connectionScopeSchema>;
+export type ConnectionOwner = z.infer<typeof connectionOwnerSchema>;
+export type ConnectionKind = z.infer<typeof connectionKindSchema>;
+export type ConnectionState = z.infer<typeof connectionStateSchema>;
+export type ConnectionProtocol = z.infer<typeof connectionProtocolSchema>;
+export type ConnectionConsumer = z.infer<typeof connectionConsumerSchema>;
+export type ConnectionSnapshot = z.infer<typeof connectionSnapshotSchema>;
+export type ConnectionOperation = z.infer<typeof connectionOperationSchema>;
+export type ConnectionInspection = z.infer<typeof connectionInspectionSchema>;
+export type CustomConnectionDraft = z.infer<typeof customConnectionDraftSchema>;
+export type ConnectionSecretInput = z.infer<typeof connectionSecretInputSchema>;
+export type CustomConnectionCreateParams = z.infer<typeof customConnectionCreateParamsSchema>;
+export type ConnectionReceipt = z.infer<typeof connectionReceiptSchema>;
+export type ConnectionKeySessionResult = z.infer<typeof connectionKeySessionResultSchema>;
+export type ConnectionLoginStartParams = z.infer<typeof connectionLoginStartParamsSchema>;
+export type ConnectionLoginOperation = z.infer<typeof connectionLoginOperationSchema>;
+export type ConnectionRemoveParams = z.infer<typeof connectionRemoveParamsSchema>;
+export type ConnectionRemoveReceipt = z.infer<typeof connectionRemoveReceiptSchema>;
+export type ConnectionApplyParams = z.infer<typeof connectionApplyParamsSchema>;
+export type ConnectionApplyReceipt = z.infer<typeof connectionApplyReceiptSchema>;
