@@ -0,0 +1,145 @@
+import { describe, expect, it } from "vitest";
+import {
+  ActionPreviewModule,
+  type HarnessOutput,
+  type HostApprovalInteraction,
+} from "../src/index.js";
+import {
+  hostInteractionIdSchema,
+  hostItemIdSchema,
+  hostTurnIdSchema,
+} from "@codexhost/shared-contracts";
+
+const turnId = hostTurnIdSchema.parse("turn-preview");
+const itemId = hostItemIdSchema.parse("item-preview");
+
+describe("ActionPreviewModule", () => {
+  it("reuses one Host Item for a native call through approval, update, and completion", () => {
+    const outputs: HarnessOutput[] = [];
+    const previews = new ActionPreviewModule((output) => outputs.push(output));
+    const lease = previews.begin({
+      turnId,
+      nativeCallId: "native-call-1",
+      item: { type: "commandExecution", itemId, command: "git status --short" },
+    });
+    const repeated = previews.begin({
+      turnId,
+      nativeCallId: "native-call-1",
+      item: { type: "commandExecution", itemId, command: "git status --short" },
+    });
+    const approval: HostApprovalInteraction = {
+      type: "approval",
+      interactionId: hostInteractionIdSchema.parse("approval-preview"),
+      turnId,
+      title: "Allow command?",
+      subject: { type: "nativeAction" },
+      actions: [
+        { id: "allow", label: "Allow once", effect: "allowOnce" },
+        { id: "deny", label: "Deny", effect: "deny" },
+      ],
+    };
+
+    lease.linkApproval(approval);
+    lease.appendOutput("clean\n");
+    lease.complete({ outcome: { status: "succeeded" } });
+
+    expect(repeated).toBe(lease);
+    expect(outputs).toEqual([
+      {
+        kind: "event",
+        event: {
+          type: "item.started",
+          turnId,
+          item: { type: "commandExecution", itemId, command: "git status --short" },
+        },
+      },
+      { kind: "interaction", interaction: { ...approval, itemId } },
+      {
+        kind: "event",
+        event: {
+          type: "item.updated",
+          turnId,
+          itemId,
+          update: { type: "output.append", text: "clean\n" },
+        },
+      },
+      {
+        kind: "event",
+        event: {
+          type: "item.completed",
+          turnId,
+          snapshot: {
+            item: {
+              type: "commandExecution",
+              itemId,
+              command: "git status --short",
+              output: "clean\n",
+            },
+            outcome: { status: "succeeded" },
+          },
+        },
+      },
+    ]);
+  });
+
+  it("restores snapshots and finalizes every still-open Item in the Turn", () => {
+    const outputs: HarnessOutput[] = [];
+    const previews = new ActionPreviewModule((output) => outputs.push(output));
+    previews.begin({
+      turnId,
+      nativeCallId: "native-call-2",
+      item: {
+        type: "toolExecution",
+        itemId: hostItemIdSchema.parse("tool-preview"),
+        toolName: "read",
+        arguments: { path: "README.md" },
+      },
+    });
+
+    previews.finalizeTurn(turnId, { status: "cancelled", reason: "turn ended" });
+    const restored = previews.restore([
+      {
+        nativeCallId: "history-call",
+        item: { type: "agentMessage", itemId, text: "done" },
+        outcome: { status: "succeeded" },
+      },
+    ]);
+
+    expect(outputs.at(-1)).toMatchObject({
+      kind: "event",
+      event: {
+        type: "item.completed",
+        snapshot: { outcome: { status: "cancelled", reason: "turn ended" } },
+      },
+    });
+    expect(restored).toEqual([
+      {
+        item: { type: "agentMessage", itemId, text: "done" },
+        outcome: { status: "succeeded" },
+      },
+    ]);
+  });
+
+  it("rejects late output and cross-Item native call reuse", () => {
+    const previews = new ActionPreviewModule(() => undefined);
+    const lease = previews.begin({
+      turnId,
+      nativeCallId: "native-call-3",
+      item: { type: "commandExecution", itemId, command: "echo done" },
+    });
+    lease.complete({ outcome: { status: "succeeded" } });
+
+    expect(() => lease.appendOutput("late")).toThrow("follows Item completion");
+    expect(() =>
+      previews.begin({
+        turnId,
+        nativeCallId: "native-call-3",
+        item: {
+          type: "commandExecution",
+          itemId: hostItemIdSchema.parse("another-item"),
+          command: "echo other",
+        },
+      }),
+    ).toThrow("reused for another Host Item");
+  });
+});
