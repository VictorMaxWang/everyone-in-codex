diff --git a/packages/renderer-extension/src/settings/connections.ts b/packages/renderer-extension/src/settings/connections.ts
new file mode 100644
index 0000000..761f83b
--- /dev/null
+++ b/packages/renderer-extension/src/settings/connections.ts
@@ -0,0 +1,434 @@
+import type {
+  ConnectionConsumer,
+  ConnectionInspection,
+  ConnectionProtocol,
+  ConnectionScope,
+  ConnectionSnapshot,
+  CustomConnectionDraft,
+} from "@codexhost/shared-contracts";
+
+import type { RendererConnectionClient } from "../renderer-model-client.js";
+import type { RendererSettingsPageMountContext } from "./core.js";
+import type { RendererSettingsMessages } from "./localization.js";
+
+const PROTOCOLS: readonly ConnectionProtocol[] = [
+  "openai-responses",
+  "openai-chat-completions",
+  "anthropic-messages",
+];
+
+const CONSUMER_LABELS: Readonly<Record<ConnectionConsumer, string>> = Object.freeze({
+  codex: "Codex",
+  pi: "Pi",
+  omp: "OMP",
+  "deepseek-harness": "DeepSeek Harness",
+  grok: "Grok",
+  "claude-code": "Claude Code",
+});
+
+function statusLabel(connection: ConnectionSnapshot, messages: RendererSettingsMessages): string {
+  if (connection.state === "connected") return messages.connectionCenter.connected;
+  if (connection.state === "needs-login") return messages.connectionCenter.needsLogin;
+  if (connection.state === "checking") return messages.connectionCenter.checking;
+  return messages.connectionCenter.error;
+}
+
+function protocolLabel(protocol: ConnectionProtocol, messages: RendererSettingsMessages): string {
+  if (protocol === "openai-responses") return messages.connectionCenter.protocolResponses;
+  if (protocol === "openai-chat-completions") return messages.connectionCenter.protocolChat;
+  return messages.connectionCenter.protocolAnthropic;
+}
+
+function fieldLabel(document: Document, text: string, control: HTMLElement): HTMLLabelElement {
+  const label = document.createElement("label");
+  label.className = "settings-connection-form__field";
+  const caption = document.createElement("span");
+  caption.textContent = text;
+  label.append(caption, control);
+  return label;
+}
+
+function createActionButton(
+  document: Document,
+  action: string,
+  text: string,
+  secondary = false,
+): HTMLButtonElement {
+  const button = document.createElement("button");
+  button.type = "button";
+  button.className = secondary
+    ? "settings-command-button settings-command-button--secondary"
+    : "settings-command-button";
+  button.dataset.connectionAction = action;
+  button.textContent = text;
+  return button;
+}
+
+/** 挂载非持久化的连接中心；表单关闭或卸载时会主动清空遮罩密钥输入。 */
+export function mountRendererConnectionCenter(
+  context: RendererSettingsPageMountContext,
+  messages: RendererSettingsMessages,
+  getClient: () => RendererConnectionClient | null,
+): () => void {
+  const document = context.content.ownerDocument;
+  const root = document.createElement("section");
+  root.className = "settings-connection-center";
+  root.dataset.connectionCenter = "true";
+
+  const description = document.createElement("p");
+  description.className = "settings-page-description";
+  description.textContent = messages.connectionCenter.description;
+  const toolbar = document.createElement("div");
+  toolbar.className = "settings-connection-center__toolbar";
+  const add = createActionButton(document, "add-custom", messages.connectionCenter.addCustom, true);
+  const apply = createActionButton(document, "apply", messages.connectionCenter.apply);
+  toolbar.append(add, apply);
+  const status = document.createElement("div");
+  status.className = "settings-connection-center__status";
+  status.setAttribute("role", "status");
+  status.setAttribute("aria-live", "polite");
+  const formSlot = document.createElement("div");
+  formSlot.className = "settings-connection-center__form-slot";
+  const groups = document.createElement("div");
+  groups.className = "settings-connection-groups";
+  root.append(description, toolbar, status, formSlot, groups);
+  context.content.append(root);
+
+  let disposed = false;
+  let busy = false;
+  let snapshot: ConnectionInspection | null = null;
+  let formOpen = false;
+  let mountedApiKey: HTMLInputElement | null = null;
+  let transientStatus: string | null = null;
+
+  const showTransientStatus = (text: string): void => {
+    transientStatus = text;
+    status.textContent = text;
+  };
+
+  const runOperation = <T>(operation: () => Promise<T>, success?: (result: T) => void): void => {
+    if (busy || disposed) return;
+    busy = true;
+    render();
+    void context.runLatest(operation, {
+      success(result) {
+        if (disposed) return;
+        busy = false;
+        success?.(result);
+        render();
+        void load();
+      },
+      failure() {
+        if (disposed) return;
+        busy = false;
+        showTransientStatus(messages.connectionCenter.failed);
+        render();
+      },
+    });
+  };
+
+  const appendConnection = (parent: HTMLElement, connection: ConnectionSnapshot): void => {
+    const row = document.createElement("article");
+    row.className = "settings-connection-card";
+    row.dataset.connectionId = connection.id;
+    const identity = document.createElement("div");
+    identity.className = "settings-connection-card__identity";
+    const name = document.createElement("strong");
+    name.textContent = connection.displayName;
+    const state = document.createElement("span");
+    state.className = "settings-status-badge";
+    state.dataset.connectionTone =
+      connection.state === "connected"
+        ? "ready"
+        : connection.state === "checking"
+          ? "checking"
+          : "failed";
+    state.textContent = statusLabel(connection, messages);
+    identity.append(name, state);
+    const metadata = document.createElement("div");
+    metadata.className = "settings-connection-card__metadata";
+    const consumers = connection.consumers.map((consumer) => CONSUMER_LABELS[consumer]).join(", ");
+    metadata.textContent = `${messages.connectionCenter.consumers}: ${consumers || "—"} · ${connection.modelCount} ${messages.connectionCenter.models}`;
+    if (connection.baseUrl) {
+      const baseUrl = document.createElement("code");
+      baseUrl.textContent = connection.baseUrl;
+      metadata.append(document.createElement("br"), baseUrl);
+    }
+    if (connection.detail) {
+      const detail = document.createElement("span");
+      detail.textContent = connection.detail;
+      metadata.append(document.createElement("br"), detail);
+    }
+    const actions = document.createElement("div");
+    actions.className = "settings-connection-card__actions";
+    if (connection.pending) {
+      const pending = document.createElement("span");
+      pending.className = "settings-status-badge";
+      pending.textContent = messages.connectionCenter.pending;
+      actions.append(pending);
+    }
+    if (connection.loginAvailable) {
+      const login = createActionButton(document, "login", messages.connectionCenter.login, true);
+      login.dataset.connectionId = connection.id;
+      login.disabled = busy;
+      login.addEventListener("click", () => {
+        const client = getClient();
+        if (!client) return;
+        runOperation(
+          () => client.startConnectionLogin({ id: connection.id }),
+          (operation) =>
+            showTransientStatus(
+              operation.message ?? `${messages.connectionCenter.operation}: ${operation.state}`,
+            ),
+        );
+      });
+      actions.append(login);
+    }
+    if (connection.removable) {
+      const remove = createActionButton(document, "remove", messages.connectionCenter.remove, true);
+      remove.dataset.connectionId = connection.id;
+      remove.disabled = busy;
+      remove.addEventListener("click", () => {
+        if (!document.defaultView?.confirm(messages.connectionCenter.confirmRemove)) return;
+        const client = getClient();
+        if (!client) return;
+        runOperation(() => client.removeConnection({ id: connection.id }));
+      });
+      actions.append(remove);
+    }
+    row.append(identity, metadata, actions);
+    parent.append(row);
+  };
+
+  const appendGroup = (scope: ConnectionScope, title: string): void => {
+    const section = document.createElement("section");
+    section.className = "settings-connection-group";
+    section.dataset.connectionScope = scope;
+    const heading = document.createElement("h3");
+    heading.textContent = title;
+    section.append(heading);
+    const connections =
+      snapshot?.connections.filter((connection) => connection.scope === scope) ?? [];
+    if (connections.length === 0) {
+      const empty = document.createElement("p");
+      empty.className = "settings-empty";
+      empty.textContent = messages.connectionCenter.noEntries;
+      section.append(empty);
+    } else {
+      for (const connection of connections) appendConnection(section, connection);
+    }
+    groups.append(section);
+  };
+
+  function render(): void {
+    groups.replaceChildren();
+    if (!snapshot) {
+      apply.disabled = true;
+      add.disabled = busy || !getClient();
+      status.textContent = getClient()
+        ? messages.connectionCenter.checking
+        : messages.connectionCenter.unavailable;
+      return;
+    }
+    add.disabled = busy;
+    const activeTurns = snapshot.activity.activeTurnCount;
+    const operationBusy =
+      snapshot.operation?.state === "running" || snapshot.operation?.state === "waiting-user";
+    apply.disabled = busy || operationBusy || !snapshot.applyRequired || activeTurns > 0;
+    const summaries = [
+      `${snapshot.pendingCount} ${messages.connectionCenter.pendingCount}`,
+      `${activeTurns} ${messages.connectionCenter.activeTurns}`,
+    ];
+    if (busy) summaries.unshift(messages.connectionCenter.busy);
+    if (transientStatus) summaries.unshift(transientStatus);
+    if (snapshot.operation) {
+      summaries.push(
+        snapshot.operation.message ??
+          `${messages.connectionCenter.operation}: ${snapshot.operation.state}`,
+      );
+    }
+    status.textContent = summaries.join(" · ");
+    appendGroup("shared-model-source", messages.connectionCenter.sharedSources);
+    appendGroup("harness-identity", messages.connectionCenter.harnessIdentities);
+  }
+
+  async function load(): Promise<void> {
+    const client = getClient();
+    if (!client || disposed) {
+      render();
+      return;
+    }
+    await context.runLatest(() => client.inspectConnections(), {
+      success(next) {
+        if (disposed) return;
+        transientStatus = null;
+        snapshot = next;
+        render();
+      },
+      failure() {
+        if (disposed) return;
+        showTransientStatus(messages.connectionCenter.failed);
+      },
+    });
+  }
+
+  const closeForm = (): void => {
+    if (mountedApiKey) mountedApiKey.value = "";
+    mountedApiKey = null;
+    formOpen = false;
+    formSlot.replaceChildren();
+    add.focus();
+  };
+
+  const showForm = (): void => {
+    if (busy || formOpen) return;
+    formOpen = true;
+    const form = document.createElement("form");
+    form.className = "settings-connection-form";
+    form.setAttribute("autocomplete", "off");
+    const heading = document.createElement("h3");
+    heading.textContent = messages.connectionCenter.formTitle;
+    const displayName = document.createElement("input");
+    displayName.type = "text";
+    displayName.required = true;
+    displayName.autocomplete = "off";
+    displayName.dataset.connectionField = "display-name";
+    const baseUrl = document.createElement("input");
+    baseUrl.type = "url";
+    baseUrl.required = true;
+    baseUrl.autocomplete = "off";
+    baseUrl.dataset.connectionField = "base-url";
+    const protocol = document.createElement("select");
+    protocol.required = true;
+    protocol.dataset.connectionField = "protocol";
+    for (const value of PROTOCOLS) {
+      const option = document.createElement("option");
+      option.value = value;
+      option.textContent = protocolLabel(value, messages);
+      protocol.append(option);
+    }
+    protocol.value = "openai-responses";
+    const modelIds = document.createElement("textarea");
+    modelIds.required = true;
+    modelIds.placeholder = messages.connectionCenter.modelIdsHint;
+    modelIds.autocomplete = "off";
+    modelIds.dataset.connectionField = "model-ids";
+    const keyless = document.createElement("input");
+    keyless.type = "checkbox";
+    keyless.dataset.connectionField = "keyless";
+    const keylessCopy = document.createElement("span");
+    keylessCopy.textContent = `${messages.connectionCenter.keyless} — ${messages.connectionCenter.keylessHint}`;
+    const keylessLabel = document.createElement("label");
+    keylessLabel.className = "settings-connection-form__check";
+    keylessLabel.append(keyless, keylessCopy);
+    const advanced = document.createElement("input");
+    advanced.type = "checkbox";
+    advanced.dataset.connectionField = "advanced-key";
+    const advancedCopy = document.createElement("span");
+    advancedCopy.textContent = messages.connectionCenter.advancedKey;
+    const advancedLabel = document.createElement("label");
+    advancedLabel.className = "settings-connection-form__check";
+    advancedLabel.append(advanced, advancedCopy);
+    const keyWrapper = document.createElement("div");
+    keyWrapper.className = "settings-connection-form__key";
+    keyWrapper.hidden = true;
+    const maskedKeyInput = document.createElement("input");
+    maskedKeyInput.type = "password";
+    maskedKeyInput.autocomplete = "off";
+    maskedKeyInput.dataset.connectionField = "api-key";
+    mountedApiKey = maskedKeyInput;
+    keyWrapper.append(fieldLabel(document, messages.connectionCenter.apiKey, maskedKeyInput));
+    const secureHint = document.createElement("p");
+    secureHint.className = "settings-connection-form__hint";
+    secureHint.textContent = messages.connectionCenter.securePromptHint;
+    const actions = document.createElement("div");
+    actions.className = "settings-connection-form__actions";
+    const cancel = createActionButton(
+      document,
+      "cancel-custom",
+      messages.connectionCenter.cancel,
+      true,
+    );
+    const save = createActionButton(document, "save-custom", messages.connectionCenter.save);
+    save.type = "submit";
+    actions.append(cancel, save);
+    form.append(
+      heading,
+      fieldLabel(document, messages.connectionCenter.displayName, displayName),
+      fieldLabel(document, messages.connectionCenter.baseUrl, baseUrl),
+      fieldLabel(document, messages.connectionCenter.protocol, protocol),
+      fieldLabel(document, messages.connectionCenter.modelIds, modelIds),
+      keylessLabel,
+      advancedLabel,
+      secureHint,
+      keyWrapper,
+      actions,
+    );
+    formSlot.replaceChildren(form);
+    displayName.focus();
+    cancel.addEventListener("click", closeForm);
+    keyless.addEventListener("change", () => {
+      advanced.disabled = keyless.checked;
+      if (!keyless.checked) return;
+      advanced.checked = false;
+      maskedKeyInput.value = "";
+      keyWrapper.hidden = true;
+    });
+    advanced.addEventListener("change", () => {
+      keyWrapper.hidden = !advanced.checked;
+      maskedKeyInput.required = advanced.checked;
+      if (advanced.checked) maskedKeyInput.focus();
+      else maskedKeyInput.value = "";
+    });
+    form.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const client = getClient();
+      if (!client || busy) return;
+      const draft: CustomConnectionDraft = {
+        displayName: displayName.value,
+        baseUrl: baseUrl.value,
+        protocol: protocol.value as ConnectionProtocol,
+        modelIds: [
+          ...new Set(
+            modelIds.value
+              .split(/[\n,]+/u)
+              .map((value) => value.trim())
+              .filter(Boolean),
+          ),
+        ],
+        keyless: keyless.checked,
+      };
+      if (advanced.checked) {
+        const secret = maskedKeyInput.value;
+        maskedKeyInput.value = "";
+        runOperation(() => client.createCustomConnectionWithMaskedApiKey(draft, secret), closeForm);
+        return;
+      }
+      runOperation(
+        () =>
+          client.createCustomConnection({
+            draft,
+            secret: { mode: keyless.checked ? "keyless" : "secure-prompt" },
+          }),
+        closeForm,
+      );
+    });
+  };
+
+  add.addEventListener("click", showForm);
+  apply.addEventListener("click", () => {
+    if (apply.disabled) return;
+    if (!document.defaultView?.confirm(messages.connectionCenter.confirmApply)) return;
+    const client = getClient();
+    if (!client) return;
+    runOperation(() => client.applyConnections());
+  });
+
+  render();
+  void load();
+  return () => {
+    disposed = true;
+    if (mountedApiKey) mountedApiKey.value = "";
+    mountedApiKey = null;
