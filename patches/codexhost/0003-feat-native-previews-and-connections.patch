+describe("Renderer Connection request client", () => {
+  it("validates management requests and encrypts an advanced masked API Key before JSON-RPC", async () => {
+    const keyPair = await crypto.subtle.generateKey(
+      {
+        name: "RSA-OAEP",
+        modulusLength: 2048,
+        publicExponent: new Uint8Array([1, 0, 1]),
+        hash: "SHA-256",
+      },
+      true,
+      ["encrypt", "decrypt"],
+    );
+    const publicKeySpkiBase64 = Buffer.from(
+      await crypto.subtle.exportKey("spki", keyPair.publicKey),
+    ).toString("base64");
+    const connection = {
+      id: "custom.private",
+      displayName: "Private API",
+      scope: "shared-model-source",
+      owner: "router",
+      kind: "custom-api",
+      state: "connected",
+      detail: "2 models",
+      consumers: ["codex", "pi"],
+      modelCount: 2,
+      pending: true,
+      loginAvailable: false,
+      removable: true,
+      protocol: "openai-responses",
+      baseUrl: "https://api.example.com/v1",
+    } as const;
+    const inspection = {
+      connections: [connection],
+      pendingCount: 1,
+      applyRequired: true,
+      activity: { activeTurnCount: 0 },
+      operation: null,
+    } as const;
+    const sendRequest = vi.fn(async (method: string, params: unknown) => {
+      if (method === CONNECTIONS_INSPECT_METHOD) return inspection;
+      if (method === CONNECTIONS_KEY_SESSION_METHOD) {
+        return { id: "key-session", publicKeySpkiBase64, expiresAtMs: Date.now() + 120_000 };
+      }
+      if (method === CONNECTIONS_CREATE_METHOD) {
+        return { connection, applyRequired: true };
+      }
+      if (method === CONNECTIONS_LOGIN_METHOD) {
+        return { id: "login-op", kind: "login", state: "waiting-user", message: "Open browser" };
+      }
+      if (method === CONNECTIONS_REMOVE_METHOD) return { id: "custom.private", pending: true };
+      if (method === CONNECTIONS_APPLY_METHOD) {
+        return {
+          operation: { id: "apply-op", kind: "apply", state: "succeeded", message: null },
+          applyRequired: false,
+          publishedModelCount: 24,
+        };
+      }
+      throw new Error(`Unexpected method: ${method} (${JSON.stringify(params)})`);
+    });
+    const client = createRendererModelClient([{ sendRequest }]);
+    if (!client) throw new Error("Synthetic Connection client was not created");
+
+    await expect(client.inspectConnections()).resolves.toEqual(inspection);
+    const draft = {
+      displayName: "Private API",
+      baseUrl: "https://api.example.com/v1",
+      protocol: "openai-responses" as const,
+      modelIds: ["model-a", "model-b"],
+      keyless: false,
+    };
+    await expect(
+      client.createCustomConnection({ draft, secret: { mode: "secure-prompt" } }),
+    ).resolves.toMatchObject({ connection: { id: "custom.private" } });
+    const createWithMaskedKey = client.createCustomConnectionWithMaskedApiKey;
+    await expect(createWithMaskedKey(draft, "x".repeat(191))).rejects.toThrow("190 UTF-8 bytes");
+    await expect(createWithMaskedKey(draft, "top-secret-key")).resolves.toMatchObject({
+      applyRequired: true,
+    });
+    await expect(
+      client.startConnectionLogin({ id: connectionIdSchema.parse("custom.private") }),
+    ).resolves.toMatchObject({ state: "waiting-user" });
+    await expect(
+      client.removeConnection({ id: connectionIdSchema.parse("custom.private") }),
+    ).resolves.toEqual({ id: "custom.private", pending: true });
+    await expect(client.applyConnections()).resolves.toMatchObject({ publishedModelCount: 24 });
+
+    const encryptedCall = sendRequest.mock.calls.find(
+      ([method, params]) =>
+        method === CONNECTIONS_CREATE_METHOD &&
+        (params as { secret?: { mode?: string } }).secret?.mode === "encrypted",
+    );
+    expect(encryptedCall).toBeDefined();
+    expect(JSON.stringify(sendRequest.mock.calls)).not.toContain("top-secret-key");
+    const encrypted = (
+      encryptedCall?.[1] as {
+        secret: { ciphertextBase64: string; keySessionId: string; algorithm: string };
+      }
+    ).secret;
+    expect(encrypted).toMatchObject({ keySessionId: "key-session", algorithm: "RSA-OAEP-256" });
+    const clear = await crypto.subtle.decrypt(
+      { name: "RSA-OAEP" },
+      keyPair.privateKey,
+      Buffer.from(encrypted.ciphertextBase64, "base64"),
+    );
+    expect(new TextDecoder().decode(clear)).toBe("top-secret-key");
+  });
+});
